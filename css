/* =========================================================
   BRANDSPIRE MEDIA
   CLEAN MASTER STYLESHEET
   ========================================================= */

:root {
  --black: #080808;
  --black-2: #0d0d0d;
  --black-3: #131313;
  --white: #f7f6f2;
  --muted: #a4a29d;
  --line: rgba(255,255,255,0.10);
  --gold: #c9a45c;
  --gold-light: #e1c17a;

  --container: 1180px;
  --radius: 18px;
  --transition: 0.35s ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--black);
}

body {
  background: var(--black);
  color: var(--white);
  font-family: "DM Sans", sans-serif;
  overflow-x: hidden;
  line-height: 1.6;
}

img {
  display: block;
  width: 100%;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

.section {
  position: relative;
  padding: 110px 0;
  overflow: hidden;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--gold-light);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2.2px;
}

.eyebrow span {
  width: 26px;
  height: 1px;
  background: var(--gold);
}

h1,
h2,
h3,
h4 {
  font-family: "Manrope", sans-serif;
  line-height: 1.05;
}

h1 em,
h2 em {
  display: block;
  color: var(--gold-light);
  font-style: normal;
}

p {
  color: var(--muted);
}


/* =========================================================
   HEADER
   ========================================================= */

.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(8,8,8,0.88);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.nav-wrap {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand img {
  width: 145px;
  max-height: 48px;
  object-fit: contain;
  object-position: left center;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 30px;
}

.desktop-nav a {
  color: #c7c5c0;
  font-size: 13px;
  transition: var(--transition);
}

.desktop-nav a:hover {
  color: var(--white);
}

.desktop-nav .nav-contact {
  padding: 11px 18px;
  border: 1px solid rgba(201,164,92,0.65);
  color: var(--gold-light);
}

.desktop-nav .nav-contact:hover {
  background: var(--gold);
  color: #090909;
}

.menu-btn {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  background: transparent;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6px;
}

.menu-btn span {
  display: block;
  width: 20px;
  height: 1px;
  background: var(--white);
}

.mobile-nav {
  display: none;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
  min-height: 760px;
  display: flex;
  align-items: center;
  padding-top: 150px;
  padding-bottom: 90px;
  background:
    radial-gradient(circle at 75% 35%, rgba(201,164,92,0.10), transparent 28%),
    var(--black);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.03fr 0.97fr;
  align-items: center;
  gap: 65px;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero h1 {
  margin-top: 25px;
  max-width: 650px;
  font-size: clamp(48px, 6vw, 76px);
  letter-spacing: -3.5px;
}

.hero-content > p {
  max-width: 570px;
  margin-top: 28px;
  font-size: 17px;
  line-height: 1.8;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

.btn {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0 22px;
  border: 1px solid transparent;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .3px;
  transition: var(--transition);
}

.btn span {
  font-size: 16px;
}

.btn-gold {
  background: var(--gold);
  color: #0a0a0a;
}

.btn-gold:hover {
  background: var(--gold-light);
  transform: translateY(-2px);
}

.btn-outline {
  border-color: var(--line);
  color: var(--white);
}

.btn-outline:hover {
  border-color: var(--gold);
  color: var(--gold-light);
}

.hero-mini {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 48px;
}

.mini-avatars {
  display: flex;
}

.mini-avatars span {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--black-3);
  border: 1px solid var(--line);
  color: var(--gold-light);
  font-size: 10px;
  font-weight: 700;
}

.mini-avatars span + span {
  margin-left: -7px;
  background: var(--gold);
  color: #080808;
}

.hero-mini strong,
.hero-mini small {
  display: block;
}

.hero-mini strong {
  font-size: 12px;
}

.hero-mini small {
  margin-top: 2px;
  color: #777;
  font-size: 11px;
}

.hero-visual {
  position: relative;
  max-width: 520px;
  justify-self: end;
}

.hero-image-card {
  position: relative;
  width: 100%;
  height: 470px;
  overflow: hidden;
  border-radius: 4px;
  border: 1px solid var(--line);
}

.hero-image-card img {
  height: 100%;
  object-fit: cover;
}

.image-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 35%, rgba(0,0,0,.55)),
    linear-gradient(90deg, rgba(0,0,0,.18), transparent);
}

.floating-card {
  position: absolute;
  left: 22px;
  bottom: 22px;
  max-width: 260px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 16px;
  background: rgba(10,10,10,.82);
  border: 1px solid rgba(255,255,255,.12);
  backdrop-filter: blur(12px);
}

.floating-icon {
  color: var(--gold-light);
  font-size: 20px;
}

.floating-card strong,
.floating-card small {
  display: block;
}

.floating-card strong {
  font-size: 12px;
}

.floating-card small {
  margin-top: 3px;
  color: #888;
  font-size: 10px;
}

.hero-number {
  position: absolute;
  right: -22px;
  top: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  writing-mode: vertical-rl;
  color: #777;
}

.hero-number strong {
  color: var(--gold);
  font-size: 13px;
}

.hero-number span {
  font-size: 8px;
  letter-spacing: 2px;
}

.hero-glow {
  position: absolute;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: .12;
  pointer-events: none;
}

.glow-one {
  background: var(--gold);
  right: 5%;
  top: 15%;
}

.glow-two {
  background: #ffffff;
  left: -10%;
  bottom: 5%;
}


/* =========================================================
   SECTION HEADINGS
   ========================================================= */

.section-heading {
  display: grid;
  grid-template-columns: 1fr 390px;
  gap: 70px;
  align-items: end;
  margin-bottom: 55px;
}

.section-heading h2 {
  margin-top: 18px;
  font-size: clamp(38px, 5vw, 58px);
  letter-spacing: -2.5px;
}

.section-heading > p {
  max-width: 390px;
  font-size: 14px;
  line-height: 1.8;
}

.section-heading.center {
  display: block;
  text-align: center;
}

.section-heading.center .eyebrow {
  justify-content: center;
}

.section-heading.center > p {
  margin: 22px auto 0;
}


/* =========================================================
   SERVICES
   ========================================================= */

.services {
  background: var(--black-2);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.service-card {
  min-height: 290px;
  padding: 28px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: rgba(255,255,255,.012);
  transition: var(--transition);
}

.service-card:hover {
  background: rgba(201,164,92,.06);
  transform: translateY(-4px);
}

.service-card-gold {
  background: rgba(201,164,92,.045);
}

.service-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-number {
  color: #666;
  font-size: 11px;
  letter-spacing: 1px;
}

.service-arrow {
  color: #666;
  transition: var(--transition);
}

.service-card:hover .service-arrow {
  color: var(--gold-light);
  transform: translate(3px,-3px);
}

.service-icon {
  margin-top: 36px;
  color: var(--gold);
  font-size: 28px;
}

.service-card h3 {
  margin-top: 18px;
  font-size: 22px;
}

.service-card p {
  margin-top: 12px;
  max-width: 300px;
  font-size: 12px;
  line-height: 1.7;
}


/* =========================================================
   ABOUT
   ========================================================= */

.about {
  background: var(--black);
}

.about-grid {
  display: grid;
  grid-template-columns: .88fr 1.12fr;
  align-items: center;
  gap: 90px;
}

.about-visual {
  position: relative;
  max-width: 440px;
}

.about-image {
  width: 100%;
  height: 355px;
  overflow: hidden;
  border: 1px solid var(--line);
}

.about-image img {
  height: 100%;
  object-fit: cover;
}

.about-badge {
  position: absolute;
  right: -35px;
  bottom: -25px;
  width: 115px;
  height: 115px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--gold);
  color: #090909;
  transform: rotate(5deg);
}

.about-badge strong {
  font-size: 15px;
  letter-spacing: 2px;
}

.about-badge span {
  font-size: 19px;
  font-weight: 800;
}

.about-badge small {
  font-size: 7px;
  letter-spacing: 2px;
}

.about-content h2 {
  margin-top: 20px;
  font-size: clamp(40px, 5vw, 60px);
  letter-spacing: -2.5px;
}

.about-content > p {
  max-width: 620px;
  margin-top: 23px;
  font-size: 14px;
  line-height: 1.9;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  max-width: 600px;
  margin-top: 40px;
  border-top: 1px solid var(--line);
  padding-top: 24px;
}

.stat strong {
  display: block;
  color: var(--gold-light);
  font-family: "Manrope", sans-serif;
  font-size: 27px;
}

.stat span {
  display: block;
  margin-top: 3px;
  color: #777;
  font-size: 10px;
}


/* =========================================================
   WHY
   ========================================================= */

.why {
  background: var(--black-2);
}

.why-grid {
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 80px;
  align-items: center;
}

.why-image {
  height: 365px;
  overflow: hidden;
  border: 1px solid var(--line);
}

.why-image img {
  height: 100%;
  object-fit: cover;
}

.why-list {
  border-top: 1px solid var(--line);
}

.why-item {
  display: grid;
  grid-template-columns: 55px 1fr;
  gap: 20px;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}

.why-item > span {
  color: var(--gold);
  font-size: 11px;
}

.why-item h3 {
  font-size: 19px;
}

.why-item p {
  margin-top: 7px;
  font-size: 12px;
}


/* =========================================================
   WORK
   ========================================================= */

.work {
  background: var(--black);
}

.work-placeholder {
  position: relative;
  height: 320px;
  overflow: hidden;
  border: 1px solid var(--line);
}

.work-placeholder-bg,
.work-placeholder-bg img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.work-placeholder-bg img {
  object-fit: cover;
  filter: grayscale(100%);
  opacity: .34;
  transition: transform .7s ease;
}

.work-placeholder:hover img {
  transform: scale(1.04);
}

.work-placeholder-content {
  position: absolute;
  left: 45px;
  bottom: 40px;
  z-index: 2;
}

.work-placeholder-content span {
  color: var(--gold-light);
  font-size: 10px;
  letter-spacing: 2px;
}

.work-placeholder-content h3 {
  margin-top: 10px;
  font-size: clamp(32px, 5vw, 52px);
}

.work-placeholder-content p {
  margin-top: 9px;
  font-size: 13px;
}

.work-tag {
  position: absolute;
  top: 24px;
  right: 24px;
  z-index: 2;
  padding: 9px 13px;
  border: 1px solid rgba(201,164,92,.6);
  color: var(--gold-light);
  font-size: 9px;
  letter-spacing: 1.5px;
}


/* =========================================================
   REVIEWS
   ========================================================= */

.reviews {
  background: var(--black-2);
}

.review-area {
  max-width: 900px;
  margin: auto;
}

.reviews-list {
  min-height: 190px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.empty-reviews {
  grid-column: 1 / -1;
  padding: 50px 25px;
  text-align: center;
  border: 1px solid var(--line);
}

.empty-reviews span {
  color: var(--gold);
  font-size: 25px;
}

.empty-reviews h3 {
  margin-top: 10px;
  font-size: 21px;
}

.empty-reviews p {
  margin-top: 6px;
  font-size: 12px;
}

.review-card {
  padding: 25px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,.015);
}

.review-card .review-stars {
  color: var(--gold);
  letter-spacing: 3px;
}

.review-card h4 {
  margin-top: 15px;
  font-size: 15px;
}

.review-card p {
  margin-top: 9px;
  font-size: 12px;
}

.review-open {
  display: flex;
  margin: 25px auto 0;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0,0,0,.78);
  backdrop-filter: blur(10px);
}

.modal.active {
  display: flex;
}

.modal-box {
  position: relative;
  width: min(520px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  padding: 38px;
  background: #111;
  border: 1px solid var(--line);
}

.modal-box h2 {
  margin-top: 17px;
  font-size: 38px;
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 17px;
  border: 0;
  background: transparent;
  color: #aaa;
  font-size: 27px;
}

#reviewForm {
  display: grid;
  gap: 18px;
  margin-top: 28px;
}

#reviewForm label {
  display: grid;
  gap: 7px;
  color: #bbb;
  font-size: 11px;
}

#reviewForm input,
#reviewForm textarea {
  width: 100%;
  border: 1px solid var(--line);
  outline: none;
  background: #0a0a0a;
  color: var(--white);
  padding: 13px;
}

#reviewForm textarea {
  min-height: 110px;
  resize: vertical;
}

.stars {
  display: flex;
  gap: 5px;
}

.stars button {
  border: 0;
  background: transparent;
  color: #555;
  font-size: 24px;
  padding: 0;
}

.stars button.active {
  color: var(--gold);
}


/* =========================================================
   CONTACT
   ========================================================= */

.contact {
  background: var(--black);
}

.contact-box {
  display: grid;
  grid-template-columns: 1.4fr .6fr;
  gap: 70px;
  padding: 70px;
  background:
    radial-gradient(circle at 70% 30%, rgba(201,164,92,.12), transparent 30%),
    #111;
  border: 1px solid var(--line);
}

.contact-content h2 {
  max-width: 700px;
  margin-top: 20px;
  font-size: clamp(40px, 5vw, 61px);
  letter-spacing: -2.5px;
}

.contact-content p {
  max-width: 620px;
  margin: 22px 0 30px;
  font-size: 14px;
  line-height: 1.8;
}

.contact-side {
  align-self: end;
}

.contact-line {
  width: 45px;
  height: 1px;
  background: var(--gold);
  margin-bottom: 20px;
}

.contact-side p {
  font-size: 12px;
}

.whatsapp-link {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
  color: var(--gold-light);
  font-size: 14px;
}

.whatsapp-link > span:last-child {
  margin-left: auto;
}

.whatsapp-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--gold);
  border-radius: 50%;
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
  background: #050505;
  border-top: 1px solid var(--line);
  padding: 65px 0 25px;
}

.footer-main {
  display: grid;
  grid-template-columns: 1.6fr repeat(3, 1fr);
  gap: 50px;
}

.footer-brand img {
  width: 145px;
  max-height: 48px;
  object-fit: contain;
  object-position: left center;
}

.footer-brand p {
  max-width: 230px;
  margin-top: 18px;
  font-size: 12px;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.footer-column h4 {
  margin-bottom: 9px;
  color: var(--white);
  font-size: 12px;
}

.footer-column a {
  color: #777;
  font-size: 11px;
  transition: var(--transition);
}

.footer-column a:hover {
  color: var(--gold-light);
}

.footer-bottom {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 55px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
}

.footer-bottom p {
  font-size: 9px;
}

.footer-bottom strong {
  color: #aaa;
}

.back-top {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  color: var(--gold);
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition:
    opacity .7s ease,
    transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .desktop-nav {
    display: none;
  }

  .menu-btn {
    display: flex;
  }

  .mobile-nav {
    display: none;
    padding: 12px 24px 24px;
    background: rgba(8,8,8,.98);
    border-top: 1px solid var(--line);
  }

  .mobile-nav.active {
    display: grid;
  }

  .mobile-nav a {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: #ccc;
    font-size: 14px;
  }

  .hero-grid,
  .about-grid,
  .why-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding-top: 130px;
  }

  .hero-visual {
    justify-self: start;
    width: min(100%, 560px);
  }

  .section-heading {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-visual {
    margin: auto;
  }

  .why-image {
    max-width: 560px;
  }

  .contact-box {
    grid-template-columns: 1fr;
    padding: 50px;
  }

  .footer-main {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-brand {
    grid-column: 1 / -1;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .container {
    width: min(100% - 30px, 1180px);
  }

  .section {
    padding: 75px 0;
  }

  .nav-wrap {
    min-height: 68px;
  }

  .brand img {
    width: 125px;
    max-height: 42px;
  }

  .hero {
    min-height: auto;
    padding-top: 120px;
    padding-bottom: 65px;
  }

  .hero-grid {
    gap: 45px;
  }

  .hero h1 {
    font-size: clamp(43px, 13vw, 58px);
    letter-spacing: -2.5px;
  }

  .hero-content > p {
    font-size: 14px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: stretch;
  }

  .btn {
    width: 100%;
  }

  .hero-mini {
    margin-top: 32px;
  }

  .hero-image-card {
    height: 340px;
  }

  .hero-number {
    display: none;
  }

  .floating-card {
    left: 12px;
    right: 12px;
    bottom: 12px;
    max-width: none;
  }

  .section-heading {
    margin-bottom: 35px;
  }

  .section-heading h2 {
    font-size: 39px;
    letter-spacing: -1.8px;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: 245px;
  }

  .about-grid,
  .why-grid {
    gap: 55px;
  }

  .about-image {
    height: 280px;
  }

  .about-badge {
    right: 8px;
    bottom: -25px;
  }

  .about-content h2 {
    font-size: 40px;
  }

  .stats {
    gap: 15px;
  }

  .stat strong {
    font-size: 22px;
  }

  .why-image {
    height: 280px;
  }

  .why-item {
    grid-template-columns: 35px 1fr;
    gap: 10px;
  }

  .work-placeholder {
    height: 280px;
  }

  .work-placeholder-content {
    left: 22px;
    bottom: 25px;
  }

  .work-tag {
    top: 15px;
    right: 15px;
  }

  .reviews-list {
    grid-template-columns: 1fr;
  }

  .contact-box {
    padding: 32px 24px;
    gap: 45px;
  }

  .contact-content h2 {
    font-size: 40px;
  }

  .footer {
    padding-top: 50px;
  }

  .footer-main {
    grid-template-columns: 1fr 1fr;
    gap: 35px 20px;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  .footer-bottom {
    flex-direction: column;
    padding-bottom: 50px;
  }

  .back-top {
    bottom: 0;
  }

  .modal-box {
    padding: 28px 20px;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
