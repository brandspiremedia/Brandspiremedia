/* =========================================================
   BRANDSPiRE MEDIA — FINAL CSS
   Premium Black + Gold + White
   Fully Responsive / No Horizontal Scroll
   ========================================================= */

:root {
  --bg: #070707;
  --bg-soft: #0d0d0d;
  --card: #111111;
  --card-hover: #171717;

  --white: #f7f5ef;
  --text: #e8e5de;
  --muted: #aaa69d;

  --gold: #d9aa52;
  --gold-light: #eac273;
  --gold-dark: #b98532;

  --border: rgba(255, 255, 255, 0.12);

  --container: 1180px;
  --header-height: 78px;

  --radius: 12px;
  --transition: 0.3s ease;
}

/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
  overflow-x: hidden;
}

body {
  width: 100%;
  min-height: 100vh;
  background: var(--bg);
  color: var(--white);
  font-family: "DM Sans", Arial, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
}

body.modal-open {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

/* Prevent accidental horizontal overflow */
section,
header,
footer,
main,
div {
  max-width: 100%;
}

/* =========================================================
   CONTAINER
   ========================================================= */

.container {
  width: min(
    var(--container),
    calc(100% - 48px)
  );

  margin-left: auto;
  margin-right: auto;
}

/* =========================================================
   TYPOGRAPHY
   ========================================================= */

h1,
h2 {
  font-family: "Playfair Display", Georgia, serif;
  line-height: 1.05;
}

h1 {
  font-size: clamp(
    3rem,
    6vw,
    5.5rem
  );

  letter-spacing: -0.035em;
  margin-bottom: 24px;
}

h2 {
  font-size: clamp(
    2.2rem,
    4.5vw,
    3.8rem
  );

  margin-bottom: 18px;
}

h3 {
  line-height: 1.2;
}

em {
  color: var(--gold-light);
  font-style: italic;
}

.eyebrow {
  color: var(--gold-light);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  margin-bottom: 10px;
}

.muted {
  color: var(--muted);
}

/* =========================================================
   BUTTONS
   ========================================================= */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-height: 48px;

  padding: 12px 21px;

  border: 1px solid var(--gold);
  border-radius: 7px;

  font-size: 0.84rem;
  font-weight: 700;

  transition:
    transform var(--transition),
    background var(--transition),
    color var(--transition),
    box-shadow var(--transition);
}

.btn:hover {
  transform: translateY(-3px);
}

.gold {
  color: #111;
  background:
    linear-gradient(
      135deg,
      #edc878,
      #c99339
    );

  box-shadow:
    0 10px 30px rgba(217, 170, 82, 0.12);
}

.gold:hover {
  box-shadow:
    0 14px 40px rgba(217, 170, 82, 0.28);
}

.outline {
  color: var(--white);
  background: transparent;
}

.outline:hover {
  background: rgba(217, 170, 82, 0.08);
}

/* =========================================================
   HEADER
   ========================================================= */

.header {
  position: fixed;

  top: 0;
  left: 0;

  width: 100%;

  z-index: 100;

  background:
    rgba(7, 7, 7, 0.84);

  backdrop-filter: blur(14px);

  border-bottom:
    1px solid transparent;

  transition:
    background var(--transition),
    border-color var(--transition);
}

.header.scrolled {
  background:
    rgba(7, 7, 7, 0.95);

  border-color:
    var(--border);
}

.navwrap {
  min-height: var(--header-height);

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;
}

.brand {
  display: inline-flex;
  align-items: center;

  flex-shrink: 0;
}

.brand img {
  width: 190px;
  max-width: 100%;
  max-height: 55px;

  object-fit: contain;
}

.navwrap nav {
  display: flex;
  align-items: center;
  gap: 25px;
}

.navwrap nav > a {
  font-size: 0.84rem;
  color: #ddd;

  transition:
    color var(--transition);
}

.navwrap nav > a:hover {
  color: var(--gold-light);
}

.topconnect {
  margin-left: 5px;
}

/* =========================================================
   MOBILE MENU
   ========================================================= */

.menu {
  display: none;

  width: 44px;
  height: 44px;

  border: 1px solid #333;
  border-radius: 8px;

  background: #111;
  color: white;

  font-size: 20px;
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;

  min-height: 760px;

  padding-top: var(--header-height);

  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 75% 45%,
      rgba(217, 170, 82, 0.09),
      transparent 28%
    );
}

.hero-grid {
  position: relative;

  display: grid;

  grid-template-columns:
    minmax(0, 0.92fr)
    minmax(0, 1.08fr);

  min-height: 682px;
}

.hero-copy {
  min-width: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding-right: 45px;
}

.hero-copy > p:not(.eyebrow) {
  max-width: 560px;

  color: var(--muted);

  font-size: 1rem;
}

.actions {
  display: flex;
  flex-wrap: wrap;

  gap: 13px;

  margin:
    18px
    0
    35px;
}

.stats {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  max-width: 590px;

  padding-top: 20px;

  border-top:
    1px solid #292929;
}

.stats div {
  padding-right: 12px;

  border-right:
    1px solid #292929;
}

.stats div + div {
  padding-left: 12px;
}

.stats div:last-child {
  border-right: 0;
}

.stats b,
.stats small {
  display: block;
}

.stats b {
  font-size: 1rem;
}

.stats small {
  color: #999;
  font-size: 0.7rem;
}

/* Hero image */

.hero-photo {
  position: relative;

  min-width: 0;

  overflow: hidden;

  border-left:
    1px solid #222;
}

.hero-photo > img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.photo-shade {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      #070707 0%,
      rgba(7, 7, 7, 0.25) 35%,
      rgba(0, 0, 0, 0.25)
    ),
    linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.5),
      transparent
    );
}

/* Hero logo */

.hero-logo {
  position: absolute;

  top: 50%;
  right: 8%;

  transform:
    translateY(-50%);

  width: min(
    390px,
    70%
  );

  padding: 28px;

  background:
    rgba(5, 5, 5, 0.65);

  border:
    1px solid
    rgba(217, 170, 82, 0.55);

  text-align: center;

  backdrop-filter: blur(8px);

  box-shadow:
    0 25px 70px
    rgba(0, 0, 0, 0.45);
}

.hero-logo img {
  width: 220px;
  max-width: 100%;
  margin: auto;
}

.hero-logo span {
  display: block;

  margin-top: 10px;

  color: var(--gold-light);

  font-size: 0.65rem;

  letter-spacing: 0.18em;
}

/* =========================================================
   SECTIONS
   ========================================================= */

.section {
  position: relative;

  padding:
    100px
    0;

  overflow: hidden;
}

.section-head {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 32px;
}

.section-head > p {
  max-width: 540px;

  margin: 0;

  color: var(--muted);

  font-size: 0.9rem;
}

/* =========================================================
   SERVICES
   ========================================================= */

#services {
  background:
    linear-gradient(
      180deg,
      #080808,
      #0c0c0c
    );
}

.services {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}

.card {
  min-width: 0;

  overflow: hidden;

  border:
    1px solid #292929;

  border-radius: var(--radius);

  background: var(--card);

  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease;
}

.card:hover {
  transform: translateY(-6px);

  border-color:
    var(--gold);

  box-shadow:
    0 18px 45px
    rgba(0, 0, 0, 0.4);
}

.card > img {
  width: 100%;
  height: 205px;

  object-fit: cover;

  transition:
    transform 0.5s ease;
}

.card:hover > img {
  transform: scale(1.05);
}

.card > div {
  padding:
    17px
    19px
    20px;
}

.card i {
  font-style: normal;

  color: var(--gold-light);

  font-size: 0.7rem;
}

.card h3 {
  margin:
    9px
    0
    6px;

  font-size: 1rem;
}

.card p {
  margin:
    0
    0
    11px;

  color: var(--muted);

  font-size: 0.8rem;
}

.card a {
  color: var(--gold-light);

  font-size: 0.78rem;

  font-weight: 700;
}

/* =========================================================
   ABOUT / WHY CHOOSE US
   ========================================================= */

.about {
  background: #090909;

  border-top:
    1px solid #222;

  border-bottom:
    1px solid #222;
}

.about-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 65px;

  align-items: center;
}

.about-photo {
  min-width: 0;
  position: relative;
}

.about-photo img {
  width: 100%;
  height: 570px;

  object-fit: cover;

  border:
    1px solid #292929;

  border-radius: 15px;

  transition:
    transform 0.7s ease;
}

.about-photo:hover img {
  transform: scale(1.02);
}

.about-grid .muted {
  max-width: 580px;
}

/* Features */

.features {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 12px;

  margin-top: 25px;
}

.features > div {
  padding: 15px;

  border:
    1px solid #292929;

  border-radius: 10px;

  background: #0d0d0d;

  transition:
    transform var(--transition),
    border-color var(--transition);
}

.features > div:hover {
  transform: translateY(-3px);

  border-color:
    rgba(217, 170, 82, 0.6);
}

.features b {
  color: var(--gold-light);

  font-size: 0.72rem;
}

.features h3 {
  margin:
    6px
    0;

  font-size: 0.82rem;
}

.features p {
  color: #888;

  font-size: 0.7rem;
}

/* =========================================================
   OUR WORK
   ========================================================= */

#work {
  background:
    radial-gradient(
      circle at 80% 40%,
      rgba(217, 170, 82, 0.06),
      transparent 32%
    ),
    #080808;
}

.coming {
  display: flex;

  align-items: center;

  gap: 22px;

  padding: 32px;

  border:
    1px solid #292929;

  border-radius: 14px;

  background:
    linear-gradient(
      100deg,
      #111,
      #0b0b0b
    );
}

.coming > span {
  width: 56px;
  height: 56px;

  flex: 0 0 56px;

  display: grid;
  place-items: center;

  border:
    1px solid var(--gold);

  border-radius: 50%;

  color: var(--gold-light);

  font-size: 1.3rem;
}

.coming h3 {
  margin-bottom: 7px;
}

.coming p {
  margin: 0;

  color: #999;

  font-size: 0.85rem;
}

/* =========================================================
   REVIEWS
   ========================================================= */

#reviews {
  background: #0b0b0b;
}

.reviews {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}

.review {
  min-width: 0;

  padding: 25px;

  border:
    1px solid #292929;

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #141414,
      #0e0e0e
    );

  transition:
    transform var(--transition),
    border-color var(--transition);
}

.review:hover {
  transform: translateY(-4px);

  border-color:
    rgba(217, 170, 82, 0.5);
}

.stars {
  color: var(--gold-light);

  letter-spacing: 3px;

  margin-bottom: 14px;
}

.review p {
  color: #ccc;

  font-size: 0.84rem;

  min-height: 82px;
}

.review strong,
.review small {
  display: block;
}

.review strong {
  font-size: 0.78rem;
}

.review small {
  color: #888;

  font-size: 0.68rem;
}

/* =========================================================
   REVIEW MODAL
   ========================================================= */

.modal {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 300;

  align-items: center;
  justify-content: center;

  padding: 20px;
}

.modal.open {
  display: flex;
}

.backdrop {
  position: absolute;

  inset: 0;

  background:
    rgba(0, 0, 0, 0.8);

  backdrop-filter: blur(8px);
}

.modalbox {
  position: relative;

  z-index: 1;

  width:
    min(550px, 100%);

  max-height: 90vh;

  overflow-y: auto;

  padding: 30px;

  background: #111;

  border:
    1px solid
    rgba(217, 170, 82, 0.55);

  border-radius: 15px;

  box-shadow:
    0 25px 70px
    rgba(0, 0, 0, 0.6);
}

.modalbox h2 {
  font-size: 2.5rem;
}

.close {
  position: absolute;

  top: 8px;
  right: 13px;

  border: 0;

  background: transparent;

  color: white;

  font-size: 30px;
}

.modalbox label {
  display: block;

  margin:
    13px
    0
    6px;

  color: #ddd;

  font-size: 0.78rem;

  font-weight: 700;
}

.modalbox input,
.modalbox textarea {
  width: 100%;

  padding: 11px;

  border:
    1px solid #333;

  border-radius: 8px;

  outline: none;

  background: #080808;

  color: #fff;

  resize: vertical;
}

.modalbox input:focus,
.modalbox textarea:focus {
  border-color:
    var(--gold);
}

.modalbox fieldset {
  border: 0;

  padding: 0;

  margin: 0;
}

.modalbox legend {
  margin-bottom: 4px;

  font-size: 0.78rem;

  font-weight: 700;
}

/* Rating */

.rating {
  display: flex;

  flex-direction: row-reverse;

  justify-content: flex-end;
}

.rating input {
  position: absolute;

  opacity: 0;
}

.rating label {
  margin: 0 4px;

  color: #444;

  font-size: 2rem;

  cursor: pointer;

  transition:
    color 0.2s ease;
}

.rating label:hover,
.rating label:hover ~ label,
.rating input:checked ~ label {
  color: var(--gold-light);
}

.full {
  width: 100%;

  margin-top: 15px;
}

.note {
  display: block;

  margin-top: 8px;

  color: #777;

  text-align: center;

  font-size: 0.65rem;
}

/* =========================================================
   CONTACT
   ========================================================= */

.contact {
  padding:
    70px
    0;

  background:
    linear-gradient(
      100deg,
      #111,
      #090909
    );

  border-top:
    1px solid #222;

  border-bottom:
    1px solid #222;
}

.contact-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1.3fr);

  gap: 40px;

  align-items: center;
}

.contact h2 {
  font-size:
    clamp(
      2rem,
      3.5vw,
      3rem
    );

  margin-bottom: 8px;
}

.contact-links {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;
}

.contact-links > a:not(.btn) {
  min-height: 110px;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  border:
    1px solid #292929;

  border-radius: 10px;

  background: #0b0b0b;

  transition:
    transform var(--transition),
    border-color var(--transition);
}

.contact-links > a:not(.btn):hover {
  transform: translateY(-3px);

  border-color:
    var(--gold);
}

.contact-links span {
  color: var(--gold-light);

  font-size: 1.4rem;
}

.contact-links b {
  font-size: 0.75rem;
}

.contact-links small {
  color: #888;

  font-size: 0.63rem;
}

.formbtn {
  grid-column: 1 / -1;

  width: 100%;
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
  background: #050505;
}

.footergrid {
  display: grid;

  grid-template-columns:
    1.2fr
    1fr
    1.4fr
    1fr;

  gap: 30px;

  padding:
    50px
    0;
}

.footergrid h3 {
  margin-bottom: 12px;

  font-size: 0.8rem;
}

.footergrid p,
.footergrid a {
  color: #888;

  font-size: 0.72rem;
}

.footergrid a {
  display: block;

  margin: 6px 0;

  transition:
    color var(--transition);
}

.footergrid a:hover {
  color: var(--gold-light);
}

.footergrid .brand img {
  width: 180px;
}

.footerbottom {
  display: flex;

  justify-content: space-between;

  gap: 20px;

  padding:
    18px
    0;

  border-top:
    1px solid #222;

  color: #666;

  font-size: 0.65rem;
}

.footerbottom a {
  color: var(--gold-light);
}

/* =========================================================
   FLOATING WHATSAPP
   ========================================================= */

.floatwa {
  position: fixed;

  right: 20px;
  bottom: 20px;

  z-index: 120;

  width: 56px;
  height: 56px;

  display: grid;
  place-items: center;

  border:
    1px solid var(--gold);

  border-radius: 50%;

  background: #171717;

  color: #42d66b;

  font-size: 1.5rem;

  box-shadow:
    0 12px 35px
    rgba(0, 0, 0, 0.45);

  transition:
    transform var(--transition);
}

.floatwa:hover {
  transform: scale(1.08);
}

/* =========================================================
   BACK TO TOP
   ========================================================= */

.top {
  position: fixed;

  right: 24px;
  bottom: 90px;

  z-index: 120;

  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border:
    1px solid var(--gold);

  border-radius: 50%;

  background: #111;

  color: var(--gold-light);

  opacity: 0;

  pointer-events: none;

  transition:
    opacity var(--transition),
    transform var(--transition);
}

.top.show {
  opacity: 1;

  pointer-events: auto;
}

.top:hover {
  transform: translateY(-3px);
}

/* =========================================================
   SCROLL ANIMATIONS
   ========================================================= */

.reveal {
  opacity: 0;

  transform:
    translateY(22px);

  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.reveal.visible {
  opacity: 1;

  transform:
    translateY(0);
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  .container {
    width:
      min(
        var(--container),
        calc(100% - 32px)
      );
  }

  .navwrap nav {
    display: none;

    position: absolute;

    top: 70px;
    right: 16px;

    width:
      min(
        300px,
        calc(100vw - 32px)
      );

    padding: 10px;

    background: #0b0b0b;

    border:
      1px solid #292929;

    border-radius: 12px;

    flex-direction: column;

    align-items: stretch;

    box-shadow:
      0 20px 50px
      rgba(0, 0, 0, 0.5);
  }

  .navwrap nav.open {
    display: flex;
  }

  .navwrap nav > a {
    padding: 10px;
  }

  .menu {
    display: block;
  }

  .topconnect {
    display: none;
  }

  .hero {
    min-height: auto;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    padding:
      70px
      0
      35px;
  }

  .hero-photo {
    height: 500px;

    border-left: 0;

    border-top:
      1px solid #222;
  }

  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .services {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }

  .reviews {
    grid-template-columns: 1fr;
  }

  .contact-links {
    max-width: 700px;
  }

  .footergrid {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 560px) {

  .container {
    width:
      calc(100% - 30px);
  }

  .section {
    padding:
      70px
      0;
  }

  h1 {
    font-size:
      clamp(
        2.65rem,
        13vw,
        4rem
      );
  }

  h2 {
    font-size:
      clamp(
        2.2rem,
        11vw,
        3rem
      );
  }

  .brand img {
    width: 165px;
  }

  .hero {
    padding-top: 70px;
  }

  .hero-copy {
    padding-top: 35px;
  }

  .hero-copy > p:not(.eyebrow) {
    font-size: 0.9rem;
  }

  .actions {
    flex-direction: column;
  }

  .actions .btn {
    width: 100%;
  }

  .stats {
    grid-template-columns:
      1fr 1fr;
  }

  .stats div {
    padding:
      10px
      0;

    border-right: 0;

    border-bottom:
      1px solid #292929;
  }

  .stats div + div {
    padding-left: 10px;
  }

  .stats div:nth-child(odd) {
    border-right:
      1px solid #292929;
  }

  .hero-photo {
    height: 390px;
  }

  .hero-logo {
    width: 84%;

    right: 50%;

    transform:
      translate(
        50%,
        -50%
      );

    padding: 20px;
  }

  .hero-logo img {
    width: 180px;
  }

  .section-head {
    flex-direction: column;

    align-items: flex-start;
  }

  .services {
    grid-template-columns: 1fr;
  }

  .card > img {
    height: 210px;
  }

  .about-photo img {
    height: 360px;
  }

  .features {
    grid-template-columns: 1fr;
  }

  .coming {
    align-items: flex-start;

    flex-direction: column;

    padding: 24px;
  }

  .contact-links {
    grid-template-columns:
      1fr 1fr;
  }

  .formbtn {
    grid-column:
      1 / -1;
  }

  .footergrid {
    grid-template-columns: 1fr;
  }

  .footerbottom {
    flex-direction: column;
  }

  .floatwa {
    right: 15px;
    bottom: 15px;
  }

  .top {
    right: 18px;
    bottom: 82px;
  }

  .modal {
    padding: 15px;
  }

  .modalbox {
    padding: 25px 20px;
  }

  .modalbox h2 {
    font-size: 2.2rem;
  }
}

/* =========================================================
   REDUCE MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation: none !important;

    transition: none !important;
  }

  .reveal {
    opacity: 1;

    transform: none;
  }
}
