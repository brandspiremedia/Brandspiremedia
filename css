/* =========================================================
   BRANDSPIRE MEDIA
   PREMIUM BLACK / GOLD AGENCY WEBSITE
   RESPONSIVE — NO HORIZONTAL SCROLL
========================================================= */


/* =========================================================
   1. RESET
========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

body {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;

  background: #080808;
  color: #f5f5f5;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  line-height: 1.6;

  overflow-x: hidden;
}

img,
video,
iframe {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

::selection {
  background: #d8a928;
  color: #080808;
}


/* =========================================================
   2. VARIABLES
========================================================= */

:root {

  --black: #080808;
  --black-2: #0d0d0d;
  --black-3: #111111;

  --white: #f5f5f5;
  --white-soft: #cfcfcf;
  --muted: #969696;

  --gold: #d8a928;
  --gold-light: #f2c75c;
  --gold-dark: #9f7615;

  --border: rgba(255,255,255,.10);
  --gold-border: rgba(216,169,40,.45);

  --max: 1160px;

  --radius: 14px;
  --radius-small: 8px;

  --shadow:
    0 25px 70px rgba(0,0,0,.55);
}


/* =========================================================
   3. CONTAINER
========================================================= */

.container {
  width: min(var(--max), calc(100% - 40px));
  max-width: var(--max);

  margin-left: auto;
  margin-right: auto;
}


/* =========================================================
   4. HEADER
========================================================= */

.site-header {
  width: 100%;

  position: relative;
  z-index: 100;

  background:
    linear-gradient(
      180deg,
      rgba(8,8,8,.98),
      rgba(8,8,8,.90)
    );

  border-bottom: 1px solid rgba(255,255,255,.06);
}

.nav {
  min-height: 82px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}


/* Logo */

.brand {
  display: flex;
  align-items: center;

  min-width: 0;
  flex-shrink: 0;
}

.brand-logo {
  width: 190px;
  max-width: 190px;
  height: auto;
}


/* Navigation */

.nav-links {
  display: flex;
  align-items: center;

  gap: 30px;

  min-width: 0;
}

.nav-links a {
  position: relative;

  color: #eeeeee;

  font-size: 13px;
  font-weight: 600;

  letter-spacing: .02em;

  white-space: nowrap;

  transition:
    color .25s ease;
}

.nav-links a:hover {
  color: var(--gold-light);
}

.nav-links a:not(.nav-cta)::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -8px;

  width: 0;
  height: 2px;

  background: var(--gold);

  transition: width .25s ease;
}

.nav-links a:not(.nav-cta):hover::after {
  width: 100%;
}


/* Header CTA */

.nav-cta {
  padding: 11px 19px;

  border: 1px solid var(--gold);

  color: var(--gold) !important;

  border-radius: 5px;
}

.nav-cta:hover {
  background: var(--gold);
  color: #080808 !important;
}


/* Mobile menu */

.menu-toggle {
  display: none;

  width: 44px;
  height: 44px;

  border: 1px solid var(--gold-border);
  border-radius: 8px;

  background: transparent;
  color: var(--gold);

  font-size: 22px;
}


/* =========================================================
   5. HERO
========================================================= */

.hero {
  width: 100%;
  max-width: var(--max);

  min-height: 590px;

  margin-left: auto;
  margin-right: auto;

  padding-top: 75px;
  padding-bottom: 70px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(0, .95fr);

  align-items: center;

  gap: 55px;

  position: relative;
}


/* Golden glow */

.hero::before {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: 5%;
  top: 15%;

  background:
    radial-gradient(
      circle,
      rgba(216,169,40,.13),
      transparent 65%
    );

  pointer-events: none;

  filter: blur(15px);
}


/* Hero text */

.hero-copy {
  position: relative;
  z-index: 2;

  min-width: 0;
}

.eyebrow {
  margin: 0 0 18px;

  color: var(--gold);

  font-size: 14px;
  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.hero h1 {
  margin: 0;

  max-width: 650px;

  font-size: clamp(42px, 5vw, 70px);

  line-height: .98;

  letter-spacing: -.045em;

  font-weight: 800;

  text-transform: uppercase;
}

.hero h1 span {
  color: var(--gold);
}

.hero-text {
  max-width: 540px;

  margin: 28px 0 0;

  color: var(--white-soft);

  font-size: 16px;

  line-height: 1.75;
}


/* Hero buttons */

.hero-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 14px;

  margin-top: 32px;
}

.button {
  min-height: 48px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 0 24px;

  border-radius: 5px;

  font-size: 13px;
  font-weight: 700;

  letter-spacing: .03em;

  transition:
    transform .25s ease,
    background .25s ease,
    color .25s ease,
    border-color .25s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-gold {
  background: var(--gold);
  color: #080808;

  border: 1px solid var(--gold);
}

.button-gold:hover {
  background: var(--gold-light);
  border-color: var(--gold-light);
}

.button-outline {
  background: transparent;
  color: var(--gold);

  border: 1px solid var(--gold);
}

.button-outline:hover {
  background: var(--gold);
  color: #080808;
}

.handle {
  margin: 22px 0 0;

  color: #777;

  font-size: 12px;
  letter-spacing: .08em;
}


/* =========================================================
   6. HERO LOGO AREA
========================================================= */

.hero-art {
  width: 100%;
  min-width: 0;

  min-height: 420px;

  display: flex;

  align-items: center;
  justify-content: center;

  position: relative;

  z-index: 2;
}


/* Decorative glow */

.hero-art::before {
  content: "";

  position: absolute;

  width: 360px;
  height: 360px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(216,169,40,.15),
      transparent 68%
    );

  filter: blur(20px);

  pointer-events: none;
}


/* Logo card */

.hero-logo-card {
  width: 320px;
  max-width: 100%;

  height: 320px;

  display: flex;

  align-items: center;
  justify-content: center;

  position: relative;

  overflow: hidden;

  padding: 25px;

  border-radius: 18px;

  border: 1px solid rgba(216,169,40,.30);

  background:
    radial-gradient(
      circle at center,
      #15130e 0%,
      #0d0d0c 55%,
      #090909 100%
    );

  box-shadow:
    0 25px 70px rgba(0,0,0,.70),
    inset 0 0 40px rgba(216,169,40,.04);
}


/* Gold circle behind logo */

.hero-logo-card::before {
  content: "";

  position: absolute;

  width: 250px;
  height: 250px;

  border-radius: 50%;

  border: 1px solid rgba(216,169,40,.20);

  box-shadow:
    0 0 70px rgba(216,169,40,.10);

  pointer-events: none;
}


/* Actual logo */

.hero-logo {
  position: relative;
  z-index: 2;

  display: block !important;

  width: 220px !important;
  max-width: 220px !important;

  height: auto !important;

  max-height: 220px !important;

  object-fit: contain;

  margin: auto;
}


/* =========================================================
   7. SECTIONS
========================================================= */

.section {
  padding-top: 100px;
  padding-bottom: 100px;
}

.section-alt {
  width: 100%;
  max-width: none;

  background:
    linear-gradient(
      180deg,
      #0b0b0b,
      #0e0e0e
    );

  border-top: 1px solid rgba(255,255,255,.06);
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.section-alt > .container {
  width: min(var(--max), calc(100% - 40px));
}


/* =========================================================
   8. TWO COLUMN
========================================================= */

.two-col {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 80px;

  align-items: start;
}

.two-col > * {
  min-width: 0;
}


/* =========================================================
   9. HEADINGS
========================================================= */

h2 {
  margin: 0;

  font-size: clamp(32px, 4vw, 52px);

  line-height: 1.05;

  letter-spacing: -.035em;

  text-transform: uppercase;
}

h2 span {
  color: var(--gold);
}

.section-heading {
  max-width: 720px;

  margin-bottom: 50px;
}

.section-heading > p:last-child {
  max-width: 600px;

  margin-top: 18px;

  color: var(--muted);

  font-size: 15px;
}


/* =========================================================
   10. SERVICES
========================================================= */

.service-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}

.service-card {
  min-width: 0;

  padding: 30px 25px;

  min-height: 235px;

  border: 1px solid var(--border);

  border-radius: var(--radius);

  background:
    linear-gradient(
      145deg,
      #111111,
      #0b0b0b
    );

  transition:
    transform .3s ease,
    border-color .3s ease,
    background .3s ease;
}

.service-card:hover {
  transform: translateY(-5px);

  border-color: var(--gold-border);

  background:
    linear-gradient(
      145deg,
      #15130e,
      #0b0b0b
    );
}

.service-card > span {
  display: inline-block;

  margin-bottom: 25px;

  color: var(--gold);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: .08em;
}

.service-card h3 {
  margin: 0 0 13px;

  font-size: 19px;

  line-height: 1.2;

  text-transform: uppercase;
}

.service-card p {
  margin: 0;

  color: var(--muted);

  font-size: 14px;

  line-height: 1.7;
}


/* =========================================================
   11. WORK / PORTFOLIO
========================================================= */

.work-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.work-card {
  min-width: 0;
}

.work-placeholder {
  width: 100%;

  aspect-ratio: 16 / 10;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 1px solid rgba(216,169,40,.20);

  border-radius: 12px;

  background:
    radial-gradient(
      circle at center,
      #17130a,
      #0d0d0d 65%
    );

  color: var(--gold);

  font-size: 13px;
  font-weight: 700;

  letter-spacing: .10em;

  transition:
    transform .3s ease,
    border-color .3s ease;
}

.work-card:hover .work-placeholder {
  transform: translateY(-4px);

  border-color: var(--gold);
}

.work-card h3 {
  margin: 18px 0 5px;

  font-size: 17px;

  text-transform: uppercase;
}

.work-card p {
  margin: 0;

  color: var(--muted);

  font-size: 13px;
}


/* =========================================================
   12. CTA
========================================================= */

.cta-section {
  width: 100%;

  padding: 100px 0;

  border-top: 1px solid rgba(255,255,255,.06);

  background:
    radial-gradient(
      circle at center,
      rgba(216,169,40,.08),
      transparent 55%
    ),
    #090909;
}

.cta {
  text-align: center;
}

.cta h2 {
  max-width: 800px;

  margin: 0 auto 30px;
}


/* =========================================================
   13. CONTACT
========================================================= */

.contact {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 60px;

  align-items: center;
}

.contact-box {
  min-width: 0;

  padding: 30px;

  border: 1px solid var(--border);

  border-radius: var(--radius);

  background: #0d0d0d;
}

.contact-box a {
  display: block;

  margin: 10px 0;

  color: var(--gold);

  font-size: 16px;

  word-break: break-word;

  transition: color .25s ease;
}

.contact-box a:hover {
  color: var(--gold-light);
}


/* =========================================================
   14. FOOTER
========================================================= */

.footer {
  width: 100%;

  padding: 45px 0 25px;

  border-top: 1px solid rgba(255,255,255,.08);

  background: #070707;
}

.footer-inner {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 40px;
}

.footer strong {
  color: var(--gold);

  font-size: 15px;

  letter-spacing: .08em;
}

.footer p {
  margin: 8px 0 0;

  color: #777;

  font-size: 12px;
}


/* =========================================================
   15. REVEAL ANIMATION
========================================================= */

.reveal {
  opacity: 1;

  transform: translateY(0);
}


/* =========================================================
   16. TABLET
========================================================= */

@media (max-width: 1000px) {

  .nav-links {
    gap: 18px;
  }

  .nav-links a {
    font-size: 12px;
  }

  .hero {
    gap: 30px;
  }

  .hero h1 {
    font-size: clamp(40px, 6vw, 58px);
  }

  .hero-logo-card {
    width: 290px;
    height: 290px;
  }

  .hero-logo {
    width: 205px !important;
    max-width: 205px !important;
  }

  .service-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .work-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}


/* =========================================================
   17. MOBILE NAVIGATION
========================================================= */

@media (max-width: 800px) {

  .nav {
    min-height: 72px;
  }

  .brand-logo {
    width: 160px;
    max-width: 160px;
  }

  .menu-toggle {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .nav-links {
    display: none;

    position: absolute;

    left: 20px;
    right: 20px;
    top: 72px;

    padding: 20px;

    flex-direction: column;
    align-items: stretch;

    gap: 0;

    border: 1px solid var(--border);

    border-radius: 10px;

    background: #0b0b0b;

    box-shadow: var(--shadow);
  }

  .nav-links.active {
    display: flex;
  }

  .nav-links a {
    padding: 13px 8px;

    border-bottom: 1px solid rgba(255,255,255,.06);
  }

  .nav-links a:last-child {
    border-bottom: none;
  }

  .nav-cta {
    margin-top: 10px;

    text-align: center;
  }
}


/* =========================================================
   18. MOBILE HERO
========================================================= */

@media (max-width: 768px) {

  .container {
    width: min(100% - 30px, 600px);
  }

  .section {
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .section-alt > .container {
    width: min(100% - 30px, 600px);
  }

  .hero {
    width: min(100% - 30px, 600px);

    min-height: auto;

    padding-top: 60px;
    padding-bottom: 60px;

    grid-template-columns: 1fr;

    gap: 50px;

    text-align: center;
  }

  .hero-copy {
    width: 100%;
  }

  .hero h1 {
    font-size: clamp(40px, 11vw, 58px);

    line-height: 1;
  }

  .hero-text {
    margin-left: auto;
    margin-right: auto;

    font-size: 14px;
  }

  .hero-actions {
    justify-content: center;
  }

  .handle {
    text-align: center;
  }


  .hero-art {
    width: 100%;

    min-height: 300px;
  }

  .hero-logo-card {
    width: 260px !important;
    max-width: 260px !important;

    height: 260px !important;

    padding: 20px;
  }

  .hero-logo-card::before {
    width: 205px;
    height: 205px;
  }

  .hero-logo {
    width: 190px !important;
    max-width: 190px !important;

    max-height: 190px !important;
  }


  .two-col {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  .contact {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  .footer-inner {
    flex-direction: column;

    align-items: flex-start;

    gap: 25px;
  }
}


/* =========================================================
   19. SMALL MOBILE
========================================================= */

@media (max-width: 520px) {

  .container {
    width: calc(100% - 28px);
  }

  .section-alt > .container {
    width: calc(100% - 28px);
  }

  .nav {
    min-height: 68px;
  }

  .brand-logo {
    width: 145px;
    max-width: 145px;
  }

  .nav-links {
    top: 68px;

    left: 14px;
    right: 14px;
  }


  .hero {
    width: calc(100% - 28px);

    padding-top: 50px;
    padding-bottom: 55px;

    gap: 40px;
  }

  .eyebrow {
    font-size: 11px;
  }

  .hero h1 {
    font-size: 38px;
  }

  .hero-text {
    font-size: 13px;

    line-height: 1.65;
  }


  .hero-actions {
    width: 100%;

    flex-direction: column;

    align-items: stretch;
  }

  .button {
    width: 100%;
  }


  .hero-logo-card {
    width: 230px !important;
    max-width: 230px !important;

    height: 230px !important;
  }

  .hero-logo {
    width: 165px !important;
    max-width: 165px !important;

    max-height: 165px !important;
  }

  .hero-logo-card::before {
    width: 180px;
    height: 180px;
  }


  .service-grid,
  .work-grid {
    grid-template-columns: 1fr;
  }


  .service-card {
    min-height: auto;

    padding: 25px 20px;
  }


  .section-heading {
    margin-bottom: 35px;
  }

  h2 {
    font-size: 34px;
  }


  .cta-section {
    padding: 75px 0;
  }


  .contact-box {
    padding: 22px;
  }

}


/* =========================================================
   20. VERY SMALL DEVICES
========================================================= */

@media (max-width: 360px) {

  .container {
    width: calc(100% - 22px);
  }

  .hero {
    width: calc(100% - 22px);
  }

  .hero h1 {
    font-size: 34px;
  }

  .hero-logo-card {
    width: 210px !important;
    max-width: 210px !important;

    height: 210px !important;
  }

  .hero-logo {
    width: 145px !important;
    max-width: 145px !important;
  }

}
