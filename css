@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

:root{
  --bg:#080808;
  --panel:#11110f;
  --text:#f7f4ec;
  --muted:#aaa79f;
  --gold:#d7ad57;
  --line:#292720;
  --max:1160px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
  width:100%;
  max-width:100%;
  overflow-x:hidden;
}

body{
  width:100%;
  max-width:100%;
  overflow-x:hidden;
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:"DM Sans",Arial,sans-serif;
  line-height:1.6;
}

img{
  display:block;
  max-width:100%;
  height:auto;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(var(--max),calc(100% - 80px));
  max-width:var(--max);
  margin-left:auto;
  margin-right:auto;
}


/* =========================
   HEADER
========================= */

.site-header{
  position:static !important;
  width:100%;
  max-width:100%;
  height:76px;
  background:#080808;
  border-bottom:1px solid var(--line);
  box-shadow:none !important;
}

.nav{
  position:static !important;
  width:min(var(--max),calc(100% - 80px));
  max-width:var(--max);
  height:76px;
  min-height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  display:flex;
  align-items:center;
  width:auto;
  height:60px;
  flex-shrink:0;
}

.brand-logo{
  display:block !important;
  width:155px !important;
  max-width:155px !important;
  height:auto !important;
  max-height:58px !important;
  object-fit:contain;
}

.nav-links{
  display:flex;
  gap:30px;
  align-items:center;
  font-size:14px;
}

.nav-links a{
  color:#ddd;
  transition:.25s;
}

.nav-links a:hover{
  color:var(--gold);
}

.nav-cta{
  border:1px solid var(--gold);
  padding:9px 16px;
  border-radius:4px;
}

.menu-toggle{
  display:none;
  background:none;
  border:0;
  color:var(--text);
  font-size:25px;
  cursor:pointer;
}


/* =========================
   HERO
========================= */

.hero{
  width:min(var(--max),calc(100% - 80px));
  max-width:var(--max);
  min-height:calc(100vh - 76px);
  display:grid;
  grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);
  align-items:center;
  gap:40px;
  padding-top:50px;
  padding-bottom:80px;
}

.hero-copy{
  min-width:0;
}

.eyebrow{
  font-size:12px;
  letter-spacing:3px;
  color:var(--gold);
  font-weight:700;
}

.hero h1,
h2{
  font-family:"Playfair Display",Georgia,serif;
  line-height:1.05;
  margin:18px 0;
}

.hero h1{
  font-size:clamp(48px,7vw,82px);
}

h2{
  font-size:clamp(38px,5vw,62px);
}

h1 span,
h2 span{
  color:var(--gold);
}

.hero-text{
  max-width:600px;
  color:var(--muted);
  font-size:17px;
}

.hero-actions{
  display:flex;
  gap:13px;
  margin:30px 0;
  flex-wrap:wrap;
}

.button{
  display:inline-block;
  padding:13px 20px;
  border-radius:4px;
  font-weight:700;
  font-size:14px;
  transition:.25s;
}

.button-gold{
  background:var(--gold);
  color:#111;
}

.button-gold:hover{
  transform:translateY(-2px);
  filter:brightness(1.08);
}

.button-outline{
  border:1px solid #555;
  color:#eee;
}

.button-outline:hover{
  border-color:var(--gold);
  color:var(--gold);
}

.handle{
  color:#777;
  font-size:13px;
}


/* =========================
   HERO LOGO
========================= */

.hero-art{
  min-height:500px;
  min-width:0;
  display:grid;
  place-items:center;
  position:relative;
}

.hero-logo-card{
  width:360px;
  max-width:100%;
  aspect-ratio:1/1;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#0d0d0c;
  border:1px solid #3d3526;
  border-radius:24px;
  padding:30px;
  box-shadow:0 35px 90px rgba(0,0,0,.65);
  position:relative;
  overflow:hidden;
}

.hero-logo-card::before{
  content:"";
  position:absolute;
  width:300px;
  height:300px;
  max-width:100%;
  border-radius:50%;
  background:radial-gradient(
    circle,
    rgba(215,173,87,.14),
    transparent 70%
  );
  pointer-events:none;
}

.hero-logo{
  display:block;
  position:relative;
  z-index:1;
  width:80%;
  max-width:300px;
  height:auto;
  object-fit:contain;
}


/* =========================
   SECTIONS
========================= */

.section{
  width:100%;
  max-width:100%;
  padding:110px 0;
}

.section-alt{
  background:var(--panel);
}

.two-col{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:90px;
}

.two-col > *{
  min-width:0;
}

.two-col p{
  color:var(--muted);
  font-size:17px;
}

.section-heading{
  max-width:750px;
  margin-bottom:50px;
}

.section-heading > p:last-child{
  color:var(--muted);
}


/* =========================
   SERVICES
========================= */

.service-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;
}

.service-card{
  min-width:0;
  padding:30px;
  border:1px solid var(--line);
  background:#0d0d0c;
  min-height:245px;
  transition:.3s;
}

.service-card:hover{
  border-color:#5d4c2e;
  transform:translateY(-5px);
}

.service-card span{
  color:var(--gold);
  font-size:12px;
}

.service-card h3{
  font-size:21px;
  margin:35px 0 12px;
}

.service-card p,
.work-card p{
  color:var(--muted);
  margin:0;
}


/* =========================
   WORK
========================= */

.work-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.work-card{
  min-width:0;
  background:#0b0b0a;
  border:1px solid var(--line);
  padding:15px;
}

.work-placeholder{
  width:100%;
  aspect-ratio:4/3;
  display:grid;
  place-items:center;
  background:linear-gradient(
    135deg,
    #211d15,
    #0e0e0d
  );
  color:#8c7546;
  letter-spacing:3px;
  font-size:12px;
}

.work-card h3{
  margin:18px 5px 2px;
}

.work-card p{
  margin:0 5px 10px;
  font-size:14px;
}


/* =========================
   REVIEWS
========================= */

#reviews{
  background:#080808;
}


/* =========================
   CTA
========================= */

.cta-section{
  width:100%;
  max-width:100%;
  padding:120px 0;
  text-align:center;
  background:
    radial-gradient(
      circle at center,
      #211b10 0,
      #080808 55%
    );
}

.cta h2{
  margin-bottom:35px;
}


/* =========================
   CONTACT
========================= */

.contact{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:80px;
}

.contact > *{
  min-width:0;
}

.contact-box{
  min-width:0;
  border-left:1px solid var(--gold);
  padding:20px 30px;
  display:flex;
  flex-direction:column;
  gap:22px;
  justify-content:center;
}

.contact-box a{
  font-size:18px;
  overflow-wrap:anywhere;
  word-break:break-word;
}

.contact-box a:hover{
  color:var(--gold);
}


/* =========================
   FOOTER
========================= */

.footer{
  width:100%;
  max-width:100%;
  border-top:1px solid var(--line);
  padding:35px 0;
  color:#888;
  font-size:13px;
}

.footer-inner{
  display:flex;
  justify-content:space-between;
  gap:30px;
}

.footer strong{
  color:#ddd;
  letter-spacing:2px;
}

.footer p{
  margin:6px 0;
}


/* =========================
   ANIMATION
========================= */

.reveal{
  opacity:0;
  transform:translateY(18px);
  transition:
    opacity .7s ease,
    transform .7s ease;
}

.reveal.visible{
  opacity:1;
  transform:none;
}


/* =========================
   MOBILE
========================= */

@media(max-width:800px){

  .container,
  .nav,
  .hero{
    width:calc(100% - 40px);
    max-width:none;
  }

  .site-header{
    position:static !important;
    height:76px;
  }

  .nav{
    position:static !important;
    height:76px;
    min-height:76px;
  }

  .brand-logo{
    width:135px !important;
    max-width:135px !important;
    max-height:52px !important;
  }

  .menu-toggle{
    display:block;
  }

  .nav-links{
    display:none;
    position:absolute;
    top:76px;
    left:0;
    right:0;
    width:100%;
    background:#0b0b0a;
    border-bottom:1px solid var(--line);
    padding:20px;
    flex-direction:column;
    align-items:stretch;
  }

  .nav-links.open{
    display:flex;
  }

  .nav-cta{
    text-align:center;
  }

  .hero{
    grid-template-columns:1fr;
    padding-top:65px;
    padding-bottom:60px;
  }

  .hero-art{
    min-height:350px;
    order:-1;
  }

  .hero-logo-card{
    width:290px;
    max-width:90%;
    padding:25px;
    border-radius:20px;
  }

  .hero-logo{
    width:82%;
    max-width:240px;
  }

  .two-col,
  .contact{
    grid-template-columns:1fr;
    gap:35px;
  }

  .service-grid,
  .work-grid{
    grid-template-columns:1fr;
  }

  .section{
    padding:80px 0;
  }

  .footer-inner{
    flex-direction:column;
  }

  .hero h1{
    font-size:52px;
  }
}
