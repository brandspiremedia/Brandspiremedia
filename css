/* =========================================================
   BRANDSPIRE MEDIA
   PREMIUM BLACK + GOLD
   RESPONSIVE
   NO HORIZONTAL SCROLL
========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #080808;
  color: #f5f5f5;
  font-family: "DM Sans", Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

:root {
  --black: #080808;
  --black-2: #0d0d0d;
  --black-3: #121212;

  --white: #f5f5f5;
  --muted: #999;

  --gold: #d8a928;
  --gold-light: #f3c95b;

  --border: rgba(255,255,255,.10);
  --gold-border: rgba(216,169,40,.50);

  --max: 1160px;
}


/* =========================================================
   CONTAINER
========================================================= */

.container {
  width: min(var(--max), calc(100% - 40px));
  max-width: var(--max);
  margin-left: auto;
  margin-right: auto;
}


/* =========================================================
   HEADER
========================================================= */

.site-header {
  width: 100%;
  position: relative;
  z-index: 1000;

  background: #080808;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.nav {
  min-height: 82px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}

.brand {
  flex-shrink: 0;
}

.brand-logo {
  width: 185px;
  max-width: 185px;
  height: auto;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-links a {
  position: relative;

  color: #eee;

  font-size: 13px;
  font-weight: 600;

  text-transform: uppercase;
  white-space: nowrap;

  transition: .25s ease;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-links a:not(.nav-cta)::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -7px;

  width: 0;
  height: 2px;

  background: var(--gold);

  transition: width .25s ease;
}

.nav-links a:not(.nav-cta):hover::after {
  width: 100%;
}

.nav-cta {
  padding: 11px 18px;

  border: 1px solid var(--gold);
  border-radius: 5px;

  color: var(--gold) !important;
}

.nav-cta:hover {
  background: var(--gold);
  color: #080808 !important;
}

.menu-toggle {
  display: none;

  width: 44px;
  height: 44px;

  border: 1px solid var(--gold);
  border-radius: 7px;

  background: transparent;
  color: var(--gold);

  font-size: 22px;
}


/* =========================================================
   HERO
========================================================= */

.hero {
  position: relative;

  min-height: 590px;

  padding-top: 70px;
  padding-bottom: 70px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  align-items: center;

  gap: 50px;

  overflow: hidden;
}

.hero::before {
  content: "";

  position: absolute;

  width: 500px;
  height: 500px;

  right: 0;
  top: 50%;

  transform: translateY(-50%);

  background:
    radial-gradient(
      circle,
      rgba(216,169,40,.13),
      transparent 68%
    );

  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 2;

  min-width: 0;
}

.eyebrow {
  margin: 0 0 16px;

  color: var(--gold);

  font-size: 14px;
  font-weight: 700;

  letter-spacing: .08em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 0;

  max-width: 650px;

  color: #f5f5f5;

  font-size: clamp(44px, 5.5vw, 70px);

  line-height: .98;

  letter-spacing: -.045em;

  font-weight: 800;

  text-transform: uppercase;
}

.hero h1 span {
  color: var(--gold);
}

.hero-text {
  max-width: 540px;

  margin: 28px 0 0;

  color: #cfcfcf;

  font-size: 16px;

  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 14px;

  margin-top: 32px;
}

.button {
  min-height: 48px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 0 24px;

  border-radius: 5px;

  font-size: 13px;
  font-weight: 700;

  text-transform: uppercase;

  transition: .25s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-gold {
  background: var(--gold);
  color: #080808;

  border: 1px solid var(--gold);
}

.button-gold:hover {
  background: var(--gold-light);
}

.button-outline {
  background: transparent;
  color: var(--gold);

  border: 1px solid var(--gold);
}

.button-outline:hover {
  background: var(--gold);
  color: #080808;
}

.handle {
  margin: 20px 0 0;

  color: #777;

  font-size: 12px;
  letter-spacing: .08em;
}


/* =========================================================
   HERO LOGO
========================================================= */

.hero-art {
  width: 100%;
  min-width: 0;
  min-height: 420px;

  position: relative;

  display: flex;

  align-items: center;
  justify-content: center;
}

.hero-art::before {
  content: "";

  position: absolute;

  width: 380px;
  height: 380px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(216,169,40,.14),
      transparent 68%
    );

  filter: blur(20px);
}

.hero-logo-card {
  width: 320px;
  max-width: 100%;

  height: 320px;

  padding: 25px;

  position: relative;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;

  border: 1px solid rgba(216,169,40,.35);
  border-radius: 18px;

  background:
    radial-gradient(
      circle,
      #17140d,
      #0b0b0b 70%
    );

  box-shadow:
    0 25px 70px rgba(0,0,0,.7);
}

.hero-logo-card::before {
  content: "";

  position: absolute;

  width: 250px;
  height: 250px;

  border-radius: 50%;

  border: 1px solid rgba(216,169,40,.18);
}

.hero-logo {
  position: relative;
  z-index: 2;

  width: 220px !important;
  max-width: 220px !important;

  height: auto !important;
  max-height: 220px !important;

  object-fit: contain;
}


/* =========================================================
   SECTIONS
========================================================= */

.section {
  width: 100%;

  padding-top: 100px;
  padding-bottom: 100px;
}

.section-alt {
  width: 100%;
  max-width: none;

  background:
    linear-gradient(
      180deg,
      #0b0b0b,
      #0e0e0e
    );

  border-top: 1px solid rgba(255,255,255,.06);
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.section-alt > .container {
  width: min(var(--max), calc(100% - 40px));
}


/* =========================================================
   HEADINGS
========================================================= */

h2 {
  margin: 0;

  font-size: clamp(34px, 4vw, 52px);

  line-height: 1.05;

  letter-spacing: -.035em;

  text-transform: uppercase;
}

h2 span {
  color: var(--gold);
}

.section-heading {
  max-width: 750px;

  margin-bottom: 50px;
}

.section-heading > p:last-child {
  max-width: 620px;

  margin-top: 18px;

  color: var(--muted);

  font-size: 15px;
}


/* =========================================================
   TWO COLUMN
========================================================= */

.two-col {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 80px;
}

.two-col > * {
  min-width: 0;
}


/* =========================================================
   SERVICES
========================================================= */

.service-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}

.service-card {
  min-width: 0;

  min-height: 225px;

  padding: 28px 24px;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #111,
      #0b0b0b
    );

  transition: .3s ease;
}

.service-card:hover {
  transform: translateY(-5px);

  border-color: var(--gold-border);

  background:
    linear-gradient(
      145deg,
      #15130d,
      #0b0b0b
    );
}

.service-card > span {
  display: inline-block;

  margin-bottom: 22px;

  color: var(--gold);

  font-size: 13px;
  font-weight: 700;

  letter-spacing: .08em;
}

.service-card h3 {
  margin: 0 0 12px;

  font-size: 18px;

  line-height: 1.25;

  text-transform: uppercase;
}

.service-card p {
  margin: 0;

  color: var(--muted);

  font-size: 14px;

  line-height: 1.7;
}


/* =========================================================
   PORTFOLIO
========================================================= */

.work-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px 18px;
}

.work-card {
  min-width: 0;
}

.work-placeholder {
  width: 100%;

  aspect-ratio: 16 / 10;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 1px solid rgba(216,169,40,.22);
  border-radius: 12px;

  background:
    radial-gradient(
      circle,
      #17130a,
      #0d0d0d 70%
    );

  color: var(--gold);

  font-size: 13px;
  font-weight: 700;

  letter-spacing: .1em;
}

.work-card h3 {
  margin: 17px 0 5px;

  font-size: 17px;

  text-transform: uppercase;
}

.work-card p {
  margin: 0;

  color: var(--muted);

  font-size: 13px;
}


/* =========================================================
   CTA
========================================================= */

.cta-section {
  width: 100%;

  padding: 100px 0;

  text-align: center;

  background:
    radial-gradient(
      circle,
      rgba(216,169,40,.08),
      transparent 58%
    ),
    #090909;

  border-top: 1px solid rgba(255,255,255,.06);
}

.cta h2 {
  margin-bottom: 30px;
}

.cta .button {
  margin: 5px;
}


/* =========================================================
   CONTACT
========================================================= */

.contact {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 60px;

  align-items: center;
}

.contact-box {
  min-width: 0;

  padding: 30px;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: #0d0d0d;
}

.contact-box a {
  display: block;

  margin: 15px 0;

  color: var(--gold);

  font-size: 15px;

  word-break: break-word;

  transition: .25s ease;
}

.contact-box a:hover {
  color: var(--gold-light);
}


/* =========================================================
   FOOTER
========================================================= */

.footer {
  width: 100%;

  padding: 45px 0 25px;

  background: #070707;

  border-top: 1px solid rgba(255,255,255,.08);
}

.footer-inner {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 40px;
}

.footer strong {
  color: var(--gold);

  font-size: 15px;

  letter-spacing: .08em;
}

.footer p {
  margin: 8px 0 0;

  color: #777;

  font-size: 12px;
}


/* =========================================================
   VERY IMPORTANT
   DISABLE OLD REVEAL HIDING
========================================================= */

.reveal {
  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {

  .nav-links {
    gap: 17px;
  }

  .nav-links a {
    font-size: 11px;
  }

  .hero {
    gap: 30px;
  }

  .hero-logo-card {
    width: 290px;
    height: 290px;
  }

  .hero-logo {
    width: 200px !important;
    max-width: 200px !important;
  }

  .service-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .work-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}


/* =========================================================
   MOBILE NAVIGATION
========================================================= */

@media (max-width: 800px) {

  .nav {
    min-height: 72px;
  }

  .brand-logo {
    width: 155px;
    max-width: 155px;
  }

  .menu-toggle {
    display: flex;

    align-items: center;
    justify-content: center;
  }

  .nav-links {
    display: none;

    position: absolute;

    left: 15px;
    right: 15px;
    top: 72px;

    padding: 18px;

    flex-direction: column;
    align-items: stretch;

    gap: 0;

    border: 1px solid var(--border);
    border-radius: 10px;

    background: #0b0b0b;

    box-shadow: 0 25px 70px rgba(0,0,0,.7);
  }

  .nav-links.active {
    display: flex;
  }

  .nav-links a {
    padding: 13px 8px;

    border-bottom: 1px solid rgba(255,255,255,.06);

    font-size: 13px;
  }

  .nav-links a:not(.nav-cta)::after {
    display: none;
  }

  .nav-cta {
    margin-top: 10px;
    text-align: center;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .container {
    width: calc(100% - 30px);
  }

  .section {
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .section-alt > .container {
    width: calc(100% - 30px);
  }


  .hero {
    width: calc(100% - 30px);

    min-height: auto;

    padding-top: 55px;
    padding-bottom: 60px;

    grid-template-columns: 1fr;

    gap: 45px;

    text-align: center;
  }

  .hero h1 {
    font-size: clamp(38px, 10vw, 58px);
  }

  .hero-text {
    margin-left: auto;
    margin-right: auto;

    font-size: 14px;
  }

  .hero-actions {
    justify-content: center;
  }

  .handle {
    text-align: center;
  }


  .hero-art {
    min-height: 290px;
  }

  .hero-logo-card {
    width: 260px !important;
    max-width: 260px !important;

    height: 260px !important;
  }

  .hero-logo {
    width: 185px !important;
    max-width: 185px !important;

    max-height: 185px !important;
  }


  .two-col {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  .contact {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  .footer-inner {
    flex-direction: column;

    align-items: flex-start;

    gap: 25px;
  }

}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 520px) {

  .container,
  .section-alt > .container {
    width: calc(100% - 28px);
  }

  .brand-logo {
    width: 140px;
    max-width: 140px;
  }

  .hero {
    width: calc(100% - 28px);

    padding-top: 45px;
    padding-bottom: 55px;
  }

  .hero h1 {
    font-size: 37px;
  }

  .hero-text {
    font-size: 13px;
  }

  .hero-actions {
    width: 100%;

    flex-direction: column;
  }

  .hero-actions .button {
    width: 100%;
  }

  .hero-logo-card {
    width: 230px !important;
    max-width: 230px !important;

    height: 230px !important;
  }

  .hero-logo {
    width: 165px !important;
    max-width: 165px !important;
  }

  .service-grid,
  .work-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: auto;
  }

  h2 {
    font-size: 34px;
  }

  .cta-section {
    padding: 75px 0;
  }

  .cta .button {
    width: calc(100% - 20px);
  }

}


/* =========================================================
   EXTRA SMALL
========================================================= */

@media (max-width: 360px) {

  .hero h1 {
    font-size: 33px;
  }

  .hero-logo-card {
    width: 210px !important;
    max-width: 210px !important;

    height: 210px !important;
  }

  .hero-logo {
    width: 145px !important;
    max-width: 145px !important;
  }

}
