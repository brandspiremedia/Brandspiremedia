:root {
  --black: #08080d;
  --dark: #0d0d15;
  --card: #12121e;

  --white: #f7f5f8;
  --text: #aeb0c7;
  --muted: #707287;

  --purple: #7938ff;
  --violet: #9d48ff;
  --pink: #f23d78;
  --blue: #376dff;
  --cyan: #00b8ed;
  --green: #12a987;
  --orange: #ff8a00;

  --border: rgba(130, 111, 255, .28);

  --container: 1240px;
  --radius: 22px;

  --heading: "Anton", sans-serif;
  --body: "DM Sans", sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--black);
}

body {
  background: var(--black);
  color: var(--white);
  font-family: var(--body);
  overflow-x: hidden;
}

body.modal-open {
  overflow: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(var(--container), calc(100% - 70px));
  margin: auto;
}

.section {
  padding: 120px 0;
}

.eyebrow {
  color: var(--pink);
  font-weight: 800;
  font-size: 14px;
  letter-spacing: .12em;
}

.section-heading {
  max-width: 900px;
  margin: 0 auto 65px;
}

.section-heading.center {
  text-align: center;
}

.section-heading h2,
.contact-heading h2 {
  margin-top: 18px;

  font-family: var(--heading);
  font-size: clamp(52px, 6vw, 82px);
  line-height: .98;

  letter-spacing: -.025em;
}

.section-heading h2 span,
.contact-heading h2 span {
  background: linear-gradient(
    90deg,
    #d8c7ff,
    #813cff,
    #ef3e80
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.section-heading p {
  max-width: 800px;
  margin: 28px auto 0;

  color: var(--text);

  font-size: 19px;
  line-height: 1.7;
}


/* ================= HEADER ================= */

.header {
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;

  z-index: 1000;

  background: rgba(8, 8, 13, .76);
  backdrop-filter: blur(18px);

  border-bottom: 1px solid rgba(130,111,255,.12);
}

.nav {
  min-height: 76px;

  display: flex;
  align-items: center;
  gap: 35px;
}

.brand {
  width: 180px;
  flex-shrink: 0;
}

.brand img {
  width: 100%;
  height: auto;
  object-fit: contain;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 27px;

  margin-left: auto;
}

.desktop-nav a {
  color: #aaaac0;
  font-size: 13px;
  font-weight: 600;

  transition: color .25s ease;
}

.desktop-nav a:hover {
  color: white;
}

.nav-button {
  padding: 12px 20px;

  border-radius: 999px;

  background: linear-gradient(
    90deg,
    var(--purple),
    var(--pink)
  );

  font-weight: 700;
  font-size: 13px;
}

.menu-button {
  display: none;

  width: 44px;
  height: 44px;

  margin-left: auto;

  border: 1px solid var(--border);
  border-radius: 10px;

  background: transparent;
}

.menu-button span {
  display: block;

  width: 20px;
  height: 2px;

  margin: 4px auto;

  background: white;
}

.mobile-nav {
  display: none;
}


/* ================= HERO ================= */

.hero {
  min-height: 100vh;

  position: relative;

  display: flex;
  align-items: center;

  overflow: hidden;

  padding-top: 100px;

  background:
    radial-gradient(
      circle at 80% 25%,
      rgba(242,61,120,.18),
      transparent 34%
    ),
    radial-gradient(
      circle at 25% 40%,
      rgba(121,56,255,.16),
      transparent 38%
    ),
    linear-gradient(
      110deg,
      #07070c 10%,
      #130b1d 50%,
      #29101d 100%
    );
}

.hero-content {
  position: relative;
  z-index: 3;
}

.hero-label {
  display: inline-block;

  margin-bottom: 25px;

  padding: 9px 17px;

  border: 1px solid rgba(155,70,255,.4);
  border-radius: 999px;

  color: #bdb1d5;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: .16em;
}

.hero h1 {
  max-width: 1100px;

  font-family: var(--heading);

  font-size: clamp(64px, 9vw, 132px);
  line-height: .9;

  letter-spacing: -.02em;
}

.hero h1 span {
  display: block;

  background: linear-gradient(
    90deg,
    #7d3cff,
    #e83d83
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-content > p {
  max-width: 850px;

  margin-top: 42px;

  color: #aeb1c9;

  font-size: clamp(17px, 2vw, 23px);
  line-height: 1.65;
}

.hero-buttons {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;

  margin-top: 42px;
}

.gradient-button,
.outline-button {
  min-height: 58px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;

  padding: 0 30px;

  border-radius: 999px;

  font-size: 15px;
  font-weight: 800;

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.gradient-button {
  background: linear-gradient(
    90deg,
    #8538ff,
    #f43d79
  );
}

.gradient-button:hover {
  transform: translateY(-4px);

  box-shadow:
    0 15px 45px rgba(173,55,255,.25);
}

.outline-button {
  border: 1px solid rgba(129,65,255,.45);
  background: rgba(10,10,15,.25);
}

.outline-button:hover {
  border-color: var(--pink);
  transform: translateY(-4px);
}

.hero-glow {
  position: absolute;

  border-radius: 50%;

  filter: blur(20px);
}

.glow-one {
  width: 420px;
  height: 420px;

  right: -120px;
  top: 80px;

  background: rgba(240,50,120,.11);
}

.glow-two {
  width: 320px;
  height: 320px;

  left: 30%;
  bottom: -160px;

  background: rgba(120,50,255,.13);
}

.hero-shape {
  position: absolute;

  border: 1px solid rgba(140,65,255,.18);
  border-radius: 50%;
}

.shape-one {
  width: 250px;
  height: 250px;

  right: 9%;
  top: 5%;
}

.shape-two {
  width: 110px;
  height: 110px;

  right: 28%;
  bottom: 18%;
}


/* ================= MARQUEE ================= */

.marquee {
  overflow: hidden;

  border-top: 1px solid rgba(130,111,255,.14);
  border-bottom: 1px solid rgba(130,111,255,.14);

  background: #0b0b11;
}

.marquee-track {
  width: max-content;

  display: flex;
  align-items: center;
  gap: 30px;

  padding: 19px 0;

  animation: ticker 28s linear infinite;
}

.marquee-track span {
  color: #696a80;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: .18em;
}

.marquee-track i {
  color: var(--pink);
}

@keyframes ticker {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}


/* ================= SERVICES ================= */

.services {
  background:
    radial-gradient(
      circle at 50% 0,
      rgba(120,50,255,.07),
      transparent 35%
    ),
    var(--black);
}

.services-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 24px;
}

.service-card {
  min-height: 390px;

  position: relative;

  padding: 38px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: var(--radius);

  background: #11111b;

  transition:
    transform .4s ease,
    border-color .4s ease,
    box-shadow .4s ease;
}

.service-card::after {
  content: "";

  position: absolute;

  width: 200px;
  height: 200px;

  right: -80px;
  bottom: -100px;

  border-radius: 50%;

  background: var(--card-glow);

  filter: blur(40px);

  opacity: .35;
}

.service-card:hover {
  transform: translateY(-8px);

  border-color: rgba(255,255,255,.25);

  box-shadow:
    0 25px 70px rgba(0,0,0,.3);
}

.service-card.purple {
  --card-glow: #9c39ff;
}

.service-card.pink {
  --card-glow: #f03b79;
}

.service-card.blue {
  --card-glow: #523bff;
}

.service-card.cyan {
  --card-glow: #009eea;
}

.service-card.green {
  --card-glow: #00ae8a;
}

.service-card.violet {
  --card-glow: #803cff;
}

.service-number {
  color: #a8a8bf;

  font-weight: 800;
  font-size: 14px;
}

.service-icon {
  width: 70px;
  height: 70px;

  display: grid;
  place-items: center;

  margin-top: 28px;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      rgba(133,55,255,.95),
      rgba(239,61,124,.9)
    );

  font-size: 29px;

  position: relative;
  z-index: 2;
}

.service-card.cyan .service-icon {
  background: linear-gradient(135deg,#04b8e5,#285cf0);
}

.service-card.green .service-icon {
  background: linear-gradient(135deg,#11b98e,#087dba);
}

.service-card.blue .service-icon {
  background: linear-gradient(135deg,#753cff,#2930a8);
}

.service-card.violet .service-icon {
  background: linear-gradient(135deg,#814cff,#4331d4);
}

.service-kicker {
  margin-top: 25px;

  color: #9da0b8;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: .1em;
}

.service-card h3 {
  margin-top: 11px;

  font-family: var(--heading);

  font-size: 27px;
  line-height: 1;

  position: relative;
  z-index: 2;
}

.service-card p {
  margin-top: 18px;

  color: #a7aac1;

  line-height: 1.65;
  font-size: 15px;

  position: relative;
  z-index: 2;
}

.learn-more {
  margin-top: 22px;

  border: 0;
  background: transparent;

  color: white;

  font-weight: 800;
  font-size: 13px;

  position: relative;
  z-index: 5;

  transition: color .25s ease;
}

.learn-more span {
  margin-left: 8px;
}

.learn-more:hover {
  color: #ff4d8b;
}


/* ================= WORK ================= */

.work {
  background: #09090f;
}

.work-placeholder {
  height: 470px;

  position: relative;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 25px;

  background:
    radial-gradient(
      circle at 25% 35%,
      rgba(125,55,255,.2),
      transparent 25%
    ),
    radial-gradient(
      circle at 75% 60%,
      rgba(239,55,120,.16),
      transparent 28%
    ),
    #0c0c13;
}

.coming-content {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 90%;

  transform: translate(-50%,-50%);

  text-align: center;

  z-index: 2;
}

.coming-label {
  color: #a4a4bc;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: .2em;
}

.coming-content h3 {
  margin-top: 20px;

  font-family: var(--heading);

  font-size: clamp(50px, 7vw, 90px);
  line-height: .95;
}

.coming-content h3 span {
  background: linear-gradient(
    90deg,
    #bda8ff,
    #823cff,
    #ee3d7d
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.coming-content p {
  margin-top: 25px;

  color: #9b9db4;
}

.orb {
  position: absolute;

  border: 1px solid rgba(130,60,255,.22);

  border-radius: 50%;
}

.orb-one {
  width: 300px;
  height: 300px;

  left: 4%;
  top: -100px;
}

.orb-two {
  width: 200px;
  height: 200px;

  right: 7%;
  bottom: -90px;
}

.orb-three {
  width: 90px;
  height: 90px;

  left: 18%;
  bottom: 15%;
}


/* ================= ABOUT ================= */

.about {
  background: #11111a;
}

.about-grid {
  display: grid;

  grid-template-columns: .95fr 1.05fr;

  gap: 75px;

  align-items: center;
}

.about-image {
  height: 520px;

  position: relative;

  overflow: hidden;

  border-radius: 25px;
}

.about-image::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      135deg,
      rgba(145,55,255,.35),
      rgba(240,60,125,.08)
    );

  pointer-events: none;
}

.about-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: saturate(.8);
}

.est-badge {
  position: absolute;

  left: 28px;
  bottom: 28px;

  z-index: 3;

  padding: 16px 20px;

  border-radius: 17px;

  background: #181321;
  border: 1px solid rgba(180,100,255,.35);
}

.est-badge small {
  display: block;

  color: white;

  font-size: 11px;
}

.est-badge strong {
  display: block;

  margin-top: 3px;

  color: #d946ef;

  font-family: var(--heading);
  font-size: 28px;
}

.about-content h2 {
  margin-top: 18px;

  font-family: var(--heading);

  font-size: clamp(45px, 5vw, 70px);
  line-height: .98;
}

.about-content h2 span {
  display: block;

  background: linear-gradient(
    90deg,
    #cfc0ff,
    #8a3fff,
    #ed3e7e
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.about-content p {
  margin-top: 24px;

  color: #a7a9c0;

  font-size: 16px;
  line-height: 1.8;
}

.about-tags {
  display: flex;
  flex-wrap: wrap;

  gap: 10px;

  margin-top: 30px;
}

.about-tags span {
  padding: 9px 13px;

  border: 1px solid rgba(125,70,255,.3);
  border-radius: 999px;

  color: #a9abc2;

  font-size: 11px;
}


/* ================= MISSION ================= */

.mission {
  background:
    radial-gradient(
      circle at center,
      rgba(116,53,255,.09),
      transparent 42%
    );
}

.mission-box {
  max-width: 1080px;

  margin: auto;

  padding: 70px 60px;

  position: relative;

  border: 1px solid rgba(120,67,255,.35);
  border-radius: 25px;

  background: rgba(20,20,31,.7);

  text-align: center;
}

.mission-icon {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  margin: -95px auto 30px;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #873bff,
    #ef3f7d
  );
}

.mission-box p {
  color: white;

  font-size: clamp(20px, 2.3vw, 29px);

  line-height: 1.55;

  font-style: italic;
}


/* ================= WHY ================= */

.why {
  background: #11111a;
}

.why-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 25px;
}

.why-card {
  min-height: 270px;

  padding: 30px;

  border: 1px solid var(--border);
  border-radius: 21px;

  background: #09090f;

  transition:
    transform .35s ease,
    border-color .35s ease;
}

.why-card:hover {
  transform: translateY(-6px);
  border-color: rgba(220,100,255,.45);
}

.why-icon {
  width: 60px;
  height: 60px;

  display: grid;
  place-items: center;

  margin-bottom: 28px;

  border-radius: 14px;

  color: white;

  font-size: 24px;
}

.pink-icon {
  background: linear-gradient(135deg,#d938b4,#ef3975);
}

.orange-icon {
  background: linear-gradient(135deg,#ff9a00,#ff6200);
}

.blue-icon {
  background: linear-gradient(135deg,#06aeea,#2d5cf1);
}

.green-icon {
  background: linear-gradient(135deg,#15b995,#0a7fa4);
}

.violet-icon {
  background: linear-gradient(135deg,#814eff,#4934d5);
}

.why-card h3 {
  font-family: var(--heading);

  font-size: 24px;
}

.why-card p {
  margin-top: 15px;

  color: #9ea1b8;

  line-height: 1.7;
}


/* ================= CONTACT ================= */

.contact {
  background:
    radial-gradient(
      circle at 50% 0,
      rgba(130,50,255,.12),
      transparent 40%
    );
}

.contact-heading {
  text-align: center;

  max-width: 900px;

  margin: auto;
}

.contact-heading p {
  max-width: 760px;

  margin: 25px auto 0;

  color: #a8abc1;

  font-size: 18px;
  line-height: 1.7;
}

.contact-grid {
  display: grid;

  grid-template-columns: 1fr .85fr;

  gap: 35px;

  margin-top: 70px;
}

.contact-card {
  padding: 48px;

  border: 1px solid var(--border);
  border-radius: 24px;

  background: #11111b;
}

.contact-small {
  color: var(--pink);

  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
}

.contact-card h3 {
  margin-top: 18px;

  font-family: var(--heading);

  font-size: 45px;
}

.contact-card p {
  max-width: 550px;

  margin: 18px 0 30px;

  color: #a7a9c0;

  line-height: 1.7;
}

.contact-methods {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.contact-method {
  min-height: 105px;

  display: flex;
  align-items: center;

  gap: 20px;

  padding: 20px;

  border: 1px solid var(--border);
  border-radius: 19px;

  background: #11111b;

  transition: .3s;
}

.contact-method:hover {
  transform: translateX(5px);

  border-color: rgba(230,70,150,.45);
}

.contact-method-icon {
  width: 55px;
  height: 55px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 14px;

  font-size: 23px;
}

.contact-method-icon.email {
  background: linear-gradient(135deg,#883cff,#e43e88);
}

.contact-method-icon.whatsapp-icon {
  background: linear-gradient(135deg,#6e36ff,#963cff);
}

.contact-method-icon.instagram {
  background: linear-gradient(135deg,#743dff,#e63c87);
}

.contact-method-icon.facebook {
  background: #3166db;
}

.contact-method small {
  display: block;

  color: #85879c;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
}

.contact-method a,
.contact-method strong {
  display: block;

  margin-top: 5px;

  color: white;

  font-size: 14px;
}


/* ================= FOOTER ================= */

footer {
  padding: 75px 0 25px;

  background: #10101a;

  border-top: 1px solid rgba(130,111,255,.2);
}

.footer-grid {
  display: grid;

  grid-template-columns: 1.5fr 1fr 1.3fr;

  gap: 70px;
}

.footer-brand img {
  width: 210px;
  max-height: 75px;

  object-fit: contain;
  object-position: left center;
}

.footer-brand p {
  max-width: 400px;

  margin-top: 22px;

  color: #9295ad;

  line-height: 1.7;
}

.footer-socials {
  display: flex;
  gap: 10px;

  margin-top: 25px;
}

.footer-socials a {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 50%;

  color: #9fa1b8;

  font-size: 11px;

  transition: .25s;
}

.footer-socials a:hover {
  color: white;
  border-color: var(--pink);
}

.footer-column h4 {
  margin-bottom: 18px;

  font-family: var(--heading);

  font-size: 20px;
}

.footer-column a {
  display: block;

  margin: 11px 0;

  color: #9295ad;

  font-size: 13px;

  transition: .25s;
}

.footer-column a:hover {
  color: #f04483;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;

  gap: 20px;

  margin-top: 60px;
  padding-top: 20px;

  border-top: 1px solid rgba(130,111,255,.14);
}

.footer-bottom p {
  color: #66697c;

  font-size: 10px;
}


/* ================= MODAL ================= */

.service-modal {
  position: fixed;
  inset: 0;

  display: none;

  z-index: 3000;
}

.service-modal.active {
  display: block;
}

.modal-overlay {
  position: absolute;
  inset: 0;

  background: rgba(0,0,0,.78);
  backdrop-filter: blur(12px);
}

.modal-box {
  width: min(620px, calc(100% - 30px));

  max-height: 85vh;
  overflow-y: auto;

  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%,-50%);

  padding: 45px;

  border: 1px solid rgba(145,75,255,.45);
  border-radius: 24px;

  background: #12121d;

  box-shadow: 0 30px 100px rgba(0,0,0,.6);
}

.modal-close {
  position: absolute;

  right: 20px;
  top: 15px;

  border: 0;

  background: transparent;

  color: white;

  font-size: 32px;
}

.modal-number {
  color: var(--pink);

  font-weight: 800;
}

.modal-box h2 {
  margin-top: 12px;

  font-family: var(--heading);

  font-size: 46px;
  line-height: 1;
}

.modal-box > p {
  margin-top: 20px;

  color: #a8abc1;

  line-height: 1.7;
}

.modal-box ul {
  margin: 25px 0;

  padding-left: 20px;

  color: #b7b9cd;

  line-height: 2;
}


/* ================= BACK TOP ================= */

.back-top {
  position: fixed;

  right: 22px;
  bottom: 22px;

  width: 45px;
  height: 45px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 50%;

  background: #151522;

  color: white;

  z-index: 900;

  opacity: 0;
  visibility: hidden;

  transition: .3s;
}

.back-top.show {
  opacity: 1;
  visibility: visible;
}


/* ================= REVEAL ================= */

.reveal {
  opacity: 0;

  transform: translateY(35px);

  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}


/* ================= TABLET ================= */

@media (max-width: 1000px) {

  .desktop-nav,
  .nav-button {
    display: none;
  }

  .menu-button {
    display: block;
  }

  .mobile-nav {
    padding: 15px 35px 25px;

    background: #0b0b11;

    border-top: 1px solid rgba(130,111,255,.12);
  }

  .mobile-nav.active {
    display: block;
  }

  .mobile-nav a {
    display: block;

    padding: 15px 0;

    border-bottom: 1px solid rgba(255,255,255,.06);

    color: #a9abbf;

    font-size: 14px;
  }

  .mobile-nav .mobile-cta {
    margin-top: 15px;

    padding: 14px;

    border: 0;

    border-radius: 999px;

    background: linear-gradient(
      90deg,
      var(--purple),
      var(--pink)
    );

    color: white;

    text-align: center;
  }

  .services-grid,
  .why-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

}


/* ================= MOBILE ================= */

@media (max-width: 650px) {

  .container {
    width: calc(100% - 30px);
  }

  .section {
    padding: 80px 0;
  }

  .brand {
    width: 150px;
  }

  .hero {
    min-height: 850px;
  }

  .hero h1 {
    font-size: clamp(50px, 15vw, 72px);
  }

  .hero-content > p {
    font-size: 16px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: stretch;
  }

  .gradient-button,
  .outline-button {
    width: 100%;
  }

  .section-heading h2,
  .contact-heading h2 {
    font-size: 48px;
  }

  .section-heading p {
    font-size: 16px;
  }

  .services-grid,
  .why-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: auto;
  }

  .work-placeholder {
    height: 380px;
  }

  .coming-content h3 {
    font-size: 54px;
  }

  .about-image {
    height: 340px;
  }

  .about-content h2 {
    font-size: 48px;
  }

  .mission-box {
    padding: 55px 25px;
  }

  .mission-box p {
    font-size: 19px;
  }

  .contact-card {
    padding: 30px 24px;
  }

  .contact-card h3 {
    font-size: 38px;
  }

  .contact-method {
    min-height: 90px;
  }

  .contact-method a,
  .contact-method strong {
    font-size: 12px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .footer-bottom {
    flex-direction: column;
  }

  .modal-box {
    padding: 35px 25px;
  }

  .modal-box h2 {
    font-size: 38px;
  }

}


/* ================= REDUCED MOTION ================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }

}
