/* =========================================================
   BRANDSPIRE MEDIA
   Premium Black + Gold Website
   Responsive / Mobile Friendly
========================================================= */


/* =========================
   RESET
========================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  font-family: "Inter", Arial, sans-serif;
  background: #070707;
  color: #f4f1e8;
  overflow-x: hidden;
  line-height: 1.55;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}


/* =========================
   VARIABLES
========================= */

:root {
  --black: #070707;
  --black-soft: #0c0c0c;
  --black-light: #111111;

  --gold: #e6ad39;
  --gold-light: #f0c45a;
  --gold-dark: #9b701d;

  --white: #f4f1e8;
  --text: #b0afa9;
  --muted: #777773;

  --border: #242424;
  --border-gold: #77581b;
}


/* =========================
   HEADER
========================= */

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;

  width: 100%;
  height: 82px;

  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 4vw;

  background: rgba(5, 5, 5, 0.82);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  border-bottom: 1px solid rgba(230, 173, 57, 0.14);

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.site-header.scrolled {
  background: rgba(5, 5, 5, 0.97);

  box-shadow:
    0 8px 35px rgba(0, 0, 0, 0.45);
}


/* Logo */

.brand {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand img {
  width: 190px;
  height: auto;
}


/* =========================
   NAVIGATION
========================= */

.nav {
  display: flex;
  align-items: center;
  gap: 27px;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.nav a {
  position: relative;

  color: #ddd;
  opacity: 0.85;

  transition:
    color 0.25s ease,
    opacity 0.25s ease;
}

.nav a:hover {
  color: var(--gold);
  opacity: 1;
}


/* Gold underline */

.nav a:not(.nav-cta)::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -8px;

  width: 0;
  height: 1px;

  background: var(--gold);

  transition: width 0.25s ease;
}

.nav a:not(.nav-cta):hover::after {
  width: 100%;
}


/* Connect button */

.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  padding: 12px 16px;

  border: 1px solid var(--gold-dark);

  color: var(--gold) !important;

  opacity: 1 !important;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.nav-cta:hover {
  background: var(--gold);
  color: #111 !important;
  transform: translateY(-2px);
}

.nav-cta span {
  font-size: 16px;
}


/* =========================
   MOBILE MENU BUTTON
========================= */

.menu-toggle {
  display: none;

  width: 42px;
  height: 42px;

  padding: 7px;

  background: transparent;
  border: 0;

  cursor: pointer;
}

.menu-toggle span {
  display: block;

  width: 100%;
  height: 2px;

  margin: 6px 0;

  background: var(--gold);

  transition:
    transform 0.3s ease,
    opacity 0.3s ease;
}


/* =========================
   GENERAL SECTION
========================= */

.section {
  position: relative;

  width: 100%;

  padding: 105px 4vw;
}


/* =========================
   HERO
========================= */

.hero {
  min-height: 760px;

  padding-top: 155px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.02fr)
    minmax(0, 0.98fr);

  align-items: center;

  gap: 50px;

  background:
    radial-gradient(
      circle at 65% 35%,
      rgba(191, 137, 28, 0.11),
      transparent 34%
    ),
    linear-gradient(
      110deg,
      #050505 0%,
      #090909 55%,
      #0d0d0d 100%
    );

  overflow: hidden;
}


/* Hero copy */

.hero-copy {
  max-width: 720px;
  min-width: 0;
}

.eyebrow {
  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.22em;

  color: var(--gold);
}

.hero h1 {
  font-size: clamp(52px, 7vw, 98px);

  line-height: 0.95;

  letter-spacing: -0.055em;

  margin: 22px 0;

  color: var(--white);
}

.hero h1 em,
h2 em {
  color: var(--gold);
  font-style: normal;
}

.hero-text {
  max-width: 590px;

  color: var(--text);

  font-size: 16px;
}


/* Hero buttons */

.hero-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 14px;

  margin-top: 34px;
}


/* =========================
   BUTTONS
========================= */

.btn {
  min-height: 50px;

  padding: 0 24px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 18px;

  border: 1px solid var(--border-gold);

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.04em;

  text-transform: uppercase;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    box-shadow 0.25s ease;
}

.btn span {
  font-size: 17px;
}


/* Gold */

.btn-gold {
  background: var(--gold);

  color: #111;

  border-color: var(--gold);
}

.btn-gold:hover {
  transform: translateY(-3px);

  background: var(--gold-light);

  box-shadow:
    0 10px 28px rgba(230, 178, 62, 0.2);
}


/* Outline */

.btn-outline {
  color: #f3e5c1;

  background: transparent;
}

.btn-outline:hover {
  background: var(--gold);

  color: #111;

  border-color: var(--gold);

  transform: translateY(-3px);
}


/* =========================
   HERO VISUAL
========================= */

.hero-visual {
  position: relative;

  min-height: 520px;

  display: flex;

  align-items: center;
  justify-content: center;

  min-width: 0;
}


/* Glow */

.glow {
  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  background:
    rgba(210, 151, 30, 0.14);

  filter: blur(70px);

  pointer-events: none;
}


/* Main photo */

.hero-photo {
  position: relative;

  width: min(600px, 100%);
  height: 480px;

  overflow: hidden;

  border:
    1px solid rgba(230, 178, 62, 0.28);

  clip-path:
    polygon(
      10% 0,
      100% 0,
      92% 100%,
      0 100%
    );

  filter: saturate(0.75);
}

.hero-photo img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 0.7s ease;
}

.hero-photo:hover img {
  transform: scale(1.04);
}


/* Logo card */

.hero-logo-card {
  position: absolute;

  right: 0;
  bottom: 45px;

  width: 235px;
  height: 145px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 25px;

  background:
    rgba(4, 4, 4, 0.9);

  border: 1px solid var(--gold-dark);

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.45);
}

.hero-logo-card img {
  max-width: 100%;
  max-height: 100%;

  object-fit: contain;
}


/* Floating stat */

.floating-stat {
  position: absolute;

  left: 0;
  bottom: 70px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 17px 22px;

  background: #0b0b0b;

  border-left: 3px solid var(--gold);

  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.7);
}

.floating-stat strong {
  color: var(--gold);

  font-size: 32px;
}

.floating-stat span {
  color: #bbb;

  font-size: 9px;

  letter-spacing: 0.14em;
}


/* =========================
   SECTION HEAD
========================= */

.section-head {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 25px;
}

.mini-label {
  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.22em;

  color: var(--gold);
}

.section-head h2,
h2 {
  font-size: 28px;

  line-height: 1.1;

  letter-spacing: -0.035em;

  margin-top: 7px;
}


/* =========================
   TEXT LINK
========================= */

.text-link {
  display: inline-flex;

  align-items: center;

  background: transparent;

  border: 0;

  color: #ddd;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.04em;

  text-transform: uppercase;

  cursor: pointer;
}

.text-link span {
  color: var(--gold);

  font-size: 19px;

  margin-left: 12px;

  transition:
    transform 0.25s ease;
}

.text-link:hover {
  color: var(--gold);
}

.text-link:hover span {
  transform: translateX(5px);
}


/* =========================
   SERVICES
========================= */

.split-section {
  border-top: 1px solid #202020;
}


/* Service grid */

.services-grid {
  display: grid;

  grid-template-columns:
    repeat(8, minmax(0, 1fr));

  width: 100%;

  border: 1px solid #1d1d1d;
}


/* Service card */

.service-card {
  min-height: 180px;

  padding: 24px 14px;

  border-right: 1px solid #1d1d1d;

  text-align: center;

  transition:
    background 0.3s ease,
    transform 0.3s ease;
}

.service-card:last-child {
  border-right: 0;
}

.service-card:hover {
  background: #101010;

  transform: translateY(-4px);
}


/* Service icon */

.service-icon {
  height: 64px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: var(--gold);

  font-size: 42px;

  transition:
    transform 0.3s ease;
}

.service-card:hover .service-icon {
  transform: scale(1.08);
}

.service-card h3 {
  font-size: 12px;

  line-height: 1.45;

  text-transform: uppercase;
}

.service-card p {
  color: #858585;

  font-size: 10px;

  margin-top: 10px;
}


/* =========================
   WORK
========================= */

.work-section {
  overflow: hidden;
}

.work-grid {
  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 6px;
}

.work-card {
  position: relative;

  height: 265px;

  overflow: hidden;

  border-radius: 4px;

  background: #111;
}

.work-card img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    brightness(0.68)
    saturate(0.8);

  transition:
    transform 0.5s ease,
    filter 0.5s ease;
}

.work-card:hover img {
  transform: scale(1.07);

  filter:
    brightness(0.82)
    saturate(0.95);
}

.work-card > div {
  position: absolute;

  left: 14px;
  bottom: 13px;

  text-shadow:
    0 2px 12px #000;
}

.work-card small {
  color: var(--gold);

  font-size: 9px;

  font-weight: 800;
}

.work-card h3 {
  font-size: 12px;
}


/* Portfolio notice */

.portfolio-note {
  margin-top: 18px;

  padding: 16px 20px;

  display: flex;

  align-items: center;

  gap: 20px;

  border: 1px solid #272727;

  background: #0c0c0c;
}

.portfolio-note strong {
  color: var(--gold);

  font-size: 11px;

  white-space: nowrap;
}

.portfolio-note span {
  color: #8e8e8e;

  font-size: 12px;
}


/* =========================
   ABOUT
========================= */

.info-section {
  display: grid;

  grid-template-columns:
    1fr 1fr 1.25fr;

  gap: 0;

  border-top: 1px solid #202020;

  padding-bottom: 50px;
}


/* Columns */

.about-col,
.why-col,
.impact-col {
  padding: 10px 40px 25px 0;

  margin-right: 40px;

  border-right: 1px solid #252525;
}

.why-col,
.impact-col {
  padding-left: 0;
}


/* About text */

.about-col p:not(.mini-label),
.contact-copy > p:not(.mini-label) {
  max-width: 440px;

  margin: 20px 0 25px;

  color: #aaa;

  font-size: 13px;
}


/* Small button */

.small {
  min-height: 42px;

  padding: 0 18px;

  font-size: 10px;
}


/* =========================
   CHECK LIST
========================= */

.check-list {
  list-style: none;

  margin-top: 20px;
}

.check-list li {
  color: #bbb;

  font-size: 12px;

  margin: 12px 0;
}

.check-list li::before {
  content: "✓";

  color: var(--gold);

  font-weight: 900;

  margin-right: 12px;
}


/* =========================
   STATS
========================= */

.stats {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 12px;

  margin-top: 25px;
}

.stats strong {
  display: block;

  color: var(--gold);

  font-size: 35px;

  line-height: 1;
}

.stats span {
  display: block;

  color: #aaa;

  font-size: 9px;

  margin-top: 9px;
}


/* =========================
   ABOUT PHOTO
========================= */

.about-photo {
  grid-column: 1 / -1;

  height: 270px;

  margin-top: 30px;

  overflow: hidden;

  border: 1px solid #242424;
}

.about-photo img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    brightness(0.62)
    saturate(0.75);

  transition:
    transform 0.6s ease;
}

.about-photo:hover img {
  transform: scale(1.03);
}


/* =========================
   CTA
========================= */

.cta-section {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  border-top: 1px solid #242424;

  border-bottom: 1px solid #242424;

  background:
    linear-gradient(
      90deg,
      #0a0a0a,
      #111008,
      #0a0a0a
    );
}

.cta-section h2 {
  font-size: clamp(27px, 3vw, 43px);
}

.cta-actions {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;
}


/* =========================
   REVIEWS
========================= */

.reviews {
  border-bottom: 1px solid #202020;
}

.review-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;
}

.review-card {
  padding: 25px;

  border: 1px solid #232323;

  background: #0c0c0c;

  transition:
    transform 0.3s ease,
    border-color 0.3s ease;
}

.review-card:hover {
  transform: translateY(-4px);

  border-color: var(--gold-dark);
}

.stars {
  color: var(--gold);

  letter-spacing: 4px;
}

.review-card p {
  color: #aaa;

  font-size: 13px;

  margin: 18px 0;
}

.review-card strong {
  font-size: 11px;
}


/* =========================
   CONTACT
========================= */

.contact {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 60px;

  background:
    radial-gradient(
      circle at 80% 50%,
      rgba(210, 151, 30, 0.1),
      transparent 35%
    );
}

.contact-copy h2 {
  font-size: 54px;
}

.contact-links {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 12px;

  align-content: center;
}

.contact-links a {
  padding: 20px;

  border: 1px solid #252525;

  background: #0b0b0b;

  font-size: 12px;

  font-weight: 700;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.contact-links a:hover {
  border-color: var(--gold-dark);

  background: #101010;

  transform: translateY(-3px);
}

.contact-links span {
  color: var(--gold);

  margin-right: 12px;
}


/* =========================
   FOOTER
========================= */

.footer {
  position: relative;

  display: grid;

  grid-template-columns:
    1.5fr 1.4fr 1fr 1.3fr;

  gap: 40px;

  padding: 45px 4vw 18px;

  border-top: 1px solid #202020;
}

.footer-brand img {
  width: 250px;

  max-width: 100%;

  margin-bottom: 8px;
}

.footer p,
.footer a {
  display: block;

  color: #969696;

  font-size: 11px;

  margin: 8px 0;
}

.footer a {
  transition: color 0.2s ease;
}

.footer a:hover {
  color: var(--gold);
}

.footer h4 {
  color: var(--gold);

  font-size: 12px;

  margin-bottom: 18px;
}


/* Social */

.socials {
  display: flex;

  gap: 9px;
}

.socials a {
  width: 35px;
  height: 35px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 1px solid #2a2a2a;

  color: #ddd;

  transition:
    border-color 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.socials a:hover {
  border-color: var(--gold);

  color: var(--gold);

  transform: translateY(-2px);
}


/* Footer bottom */

.footer-bottom {
  grid-column: 1 / -1;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-top: 10px;

  padding-top: 17px;

  border-top: 1px solid #202020;

  color: #686868;

  font-size: 9px;
}


/* =========================
   FLOATING WHATSAPP
========================= */

.floating-wa {
  position: fixed;

  right: 22px;
  bottom: 22px;

  z-index: 900;

  width: 49px;
  height: 49px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--gold);

  color: #111;

  font-size: 10px;

  font-weight: 900;

  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.45);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.floating-wa:hover {
  transform: scale(1.08);

  box-shadow:
    0 10px 35px rgba(230, 173, 57, 0.25);
}


/* =========================
   BACK TO TOP
========================= */

.back-top {
  position: fixed;

  right: 22px;
  bottom: 82px;

  z-index: 900;

  width: 49px;
  height: 49px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #101010;

  border: 1px solid #765719;

  color: #ddd;

  cursor: pointer;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}

.back-top.show {
  opacity: 1;

  pointer-events: auto;
}

.back-top:hover {
  transform: translateY(-3px);

  color: var(--gold);
}


/* =========================
   REVIEW MODAL
========================= */

.modal {
  position: fixed;

  inset: 0;

  z-index: 2000;

  display: none;

  align-items: center;
  justify-content: center;

  padding: 20px;

  background:
    rgba(0, 0, 0, 0.8);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.modal.open {
  display: flex;
}

.modal-box {
  position: relative;

  width: min(520px, 100%);

  padding: 32px;

  background: #0d0d0d;

  border: 1px solid var(--gold-dark);

  box-shadow:
    0 25px 80px rgba(0, 0, 0, 0.65);
}

.modal-close {
  position: absolute;

  top: 10px;
  right: 15px;

  background: transparent;

  border: 0;

  color: #aaa;

  font-size: 28px;

  cursor: pointer;

  transition:
    color 0.2s ease;
}

.modal-close:hover {
  color: var(--gold);
}

.modal-box h2 {
  font-size: 30px;

  margin-bottom: 25px;
}

.modal-box label {
  display: block;

  color: #aaa;

  font-size: 11px;

  margin: 14px 0;
}

.modal-box input,
.modal-box textarea {
  display: block;

  width: 100%;

  margin-top: 7px;

  padding: 12px;

  background: #070707;

  border: 1px solid #292929;

  outline: none;

  color: #fff;

  border-radius: 0;

  transition:
    border-color 0.2s ease;
}

.modal-box input:focus,
.modal-box textarea:focus {
  border-color: var(--gold-dark);
}

.modal-box textarea {
  height: 120px;

  resize: vertical;
}


/* Rating */

.rating-input {
  display: flex;

  gap: 4px;

  margin-top: 8px;
}

.rating-input button {
  padding: 0;

  background: transparent;

  border: 0;

  color: #4a4a4a;

  font-size: 25px;

  cursor: pointer;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.rating-input button:hover {
  transform: scale(1.08);
}

.rating-input button.active {
  color: var(--gold);
}


/* =========================
   SCROLL REVEAL
========================= */

.reveal {
  opacity: 0;

  transform: translateY(25px);

  transition:
    opacity 0.65s ease,
    transform 0.65s ease;
}

.reveal.visible {
  opacity: 1;

  transform: none;
}


/* =========================
   TABLET
========================= */

@media (max-width: 1050px) {

  .nav {
    gap: 16px;
  }

  .services-grid {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .service-card {
    border-bottom: 1px solid #1d1d1d;
  }

  .work-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .work-card {
    height: 240px;
  }

  .info-section {
    grid-template-columns:
      1fr 1fr;
  }

  .impact-col {
    border-right: 0;
  }

  .about-photo {
    grid-column: 1 / -1;
  }
}


/* =========================
   TABLET / MOBILE
========================= */

@media (max-width: 850px) {

  .site-header {
    height: 72px;

    padding:
      0 20px;
  }

  .brand img {
    width: 165px;
  }


  /* Mobile menu */

  .menu-toggle {
    display: block;
  }

  .nav {
    position: absolute;

    top: 72px;

    left: 0;
    right: 0;

    display: none;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding:
      12px 20px 20px;

    background: #090909;

    border-bottom:
      1px solid #2a210f;
  }

  .nav.open {
    display: flex;
  }

  .nav a {
    padding: 13px 4px;
  }

  .nav a:not(.nav-cta)::after {
    display: none;
  }

  .nav-cta {
    margin-top: 6px;

    text-align: center;
  }


  /* Hero */

  .hero {
    grid-template-columns: 1fr;

    padding-top: 125px;

    min-height: auto;
  }

  .hero-copy {
    width: 100%;
  }

  .hero-visual {
    min-height: 420px;
  }

  .hero-photo {
    height: 390px;
  }


  /* Logo */

  .hero-logo-card {
    width: 190px;
    height: 115px;

    right: 4%;

    bottom: 35px;
  }


  /* Stat */

  .floating-stat {
    left: 2%;

    bottom: 50px;
  }


  /* About */

  .info-section {
    grid-template-columns: 1fr;
  }

  .about-col,
  .why-col,
  .impact-col {
    border-right: 0;

    border-bottom:
      1px solid #252525;

    padding:
      0 0 30px;

    margin:
      0 0 30px;
  }

  .stats {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }


  /* CTA */

  .cta-section {
    align-items: flex-start;

    flex-direction: column;
  }


  /* Contact */

  .contact {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  /* Footer */

  .footer {
    grid-template-columns:
      1fr 1fr;
  }

  .footer-bottom {
    grid-column: 1 / -1;

    flex-direction: column;

    align-items: flex-start;
  }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 560px) {

  .section {
    padding:
      75px 18px;
  }


  /* Header */

  .site-header {
    padding:
      0 16px;
  }

  .brand img {
    width: 155px;
  }


  /* Hero */

  .hero {
    padding-top: 120px;
  }

  .eyebrow {
    font-size: 9px;

    letter-spacing:
      0.16em;
  }

  .hero h1 {
    font-size: 49px;

    letter-spacing:
      -0.05em;
  }

  .hero-text {
    font-size: 14px;
  }


  /* Buttons */

  .hero-actions {
    display: grid;

    grid-template-columns: 1fr;

    width: 100%;
  }

  .btn {
    width: 100%;

    padding:
      0 16px;
  }


  /* Hero visual */

  .hero-visual {
    min-height: 300px;
  }

  .hero-photo {
    height: 285px;
  }

  .hero-logo-card {
    width: 145px;
    height: 85px;

    padding: 15px;

    right: 2%;

    bottom: 18px;
  }

  .floating-stat {
    bottom: 25px;

    padding:
      10px 12px;
  }

  .floating-stat strong {
    font-size: 24px;
  }

  .floating-stat span {
    font-size: 8px;
  }


  /* Section heading */

  .section-head {
    align-items: flex-start;

    flex-direction: column;
  }

  .section-head h2,
  h2 {
    font-size: 24px;
  }


  /* Services */

  .services-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .service-card {
    min-height: 165px;

    padding:
      20px 8px;
  }

  .service-icon {
    height: 55px;

    font-size: 34px;
  }

  .service-card h3 {
    font-size: 10px;
  }

  .service-card p {
    display: none;
  }


  /* Work */

  .work-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .work-card {
    height: 220px;
  }

  .work-card:last-child {
    grid-column: 1 / -1;
  }


  /* Portfolio note */

  .portfolio-note {
    display: block;
  }

  .portfolio-note strong {
    display: block;
  }

  .portfolio-note span {
    display: block;

    margin-top: 8px;
  }


  /* Stats */

  .stats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 25px;
  }


  /* About image */

  .about-photo {
    height: 210px;
  }


  /* CTA */

  .cta-section h2 {
    font-size: 28px;
  }


  /* Contact */

  .contact-copy h2 {
    font-size: 43px;
  }

  .contact-links {
    grid-template-columns: 1fr;
  }


  /* Footer */

  .footer {
    grid-template-columns: 1fr;

    gap: 28px;

    padding:
      38px 18px 18px;
  }

  .footer-bottom {
    grid-column: 1;

    font-size: 8px;
  }


  /* Floating buttons */

  .floating-wa {
    right: 15px;

    bottom: 15px;
  }

  .back-top {
    right: 15px;

    bottom: 75px;
  }


  /* Modal */

  .modal {
    padding: 15px;
  }

  .modal-box {
    padding: 25px;
  }
}


/* =========================
   EXTRA SMALL DEVICES
========================= */

@media (max-width: 380px) {

  .brand img {
    width: 140px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero-logo-card {
    width: 125px;
    height: 75px;
  }

  .floating-stat {
    padding: 8px 10px;
  }

  .floating-stat strong {
    font-size: 21px;
  }

  .service-card {
    min-height: 150px;
  }

  .work-card {
    height: 195px;
  }
}


/* =========================
   REDUCED MOTION
========================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;

    transform: none;

    transition: none;
  }

  .btn,
  .service-card,
  .work-card img,
  .about-photo img,
  .hero-photo img {
    transition: none;
  }
}
