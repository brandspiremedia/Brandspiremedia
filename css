/* =========================================================
   BRANDSPIRE MEDIA
   COMPACT PREMIUM BLACK + GOLD DESIGN
========================================================= */


/* =========================
   RESET
========================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  width: 100%;
  min-width: 0;

  overflow-x: hidden;

  background: #070707;

  color: #f5f2e9;

  font-family:
    "Inter",
    Arial,
    sans-serif;

  line-height: 1.5;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font-family: inherit;
}


/* =========================
   COLORS
========================= */

:root {

  --black: #070707;

  --black-2: #0b0b0b;

  --black-3: #101010;

  --gold: #e4ad3b;

  --gold-light: #f2c65e;

  --gold-dark: #805d1b;

  --white: #f5f2e9;

  --grey: #a4a29b;

  --grey-dark: #696863;

  --border: #222222;

}


/* =========================
   HEADER
========================= */

.header {

  position: fixed;

  top: 0;
  left: 0;
  right: 0;

  width: 100%;

  height: 62px;

  z-index: 1000;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding:
    0 28px;

  background:
    rgba(5, 5, 5, 0.93);

  border-bottom:
    1px solid rgba(228, 173, 59, 0.12);

  backdrop-filter:
    blur(14px);

  -webkit-backdrop-filter:
    blur(14px);

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.header.scrolled {

  background:
    rgba(5, 5, 5, 0.98);

  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.5);
}


/* Logo */

.logo {

  display: flex;

  align-items: center;

  flex-shrink: 0;
}

.logo img {

  width: 128px;

  height: auto;
}


/* =========================
   NAVIGATION
========================= */

.navigation {

  display: flex;

  align-items: center;

  gap: 24px;

  font-size: 9px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 0.03em;
}

.navigation > a {

  position: relative;

  color: #d8d6d0;

  transition:
    color 0.2s ease;
}

.navigation > a:hover {

  color: var(--gold);
}


/* underline */

.navigation > a:not(.connect-button)::after {

  content: "";

  position: absolute;

  left: 0;
  bottom: -7px;

  width: 0;

  height: 1px;

  background:
    var(--gold);

  transition:
    width 0.2s ease;
}

.navigation > a:not(.connect-button):hover::after {

  width: 100%;
}


/* Connect */

.connect-button {

  display: flex;

  align-items: center;

  gap: 7px;

  padding:
    7px 12px;

  border:
    1px solid var(--gold-dark);

  color:
    var(--gold) !important;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.connect-button:hover {

  background:
    var(--gold);

  color:
    #111 !important;
}

.connect-button span {

  font-size: 12px;
}


/* =========================
   MOBILE MENU BUTTON
========================= */

.menu-button {

  display: none;

  width: 36px;

  height: 36px;

  padding: 5px;

  background: transparent;

  border: 0;

  cursor: pointer;
}

.menu-button span {

  display: block;

  width: 100%;

  height: 2px;

  margin:
    5px 0;

  background:
    var(--gold);

  transition:
    transform 0.3s ease;
}


/* =========================
   HERO
========================= */

.hero {

  position: relative;

  width: 100%;

  min-height: 265px;

  margin-top: 62px;

  padding:
    38px 28px 28px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  align-items: center;

  gap: 25px;

  overflow: hidden;

  background:

    radial-gradient(
      circle at 48% 70%,
      rgba(224, 169, 48, 0.16),
      transparent 24%
    ),

    linear-gradient(
      110deg,
      #050505,
      #090909 55%,
      #0d0d0d
    );

  border-bottom:
    1px solid var(--border);
}


/* subtle gold line */

.hero::after {

  content: "";

  position: absolute;

  width: 430px;

  height: 1px;

  left: 18%;

  bottom: 8px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--gold),
      transparent
    );

  transform:
    rotate(16deg);

  opacity: 0.55;

  pointer-events: none;
}


/* Hero text */

.hero-content {

  position: relative;

  z-index: 2;

  min-width: 0;

  max-width: 570px;
}

.small-title {

  color:
    var(--gold);

  font-size: 9px;

  font-weight: 800;

  letter-spacing:
    0.12em;

  margin-bottom: 8px;
}

.hero h1 {

  max-width: 570px;

  font-size:
    clamp(31px, 4.3vw, 58px);

  line-height:
    0.96;

  letter-spacing:
    -0.055em;

  color:
    var(--white);

  margin-bottom: 12px;
}

.hero h1 span {

  display: block;

  color:
    var(--gold);
}

.hero-content > p {

  max-width: 460px;

  color:
    #9e9d97;

  font-size: 10px;

  line-height: 1.6;
}


/* Hero buttons */

.hero-buttons {

  display: flex;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 16px;
}


/* =========================
   BUTTONS
========================= */

.button {

  min-height: 34px;

  padding:
    0 15px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 11px;

  border:
    1px solid var(--gold-dark);

  font-size: 8px;

  font-weight: 800;

  letter-spacing:
    0.04em;

  text-transform: uppercase;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease;
}

.button span {

  font-size: 11px;
}

.gold-button {

  background:
    var(--gold);

  color:
    #111;

  border-color:
    var(--gold);
}

.gold-button:hover {

  background:
    var(--gold-light);

  transform:
    translateY(-2px);

  box-shadow:
    0 7px 20px rgba(228, 173, 59, 0.18);
}

.outline-button {

  background:
    transparent;

  color:
    #e9dfc7;
}

.outline-button:hover {

  background:
    var(--gold);

  color:
    #111;

  transform:
    translateY(-2px);
}


/* =========================
   HERO VISUAL
========================= */

.hero-visual {

  position: relative;

  min-width: 0;

  height: 205px;

  display: flex;

  align-items: center;

  justify-content: center;
}


/* Gold glow */

.gold-glow {

  position: absolute;

  width: 190px;

  height: 190px;

  border-radius: 50%;

  background:
    rgba(220, 157, 29, 0.14);

  filter:
    blur(45px);
}


/* Main logo */

.brand-display {

  position: relative;

  z-index: 4;

  width: 225px;

  padding: 14px;

  text-align: center;

  background:
    rgba(5, 5, 5, 0.75);

  border:
    1px solid rgba(228, 173, 59, 0.3);

  box-shadow:
    0 15px 35px rgba(0, 0, 0, 0.45);
}

.brand-display img {

  width: 180px;

  max-width: 100%;

  margin:
    0 auto 6px;
}

.brand-display p {

  color:
    #b7b4ab;

  font-size: 6px;

  font-weight: 700;

  letter-spacing:
    0.18em;
}


/* =========================
   COLLAGE
========================= */

.creative-collage {

  position: absolute;

  width: 100%;

  height: 100%;

  right: 0;

  top: 0;
}

.collage-card {

  position: absolute;

  width: 92px;

  height: 65px;

  display: flex;

  align-items: flex-end;

  padding: 8px;

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, 0.1);

  background:
    #151515;

  box-shadow:
    0 10px 25px rgba(0, 0, 0, 0.45);

  transition:
    transform 0.3s ease;
}

.collage-card:hover {

  transform:
    translateY(-4px)
    scale(1.03);
}

.collage-card span {

  position: relative;

  z-index: 2;

  color:
    #fff;

  font-size: 6px;

  font-weight: 800;

  letter-spacing:
    0.08em;

  text-shadow:
    0 2px 8px #000;
}


/* backgrounds */

.card-one {

  top: 2px;

  right: 3%;

  transform:
    rotate(-8deg);

  background:
    linear-gradient(
      135deg,
      #18202a,
      #4c3d28
    );
}

.card-two {

  top: 55px;

  right: 16%;

  transform:
    rotate(7deg);

  background:
    linear-gradient(
      135deg,
      #242b32,
      #786343
    );
}

.card-three {

  top: 4px;

  left: 8%;

  transform:
    rotate(5deg);

  background:
    linear-gradient(
      135deg,
      #171717,
      #72532b
    );
}

.card-four {

  bottom: 8px;

  right: 4%;

  transform:
    rotate(6deg);

  background:
    linear-gradient(
      135deg,
      #141c26,
      #352e3f
    );
}

.card-five {

  bottom: 12px;

  left: 10%;

  transform:
    rotate(-7deg);

  background:
    linear-gradient(
      135deg,
      #211b13,
      #51402c
    );
}


/* =========================
   SERVICES + WORK
========================= */

.services-work {

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  width: 100%;

  border-bottom:
    1px solid var(--border);
}


/* Areas */

.services-area,
.work-area {

  min-width: 0;

  padding:
    25px 24px 22px;
}

.services-area {

  border-right:
    1px solid var(--border);
}


/* =========================
   SECTION HEADING
========================= */

.section-heading {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 12px;

  margin-bottom: 14px;
}

.section-heading p {

  color:
    var(--gold);

  font-size: 7px;

  font-weight: 800;

  letter-spacing:
    0.16em;
}

.section-heading h2 {

  font-size: 18px;

  line-height: 1;

  margin-top: 5px;

  letter-spacing:
    -0.04em;
}

.section-heading h2 span {

  color:
    var(--gold);
}

.section-heading > a {

  color:
    #d8d5cc;

  font-size: 7px;

  font-weight: 800;

  white-space: nowrap;

  text-transform: uppercase;
}

.section-heading > a span {

  color:
    var(--gold);

  font-size: 13px;

  margin-left: 5px;
}


/* =========================
   SERVICES LIST
========================= */

.services-list {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  border:
    1px solid #1d1d1d;
}

.service-item {

  min-height: 95px;

  padding:
    12px 6px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  border-right:
    1px solid #1d1d1d;

  border-bottom:
    1px solid #1d1d1d;

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.service-item:nth-child(4n) {

  border-right: 0;
}

.service-item:nth-last-child(-n + 4) {

  border-bottom: 0;
}

.service-item:hover {

  background:
    #101010;

  transform:
    translateY(-2px);
}

.service-icon {

  height: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  color:
    var(--gold);

  font-size: 25px;

  line-height: 1;
}

.service-item h3 {

  color:
    #ddd;

  font-size: 7px;

  line-height: 1.4;

  font-weight: 700;
}


/* =========================
   WORK LIST
========================= */

.work-list {

  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 4px;
}

.work-card {

  position: relative;

  height: 128px;

  overflow: hidden;

  border-radius: 3px;

  background:
    #171717;

  border:
    1px solid #222;

  transition:
    transform 0.3s ease;
}

.work-card:hover {

  transform:
    translateY(-3px);
}


/* Work visual backgrounds */

.work-product {

  background:
    linear-gradient(
      145deg,
      #1d2225,
      #755d35 60%,
      #121212
    );
}

.work-social {

  background:
    linear-gradient(
      145deg,
      #30353a,
      #8b7656 55%,
      #151515
    );
}

.work-brand {

  background:
    linear-gradient(
      145deg,
      #25221e,
      #806746 55%,
      #161616
    );
}

.work-event {

  background:
    radial-gradient(
      circle at 50% 30%,
      #7e4d7d,
      #25203d 40%,
      #0d0e18
    );
}

.work-content {

  background:
    linear-gradient(
      135deg,
      #161c20,
      #5b4936 55%,
      #101010
    );
}


/* abstract visual detail */

.work-card::before {

  content: "";

  position: absolute;

  inset: 0;

  background:
    radial-gradient(
      circle at 25% 25%,
      rgba(255,255,255,0.2),
      transparent 18%
    ),

    linear-gradient(
      135deg,
      transparent 40%,
      rgba(0,0,0,0.5)
    );

  opacity:
    0.8;

  transition:
    transform 0.5s ease;
}

.work-card:hover::before {

  transform:
    scale(1.12);
}


/* work text */

.work-overlay {

  position: absolute;

  left: 8px;

  right: 5px;

  bottom: 8px;

  z-index: 2;

  text-shadow:
    0 2px 8px #000;
}

.work-overlay small {

  display: block;

  color:
    var(--gold);

  font-size: 6px;

  font-weight: 800;
}

.work-overlay strong {

  display: block;

  color:
    #fff;

  font-size: 7px;

  margin-top: 2px;
}


/* Portfolio message */

.portfolio-message {

  margin-top: 9px;

  padding:
    8px 10px;

  display: flex;

  align-items: center;

  gap: 10px;

  border:
    1px solid #242424;

  background:
    #0c0c0c;
}

.portfolio-message strong {

  color:
    var(--gold);

  font-size: 7px;

  white-space: nowrap;
}

.portfolio-message span {

  color:
    #777;

  font-size: 7px;
}


/* =========================
   INFORMATION
========================= */

.information {

  display: grid;

  grid-template-columns:
    1fr 1.05fr 1.2fr 1.45fr;

  width: 100%;

  border-bottom:
    1px solid var(--border);
}

.info-block,
.info-cta {

  min-width: 0;

  padding:
    23px 20px;
}

.info-block {

  border-right:
    1px solid var(--border);
}

.info-label {

  color:
    var(--gold);

  font-size: 7px;

  font-weight: 800;

  letter-spacing:
    0.14em;

  margin-bottom: 6px;
}

.info-block h2,
.info-cta h2 {

  font-size: 18px;

  line-height: 1.05;

  letter-spacing:
    -0.04em;
}

.info-block h2 span,
.info-cta h2 span {

  color:
    var(--gold);
}

.info-text {

  color:
    #999;

  font-size: 8px;

  line-height: 1.65;

  margin:
    13px 0;
}


/* small about button */

.small-outline-button {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding:
    7px 10px;

  border:
    1px solid var(--gold-dark);

  color:
    #ddd;

  font-size: 7px;

  font-weight: 800;

  text-transform: uppercase;
}

.small-outline-button span {

  color:
    var(--gold);

  font-size: 10px;
}


/* =========================
   WHY LIST
========================= */

.why-list {

  list-style: none;

  margin-top: 12px;
}

.why-list li {

  position: relative;

  color:
    #a7a59e;

  font-size: 8px;

  margin:
    8px 0;

  padding-left: 15px;
}

.why-list li::before {

  content: "✓";

  position: absolute;

  left: 0;

  color:
    var(--gold);

  font-weight: 900;
}


/* =========================
   IMPACT
========================= */

.impact-grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 8px;

  margin-top: 16px;
}

.impact-grid strong {

  display: block;

  color:
    var(--gold);

  font-size: 22px;

  line-height: 1;
}

.impact-grid small {

  display: block;

  color:
    #85837d;

  font-size: 6px;

  margin-top: 5px;

  line-height: 1.3;
}


/* =========================
   CTA
========================= */

.info-cta {

  background:
    linear-gradient(
      135deg,
      #0b0b0b,
      #151208
    );
}

.info-cta h2 {

  max-width: 300px;

  font-size: 21px;
}

.cta-buttons {

  display: flex;

  gap: 7px;

  margin-top: 15px;
}

.cta-buttons .button {

  min-height: 31px;

  padding:
    0 10px;

  font-size: 7px;
}


/* =========================
   TESTIMONIALS
========================= */

.testimonials {

  padding:
    28px 24px;

  border-bottom:
    1px solid var(--border);
}

.review-button {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  background:
    transparent;

  border: 0;

  color:
    #d8d5cc;

  font-size: 7px;

  font-weight: 800;

  text-transform: uppercase;

  cursor: pointer;
}

.review-button span {

  color:
    var(--gold);

  font-size: 13px;
}

.review-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 8px;
}

.review-card {

  padding:
    16px;

  border:
    1px solid #222;

  background:
    #0c0c0c;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease;
}

.review-card:hover {

  transform:
    translateY(-2px);

  border-color:
    var(--gold-dark);
}

.stars {

  color:
    var(--gold);

  font-size: 10px;

  letter-spacing:
    2px;
}

.review-card p {

  color:
    #999;

  font-size: 8px;

  line-height: 1.65;

  margin:
    10px 0;
}

.review-card strong {

  color:
    #ddd;

  font-size: 7px;
}


/* =========================
   BLOG
========================= */

.blog {

  padding:
    28px 24px;

  border-bottom:
    1px solid var(--border);
}

.blog-card {

  min-height: 100px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  padding:
    18px 20px;

  border:
    1px solid #242424;

  background:
    linear-gradient(
      110deg,
      #0c0c0c,
      #121008
    );
}

.blog-card small {

  color:
    var(--gold);

  font-size: 6px;

  font-weight: 800;
}

.blog-card h3 {

  font-size: 16px;

  line-height: 1.2;

  margin:
    5px 0;
}

.blog-card p {

  max-width: 620px;

  color:
    #888;

  font-size: 8px;
}

.coming-soon {

  flex-shrink: 0;

  padding:
    8px 11px;

  border:
    1px solid var(--gold-dark);

  color:
    var(--gold);

  font-size: 7px;

  font-weight: 800;
}


/* =========================
   CONTACT
========================= */

.contact {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 30px;

  padding:
    32px 24px;

  border-bottom:
    1px solid var(--border);

  background:
    radial-gradient(
      circle at 80% 50%,
      rgba(210, 151, 30, 0.1),
      transparent 35%
    );
}

.contact-content h2 {

  font-size: 31px;

  line-height: 1;
}

.contact-content h2 span {

  color:
    var(--gold);
}

.contact-content > p:not(.info-label) {

  max-width: 450px;

  color:
    #999;

  font-size: 9px;

  margin:
    12px 0 15px;
}

.contact-options {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 7px;

  align-content: center;
}

.contact-options a {

  padding:
    13px;

  border:
    1px solid #242424;

  background:
    #0c0c0c;

  color:
    #ccc;

  font-size: 8px;

  font-weight: 700;

  transition:
    border-color 0.2s ease,
    transform 0.2s ease;
}

.contact-options a:hover {

  border-color:
    var(--gold-dark);

  transform:
    translateY(-2px);
}

.contact-options a span {

  color:
    var(--gold);

  margin-right:
    8px;
}


/* =========================
   FOOTER
========================= */

.footer {

  display: grid;

  grid-template-columns:
    1.5fr 1fr 1fr 1.3fr;

  gap: 25px;

  padding:
    26px 28px 12px;

  background:
    #070707;
}


/* footer logo */

.footer-brand img {

  width: 155px;

  margin-bottom: 6px;
}

.footer-brand p {

  color:
    #777;

  font-size: 7px;
}


/* footer columns */

.footer-column {

  min-width: 0;
}

.footer-column h4 {

  color:
    var(--gold);

  font-size: 8px;

  margin-bottom: 10px;
}

.footer-column > a {

  display: block;

  color:
    #85837d;

  font-size: 7px;

  margin:
    6px 0;

  transition:
    color 0.2s ease;
}

.footer-column > a:hover {

  color:
    var(--gold);
}

.footer-column > p {

  color:
    #777;

  font-size: 7px;
}


/* social */

.social-icons {

  display: flex;

  gap: 5px;
}

.social-icons a {

  width: 27px;

  height: 27px;

  display: flex;

  align-items: center;

  justify-content: center;

  border:
    1px solid #282828;

  color:
    #aaa;

  font-size: 6px;

  font-weight: 800;
}

.social-icons a:hover {

  color:
    var(--gold);

  border-color:
    var(--gold-dark);
}


/* bottom */

.footer-bottom {

  grid-column:
    1 / -1;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding-top:
    12px;

  margin-top:
    5px;

  border-top:
    1px solid #1e1e1e;

  color:
    #555;

  font-size: 6px;
}


/* =========================
   REVIEW MODAL
========================= */

.review-modal {

  position: fixed;

  inset: 0;

  z-index: 2000;

  display: none;

  align-items: center;

  justify-content: center;

  padding: 15px;

  background:
    rgba(0,0,0,0.82);

  backdrop-filter:
    blur(8px);
}

.review-modal.open {

  display: flex;
}

.review-modal-box {

  position: relative;

  width:
    min(430px, 100%);

  padding:
    25px;

  background:
    #0d0d0d;

  border:
    1px solid var(--gold-dark);
}

.review-modal-box h2 {

  font-size: 23px;

  margin-bottom:
    18px;
}

.review-modal-box h2 span {

  color:
    var(--gold);
}

.close-modal {

  position: absolute;

  top: 8px;
  right: 12px;

  background:
    transparent;

  border: 0;

  color:
    #aaa;

  font-size: 25px;

  cursor: pointer;
}

.review-modal-box label {

  display: block;

  color:
    #999;

  font-size: 8px;

  margin:
    11px 0;
}

.review-modal-box input,
.review-modal-box textarea {

  display: block;

  width: 100%;

  margin-top: 5px;

  padding:
    10px;

  background:
    #070707;

  border:
    1px solid #292929;

  color:
    #fff;

  outline: none;

  font-size: 9px;
}

.review-modal-box textarea {

  min-height: 90px;

  resize: vertical;
}

.rating {

  display: flex;

  gap: 3px;

  margin-top: 5px;
}

.rating button {

  padding: 0;

  background:
    transparent;

  border: 0;

  color:
    #414141;

  font-size: 22px;

  cursor: pointer;
}

.rating button.active {

  color:
    var(--gold);
}


/* =========================
   FLOATING BUTTONS
========================= */

.floating-whatsapp {

  position: fixed;

  right: 16px;

  bottom: 16px;

  z-index: 900;

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    var(--gold);

  color:
    #111;

  font-size: 7px;

  font-weight: 900;

  box-shadow:
    0 8px 25px rgba(0,0,0,0.5);

  transition:
    transform 0.2s ease;
}

.floating-whatsapp:hover {

  transform:
    scale(1.08);
}

.back-top {

  position: fixed;

  right: 16px;

  bottom: 67px;

  z-index: 900;

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background:
    #111;

  border:
    1px solid var(--gold-dark);

  color:
    var(--gold);

  cursor: pointer;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity 0.2s ease;
}

.back-top.show {

  opacity: 1;

  pointer-events: auto;
}


/* =========================
   ANIMATION
========================= */

.reveal {

  opacity: 0;

  transform:
    translateY(15px);

  transition:
    opacity 0.55s ease,
    transform 0.55s ease;
}

.reveal.visible {

  opacity: 1;

  transform:
    translateY(0);
}


/* =========================
   TABLET
========================= */

@media (max-width: 1050px) {

  .navigation {

    gap: 15px;

    font-size: 8px;
  }

  .services-area,
  .work-area {

    padding:
      22px 18px;
  }

  .information {

    grid-template-columns:
      1fr 1fr;
  }

  .info-block:nth-child(2) {

    border-right: 0;
  }

  .info-cta {

    border-top:
      1px solid var(--border);
  }

  .impact-block {

    border-top:
      1px solid var(--border);
  }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 760px) {

  /* Header */

  .header {

    height: 58px;

    padding:
      0 16px;
  }

  .logo img {

    width: 120px;
  }

  .menu-button {

    display: block;
  }

  .navigation {

    position: absolute;

    top: 58px;

    left: 0;
    right: 0;

    display: none;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding:
      8px 16px 14px;

    background:
      #090909;

    border-bottom:
      1px solid var(--gold-dark);
  }

  .navigation.open {

    display: flex;
  }

  .navigation > a {

    padding:
      11px 3px;

    font-size: 9px;
  }

  .navigation > a:not(.connect-button)::after {

    display: none;
  }

  .connect-button {

    justify-content: center;

    margin-top: 5px;
  }


  /* Hero */

  .hero {

    grid-template-columns: 1fr;

    min-height: auto;

    margin-top: 58px;

    padding:
      35px 18px 20px;

    gap: 12px;
  }

  .hero h1 {

    font-size:
      clamp(38px, 12vw, 55px);
  }

  .hero-content > p {

    font-size: 9px;
  }

  .hero-buttons {

    display: grid;

    grid-template-columns:
      1fr 1fr;
  }

  .hero-buttons .button {

    width: 100%;
  }

  .hero-visual {

    height: 170px;
  }

  .brand-display {

    width: 185px;

    padding: 11px;
  }

  .brand-display img {

    width: 145px;
  }

  .collage-card {

    width: 72px;

    height: 52px;
  }


  /* Services/work */

  .services-work {

    grid-template-columns: 1fr;
  }

  .services-area {

    border-right: 0;

    border-bottom:
      1px solid var(--border);
  }

  .services-list {

    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .service-item {

    min-height: 85px;
  }

  .work-list {

    grid-template-columns:
      repeat(5, minmax(0, 1fr));
  }

  .work-card {

    height: 110px;
  }


  /* Information */

  .information {

    grid-template-columns:
      1fr;
  }

  .info-block,
  .info-cta {

    border-right: 0;

    border-bottom:
      1px solid var(--border);
  }

  .impact-block {

    border-top: 0;
  }


  /* Testimonials */

  .review-grid {

    grid-template-columns:
      1fr;
  }


  /* Blog */

  .blog-card {

    flex-direction: column;

    align-items: flex-start;
  }


  /* Contact */

  .contact {

    grid-template-columns:
      1fr;
  }


  /* Footer */

  .footer {

    grid-template-columns:
      1fr 1fr;
  }

  .footer-bottom {

    flex-direction: column;

    align-items: flex-start;
  }
}


/* =========================
   SMALL MOBILE
========================= */

@media (max-width: 480px) {

  .hero {

    padding:
      30px 15px 18px;
  }

  .hero h1 {

    font-size:
      38px;
  }

  .hero-buttons {

    grid-template-columns:
      1fr;
  }

  .services-area,
  .work-area,
  .testimonials,
  .blog,
  .contact {

    padding-left: 15px;

    padding-right: 15px;
  }

  .section-heading {

    align-items:
      flex-start;

    flex-direction:
      column;

    gap: 8px;
  }

  .section-heading h2 {

    font-size: 20px;
  }

  .services-list {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .service-item:nth-child(4n) {

    border-right:
      1px solid #1d1d1d;
  }

  .service-item:nth-child(2n) {

    border-right: 0;
  }

  .service-item:nth-last-child(-n + 4) {

    border-bottom:
      1px solid #1d1d1d;
  }

  .service-item:nth-last-child(-n + 2) {

    border-bottom: 0;
  }

  .work-list {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .work-card {

    height: 125px;
  }

  .work-card:last-child {

    grid-column:
      1 / -1;
  }

  .portfolio-message {

    display: block;
  }

  .portfolio-message strong {

    display: block;

    margin-bottom: 5px;
  }

  .impact-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 18px;
  }

  .cta-buttons {

    display: grid;

    grid-template-columns:
      1fr;
  }

  .contact-options {

    grid-template-columns:
      1fr;
  }

  .footer {

    grid-template-columns:
      1fr;

    padding:
      25px 15px 12px;
  }
}


/* =========================
   REDUCED MOTION
========================= */

@media (prefers-reduced-motion: reduce) {

  html {

    scroll-behavior:
      auto;
  }

  .reveal {

    opacity: 1;

    transform:
      none;

    transition:
      none;
  }

  * {

    animation:
      none !important;

    transition:
      none !important;
  }
}
