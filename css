<!-- ==================================================
     REVIEW MODAL
================================================== -->

<div
  class="review-modal"
  id="reviewModal"
  aria-hidden="true"
>

  <div class="review-modal-box">

    <button
      class="close-modal"
      id="closeReview"
      type="button"
    >
      ×
    </button>

    <div class="eyebrow">
      YOUR EXPERIENCE
    </div>

    <h2>
      Write a
      <span>review.</span>
    </h2>

    <form id="reviewForm">

      <label>
        Your Name

        <input
          id="reviewName"
          type="text"
          maxlength="60"
          placeholder="Enter your name"
          required
        >
      </label>


      <label>
        Your Rating

        <div
          class="rating"
          id="rating"
        >

          <button type="button" data-rating="1">★</button>
          <button type="button" data-rating="2">★</button>
          <button type="button" data-rating="3">★</button>
          <button type="button" data-rating="4">★</button>
          <button type="button" data-rating="5">★</button>

        </div>

      </label>

      <input
        type="hidden"
        id="ratingValue"
        value="5"
      >


      <label>
        Your Review

        <textarea
          id="reviewText"
          maxlength="500"
          placeholder="Write your experience..."
          required
        ></textarea>

      </label>


      <button
        class="button button-gold"
        type="submit"
      >
        Post Review
        <span>→</span>
      </button>

    </form>

  </div>

</div>


