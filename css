* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #070707;
  --panel: #0d0d0d;
  --panel2: #111111;
  --text: #f5f3ed;
  --muted: #99978f;
  --gold: #d9a52e;
  --gold2: #f0c65d;
  --line: #242424;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Arial, sans-serif;
  overflow-x: hidden;
  line-height: 1.55;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  display: block;
  max-width: 100%;
}


/* HEADER */

.site-header {
  height: 72px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 34px;

  background: rgba(7, 7, 7, 0.92);

  border-bottom: 1px solid #1c1c1c;

  backdrop-filter: blur(15px);

  transition: 0.25s;
}

.site-header.scrolled {
  box-shadow: 0 12px 35px #0008;
}

.brand img {
  width: 158px;
}


/* NAV */

.nav {
  display: flex;
  align-items: center;
  gap: 27px;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;
}

.nav > a {
  color: #c9c6bd;
  transition: 0.2s;
}

.nav > a:hover {
  color: var(--gold);
}

.nav-cta {
  border: 1px solid #8c691f;
  padding: 10px 14px;

  color: var(--gold) !important;
}

.nav-cta span {
  margin-left: 7px;
}


/* MOBILE MENU */

.menu-toggle {
  display: none;

  background: none;
  border: 0;

  width: 38px;

  cursor: pointer;
}

.menu-toggle span {
  display: block;

  height: 2px;

  background: var(--gold);

  margin: 6px 0;
}


/* GENERAL */

.section {
  width: min(1180px, calc(100% - 48px));
  margin: auto;
}


/* HERO */

.hero {
  min-height: 650px;

  margin-top: 72px;

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 55px;

  align-items: center;

  padding-top: 60px;
  padding-bottom: 50px;
}

.eyebrow {
  color: var(--gold);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.16em;

  text-transform: uppercase;
}

.hero h1,
.section-top h2,
.about-copy h2,
.contact-copy h2 {

  font-size: clamp(43px, 5.3vw, 74px);

  line-height: 1.01;

  letter-spacing: -0.055em;

  margin: 14px 0 20px;

  max-width: 680px;
}

em {
  font-family: "Playfair Display", serif;

  color: var(--gold);

  font-style: normal;

  font-weight: 700;
}

.hero-text {
  max-width: 560px;

  color: var(--muted);

  font-size: 15px;

  line-height: 1.8;
}


/* BUTTONS */

.hero-actions {
  display: flex;

  gap: 12px;

  flex-wrap: wrap;

  margin-top: 27px;
}

.btn {

  min-height: 44px;

  padding: 0 19px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 11px;

  border: 1px solid #75591c;

  font-size: 11px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 0.03em;

  transition: 0.25s;
}

.btn-gold {
  background: var(--gold);

  color: #111;

  border-color: var(--gold);
}

.btn-gold:hover {
  background: var(--gold2);

  transform: translateY(-2px);
}

.btn-line {
  background: transparent;

  color: #eee;
}

.btn-line:hover {
  background: #17140e;

  border-color: var(--gold);

  color: var(--gold);

  transform: translateY(-2px);
}


/* HERO NOTE */

.hero-note {

  margin-top: 24px;

  color: #68665f;

  font-size: 10px;

  display: flex;

  align-items: center;

  gap: 9px;
}

.pulse {

  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: var(--gold);

  box-shadow: 0 0 15px var(--gold);
}


/* HERO VISUAL */

.hero-art {
  height: 450px;

  position: relative;
}

.hero-glow {

  position: absolute;

  width: 350px;

  height: 350px;

  border-radius: 50%;

  background: #b67e1720;

  filter: blur(65px);

  left: 30%;

  top: 15%;
}

.hero-frame {

  position: absolute;

  inset: 25px 10px;

  overflow: hidden;

  border: 1px solid #30291d;

  background: #0c0c0c;

  box-shadow: 0 30px 80px #000;
}

.hero-image {

  position: absolute;

  background-size: cover;

  background-position: center;
}

.hero-image-main {

  inset: 0 0 0 28%;

  background-image:
    linear-gradient(90deg, #0008, #0002),
    url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1000&q=85");
}

.hero-image-small {

  width: 44%;

  height: 43%;

  left: 0;

  top: 11%;

  background-image:
    linear-gradient(#0004, #0004),
    url("https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=700&q=85");

  border-right: 1px solid #333;

  border-bottom: 1px solid #333;
}

.hero-center {

  position: absolute;

  left: 8%;

  bottom: 12%;

  width: 55%;

  padding: 20px;

  background: #080808df;

  border: 1px solid #4d3b1a;

  text-align: center;
}

.hero-center img {

  width: min(245px, 90%);

  margin: auto;
}

.hero-center span {

  display: block;

  color: #aaa;

  font-size: 8px;

  letter-spacing: 0.2em;

  margin-top: 7px;
}

.hero-tag {

  position: absolute;

  color: var(--gold);

  border: 1px solid #795b1c;

  background: #080808dd;

  padding: 7px 10px;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.12em;
}

.tag-one {
  top: 7%;
  right: 5%;
}

.tag-two {
  bottom: 7%;
  right: 5%;
}


/* INTRO */

.intro-strip {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  border-top: 1px solid var(--line);

  border-bottom: 1px solid var(--line);
}

.intro-item {

  padding: 25px 30px;

  border-right: 1px solid var(--line);
}

.intro-item:last-child {
  border: 0;
}

.intro-item span {

  color: var(--gold);

  font-size: 10px;
}

.intro-item strong {

  display: block;

  font-size: 19px;

  margin: 5px 0;
}

.intro-item p {

  color: var(--muted);

  font-size: 11px;
}


/* SECTION SPACING */

.services,
.why,
.work,
.testimonials,
.blog,
.contact {

  padding-top: 95px;

  padding-bottom: 95px;
}


/* SECTION TOP */

.section-top {

  display: flex;

  align-items: end;

  justify-content: space-between;

  gap: 30px;

  margin-bottom: 35px;
}

.section-top h2 {

  font-size: 43px;

  margin: 10px 0 0;
}

.section-description {

  max-width: 410px;

  color: var(--muted);

  font-size: 12px;
}


/* SERVICES */

.service-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 12px;
}

.service-card {

  min-height: 210px;

  padding: 25px;

  background:
    linear-gradient(
      145deg,
      #111,
      #0b0b0b
    );

  border: 1px solid #202020;

  position: relative;

  overflow: hidden;

  transition: 0.3s;
}

.service-card:hover {

  border-color: #73571c;

  transform: translateY(-5px);
}

.service-number {

  position: absolute;

  right: 17px;

  top: 15px;

  color: #555;

  font-size: 9px;
}

.service-icon {

  font-size: 34px;

  color: var(--gold);

  margin-bottom: 20px;
}

.service-card h3 {

  font-size: 17px;

  max-width: 230px;
}

.service-card p {

  color: var(--muted);

  font-size: 11px;

  margin-top: 10px;

  max-width: 270px;
}


/* ABOUT */

.about {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 70px;

  align-items: center;

  border-top: 1px solid var(--line);
}

.about-visual {

  position: relative;

  height: 430px;
}

.photo-card {

  height: 100%;

  width: 82%;

  margin-left: auto;

  background:
    linear-gradient(120deg, #0003, #0005),
    url("https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1000&q=85")
    center/cover;

  border: 1px solid #292929;
}

.photo-caption {

  position: absolute;

  left: 0;

  bottom: 35px;

  background: #090909ef;

  border: 1px solid #4e3c1b;

  padding: 17px 20px;
}

.photo-caption strong {

  display: block;

  color: var(--gold);

  font-size: 10px;
}

.photo-caption span {

  font-size: 9px;

  color: #999;
}

.about-copy p:not(.eyebrow) {

  color: var(--muted);

  font-size: 13px;

  line-height: 1.8;

  margin: 15px 0;
}

.text-link {

  display: inline-flex;

  gap: 10px;

  color: var(--gold);

  font-size: 11px;

  font-weight: 800;

  text-transform: uppercase;

  margin-top: 10px;
}


/* WHY */

.why {

  border-top: 1px solid var(--line);
}

.why-grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 10px;
}

.why-card {

  padding: 25px;

  border: 1px solid #202020;

  background: #0b0b0b;
}

.why-card b {

  color: var(--gold);

  font-size: 11px;
}

.why-card h3 {

  font-size: 16px;

  margin: 22px 0 10px;
}

.why-card p {

  color: var(--muted);

  font-size: 11px;
}


/* WORK */

.work {

  border-top: 1px solid var(--line);
}

.status-pill {

  border: 1px solid #70551b;

  color: var(--gold);

  padding: 8px 11px;

  font-size: 9px;

  font-weight: 800;

  white-space: nowrap;
}

.work-placeholder {

  min-height: 270px;

  border: 1px dashed #3a301f;

  background:
    radial-gradient(
      circle at 80% 30%,
      #b17b1714,
      transparent 30%
    ),
    #0b0b0b;

  display: flex;

  align-items: center;

  gap: 35px;

  padding: 45px;
}

.placeholder-mark,
.blog-orb {

  width: 85px;

  height: 85px;

  flex: none;

  display: grid;

  place-items: center;

  border: 1px solid #806221;

  color: var(--gold);

  font-weight: 800;

  font-size: 22px;
}

.work-placeholder h3 {

  font-size: 25px;
}

.work-placeholder p {

  color: var(--muted);

  font-size: 12px;

  max-width: 600px;

  margin: 8px 0 18px;
}


/* TESTIMONIALS */

.testimonials {

  border-top: 1px solid var(--line);
}

.review-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 12px;
}

.review-card {

  padding: 25px;

  background: #0c0c0c;

  border: 1px solid #222;
}

.stars {

  color: var(--gold);

  letter-spacing: 3px;
}

.review-card p {

  color: #aaa;

  font-size: 12px;

  line-height: 1.75;

  margin: 17px 0;
}

.review-card strong {

  font-size: 10px;
}


/* BLOG */

.blog {

  border-top: 1px solid var(--line);
}

.blog-card {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  padding: 35px;

  background:
    linear-gradient(
      110deg,
      #0b0b0b,
      #151108
    );

  border: 1px solid #252525;
}

.blog-label {

  color: var(--gold);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: 0.12em;
}

.blog-card h3 {

  font-size: 25px;

  margin: 8px 0;
}

.blog-card p {

  color: var(--muted);

  font-size: 12px;
}


/* CONTACT */

.contact {

  border-top: 1px solid var(--line);

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 70px;
}

.contact-copy h2 {

  font-size: 49px;
}

.contact-copy > p:not(.eyebrow) {

  color: var(--muted);

  font-size: 13px;

  max-width: 540px;

  margin: 18px 0 22px;
}

.contact-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 10px;

  align-content: center;
}

.contact-grid a {

  padding: 22px;

  border: 1px solid #232323;

  background: #0b0b0b;

  transition: 0.25s;
}

.contact-grid a:hover {

  border-color: #76591c;

  transform: translateY(-3px);
}

.contact-grid span {

  color: var(--gold);

  font-size: 10px;

  font-weight: 800;
}

.contact-grid strong {

  display: block;

  font-size: 13px;

  margin-top: 8px;
}

.contact-grid small {

  color: #777;

  font-size: 9px;
}


/* FOOTER */

.footer {

  border-top: 1px solid var(--line);

  padding: 50px 34px 20px;

  background: #050505;
}

.footer-main {

  width: min(1180px, 100%);

  margin: auto;

  display: grid;

  grid-template-columns:
    1.4fr 1fr 1fr 1.2fr;

  gap: 40px;
}

.footer-brand img {

  width: 175px;
}

.footer-brand p {

  color: #777;

  font-size: 10px;

  margin-top: 10px;
}

.footer h4 {

  color: var(--gold);

  font-size: 10px;

  margin-bottom: 15px;
}

.footer-main > div > a {

  display: block;

  color: #85837d;

  font-size: 10px;

  margin: 8px 0;
}

.footer-main > div > a:hover {

  color: var(--gold);
}

.footer-social {

  display: flex;

  gap: 7px;

  margin-top: 15px;
}

.footer-social a {

  width: 29px !important;

  height: 29px !important;

  display: grid !important;

  place-items: center;

  border: 1px solid #282828;
}

.footer-bottom {

  width: min(1180px, 100%);

  margin: 35px auto 0;

  padding-top: 15px;

  border-top: 1px solid #191919;

  display: flex;

  justify-content: space-between;

  gap: 20px;

  color: #555;

  font-size: 8px;
}


/* REVIEW MODAL */

.modal {

  position: fixed;

  inset: 0;

  z-index: 2000;

  background: #000c;

  backdrop-filter: blur(8px);

  display: none;

  align-items: center;

  justify-content: center;

  padding: 20px;
}

.modal.open {

  display: flex;
}

.modal-box {

  position: relative;

  width: min(480px, 100%);

  background: #0d0d0d;

  border: 1px solid #775a1d;

  padding: 32px;
}

.modal-box h2 {

  font-size: 32px;

  margin: 8px 0 20px;
}

.modal-close {

  position: absolute;

  top: 8px;

  right: 13px;

  background: none;

  border: 0;

  color: #aaa;

  font-size: 28px;

  cursor: pointer;
}

.modal label {

  display: block;

  color: #999;

  font-size: 10px;

  margin: 13px 0;
}

.modal input,
.modal textarea {

  width: 100%;

  margin-top: 6px;

  background: #080808;

  color: #fff;

  border: 1px solid #292929;

  padding: 11px;

  outline: none;
}

.modal textarea {

  min-height: 100px;

  resize: vertical;
}

.rating {

  display: flex;

  gap: 3px;
}

.rating button {

  background: none;

  border: 0;

  color: #444;

  font-size: 25px;

  cursor: pointer;
}

.rating button.active {

  color: var(--gold);
}


/* FLOATING BUTTONS */

.floating-wa,
.back-top {

  position: fixed;

  z-index: 900;

  width: 45px;

  height: 45px;

  border-radius: 50%;

  display: grid;

  place-items: center;
}

.floating-wa {

  right: 18px;

  bottom: 18px;

  background: var(--gold);

  color: #111;

  font-size: 8px;

  font-weight: 900;

  box-shadow: 0 8px 30px #000;
}

.back-top {

  right: 18px;

  bottom: 72px;

  background: #101010;

  color: var(--gold);

  border: 1px solid #72561c;

  opacity: 0;

  pointer-events: none;

  cursor: pointer;
}

.back-top.show {

  opacity: 1;

  pointer-events: auto;
}


/* ANIMATION */

.reveal {

  opacity: 0;

  transform: translateY(20px);

  transition:
    opacity .6s ease,
    transform .6s ease;
}

.reveal.visible {

  opacity: 1;

  transform: none;
}


/* TABLET */

@media (max-width: 1000px) {

  .nav {

    gap: 16px;

    font-size: 9px;
  }

  .hero {

    gap: 25px;
  }

  .service-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

  .why-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

  .footer-main {

    grid-template-columns:
      repeat(2, 1fr);
  }
}


/* MOBILE */

@media (max-width: 760px) {

  .section {

    width:
      min(100% - 30px, 600px);
  }

  .site-header {

    height: 62px;

    padding:
      0 15px;
  }

  .brand img {

    width: 135px;
  }

  .menu-toggle {

    display: block;
  }

  .nav {

    position: absolute;

    top: 62px;

    left: 0;

    right: 0;

    display: none;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding:
      8px 15px 16px;

    background: #080808;

    border-bottom:
      1px solid #75591d;
  }

  .nav.open {

    display: flex;
  }

  .nav > a {

    padding:
      12px 2px;

    font-size: 10px;
  }

  .nav-cta {

    text-align: center;
  }


  /* HERO */

  .hero {

    margin-top: 62px;

    min-height: auto;

    grid-template-columns: 1fr;

    padding-top: 55px;

    padding-bottom: 55px;
  }

  .hero h1 {

    font-size: 48px;
  }

  .hero-art {

    height: 310px;
  }

  .hero-frame {

    inset: 10px 0;
  }

  .hero-center {

    left: 7%;

    bottom: 9%;

    width: 58%;
  }


  /* INTRO */

  .intro-strip {

    grid-template-columns: 1fr;
  }

  .intro-item {

    border-right: 0;

    border-bottom:
      1px solid var(--line);
  }

  .intro-item:last-child {

    border-bottom: 0;
  }


  /* SECTIONS */

  .services,
  .why,
  .work,
  .testimonials,
  .blog,
  .contact {

    padding-top: 65px;

    padding-bottom: 65px;
  }

  .section-top {

    display: block;
  }

  .section-top h2 {

    font-size: 38px;

    margin-bottom: 15px;
  }


  /* SERVICES */

  .service-grid {

    grid-template-columns: 1fr;
  }


  /* ABOUT */

  .about {

    grid-template-columns: 1fr;

    gap: 35px;
  }

  .about-visual {

    height: 310px;
  }

  .photo-card {

    width: 88%;
  }


  /* WHY */

  .why-grid {

    grid-template-columns: 1fr;
  }


  /* WORK */

  .work-placeholder {

    display: block;

    padding: 30px;
  }

  .placeholder-mark {

    margin-bottom: 20px;
  }


  /* REVIEWS */

  .review-grid {

    grid-template-columns: 1fr;
  }


  /* BLOG */

  .blog-card {

    display: block;
  }

  .blog-orb {

    margin-top: 25px;
  }


  /* CONTACT */

  .contact {

    grid-template-columns: 1fr;

    gap: 35px;
  }

  .contact-copy h2 {

    font-size: 42px;
  }


  /* FOOTER */

  .footer {

    padding:
      38px 15px 18px;
  }

  .footer-main {

    grid-template-columns:
      1fr 1fr;

    gap: 28px;
  }

  .footer-bottom {

    display: block;
  }

  .footer-bottom span {

    display: block;

    margin: 5px 0;
  }

  .floating-wa {

    right: 14px;

    bottom: 14px;
  }

}


/* SMALL MOBILE */

@media (max-width: 480px) {

  .hero h1 {

    font-size: 40px;
  }

  .hero-text {

    font-size: 13px;
  }

  .hero-actions {

    display: grid;

    grid-template-columns: 1fr;
  }

  .hero-actions .btn {

    width: 100%;
  }

  .hero-art {

    height: 265px;
  }

  .hero-image-main {

    left: 20%;
  }

  .hero-center {

    width: 70%;

    padding: 13px;
  }

  .hero-tag {

    font-size: 7px;
  }

  .contact-grid {

    grid-template-columns: 1fr;
  }

  .footer-main {

    grid-template-columns: 1fr;
  }

  .footer-brand img {

    width: 155px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  html {

    scroll-behavior: auto;
  }

  .reveal {

    opacity: 1;

    transform: none;

    transition: none;
  }

  * {

    transition: none !important;
  }
}
