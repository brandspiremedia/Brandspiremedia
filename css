/* =========================================================
   BRANDSPIRE MEDIA
   PREMIUM RESPONSIVE WEBSITE
========================================================= */

:root {
    --black: #050505;
    --black-soft: #0b0b0b;
    --black-card: #111111;
    --gold: #d8b35a;
    --gold-light: #f0d58b;
    --white: #ffffff;
    --text: #eeeeee;
    --muted: #a7a7a7;
    --border: rgba(216, 179, 90, 0.25);

    --container: 1180px;
    --header-height: 82px;

    --transition: 0.35s ease;
}


/* ================= RESET ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    scroll-padding-top: 90px;
}

body {
    background: var(--black);
    color: var(--white);
    font-family:
        Arial,
        Helvetica,
        sans-serif;
    overflow-x: hidden;
    line-height: 1.6;
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

::selection {
    background: var(--gold);
    color: #000;
}


/* ================= COMMON ================= */

.container {
    width: min(var(--container), calc(100% - 40px));
    margin: 0 auto;
}

.section {
    padding: 110px 0;
}

.eyebrow {
    color: var(--gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 18px;
}

.section-heading {
    max-width: 720px;
    margin-bottom: 55px;
}

.section-heading.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
}

.section-heading h2 {
    font-size: clamp(36px, 5vw, 62px);
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 22px;
}

.section-heading h2 span,
.about-content h2 span,
.contact-content h2 span {
    color: var(--gold);
}

.section-heading p:not(.eyebrow) {
    color: var(--muted);
    font-size: 17px;
    max-width: 650px;
}

.btn {
    min-height: 50px;
    padding: 14px 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition:
        transform var(--transition),
        background var(--transition),
        color var(--transition),
        border-color var(--transition),
        box-shadow var(--transition);
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-gold {
    background: var(--gold);
    color: #050505;
    border: 1px solid var(--gold);
}

.btn-gold:hover {
    background: var(--gold-light);
    box-shadow: 0 12px 35px rgba(216, 179, 90, 0.2);
}

.btn-outline {
    border: 1px solid rgba(255,255,255,0.35);
    color: var(--white);
    background: transparent;
}

.btn-outline:hover {
    border-color: var(--gold);
    color: var(--gold);
}

.text-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--gold);
    font-weight: 700;
}

.full-btn {
    width: 100%;
}


/* ================= HEADER ================= */

.header {
    height: var(--header-height);
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    background: rgba(5,5,5,0.75);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;

    transition:
        background var(--transition),
        border-color var(--transition),
        box-shadow var(--transition);
}

.header.scrolled {
    background: rgba(5,5,5,0.96);
    border-bottom-color: var(--border);
    box-shadow: 0 10px 35px rgba(0,0,0,0.25);
}

.nav-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    width: 180px;
    flex-shrink: 0;
}

.logo img {
    width: 100%;
    height: auto;
    object-fit: contain;
}

.nav {
    display: flex;
    align-items: center;
    gap: 27px;
}

.nav > a {
    color: #ddd;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--transition);
}

.nav > a:hover {
    color: var(--gold);
}

.nav-connect {
    border: 1px solid var(--gold);
    color: var(--gold) !important;
    padding: 10px 16px;
}

.nav-connect:hover {
    background: var(--gold);
    color: #000 !important;
}

.menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    padding: 9px;
}

.menu-btn span {
    display: block;
    width: 100%;
    height: 2px;
    background: white;
    margin: 5px 0;
    transition: var(--transition);
}


/* ================= HERO ================= */

.hero {
    min-height: 100vh;
    padding-top: calc(var(--header-height) + 70px);
    padding-bottom: 80px;

    display: flex;
    align-items: center;

    position: relative;
    overflow: hidden;
}

.hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 80px;
    align-items: center;
}

.hero-content {
    position: relative;
    z-index: 2;
}

.hero-content h1 {
    max-width: 760px;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -4px;
    margin-bottom: 28px;
}

.hero-content h1 span {
    display: block;
    color: var(--gold);
}

.hero-text {
    max-width: 620px;
    color: var(--muted);
    font-size: 18px;
    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

.hero-visual {
    min-width: 0;
}

.visual-frame {
    min-height: 580px;
    position: relative;
}

.visual-main {
    width: 78%;
    height: 500px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 3px;
    border: 1px solid var(--border);
    position: relative;
}

.visual-main::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            135deg,
            rgba(216,179,90,0.15),
            transparent 45%
        );
}

.visual-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
}

.visual-frame:hover .visual-main img {
    transform: scale(1.04);
}

.visual-logo {
    position: absolute;
    left: 0;
    bottom: 55px;

    width: 210px;
    height: 210px;

    display: grid;
    place-items: center;

    background: rgba(5,5,5,0.9);
    border: 1px solid var(--gold);
    padding: 30px;
}

.visual-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.visual-card {
    position: absolute;
    background: #0a0a0a;
    border: 1px solid var(--border);
    padding: 18px 20px;
    min-width: 165px;
}

.visual-card strong {
    display: block;
    color: var(--gold);
    font-size: 16px;
    letter-spacing: 2px;
}

.visual-card span {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
}

.visual-card-one {
    top: 55px;
    left: 0;
}

.visual-card-two {
    right: 0;
    bottom: 0;
}

.hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    opacity: 0.08;
}

.glow-one {
    top: 0;
    left: -250px;
    background: var(--gold);
}

.glow-two {
    bottom: -300px;
    right: -200px;
    background: var(--gold);
}


/* ================= SERVICES ================= */

.services-section {
    background: #090909;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.service-card {
    background: var(--black-card);
    border: 1px solid rgba(255,255,255,0.08);
    overflow: hidden;

    transition:
        transform var(--transition),
        border-color var(--transition),
        box-shadow var(--transition);
}

.service-card:hover {
    transform: translateY(-8px);
    border-color: var(--border);
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
}

.service-image {
    height: 220px;
    overflow: hidden;
}

.service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
}

.service-card:hover .service-image img {
    transform: scale(1.07);
}

.service-content {
    padding: 28px;
}

.service-number {
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 2px;
}

.service-content h3 {
    margin: 10px 0 13px;
    font-size: 21px;
}

.service-content p {
    color: var(--muted);
    font-size: 14px;
}


/* ================= ABOUT ================= */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.about-image {
    position: relative;
}

.about-image img {
    width: 100%;
    height: 580px;
    object-fit: cover;
}

.image-label {
    position: absolute;
    left: 25px;
    bottom: 25px;

    padding: 18px 22px;
    background: rgba(5,5,5,0.92);
    border-left: 2px solid var(--gold);
}

.image-label strong {
    display: block;
    color: var(--gold);
    letter-spacing: 2px;
}

.image-label span {
    color: #ccc;
    font-size: 12px;
}

.about-content h2 {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.04;
    letter-spacing: -2px;
    margin-bottom: 28px;
}

.about-content > p {
    color: var(--muted);
    margin-bottom: 18px;
    max-width: 550px;
}


/* ================= WHY ================= */

.why-section {
    background: #090909;
}

.why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.why-image {
    overflow: hidden;
}

.why-image img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    transition: transform 0.8s ease;
}

.why-image:hover img {
    transform: scale(1.04);
}

.why-list {
    display: grid;
    gap: 25px;
}

.why-item {
    display: grid;
    grid-template-columns: 58px 1fr;
    gap: 18px;
    padding-bottom: 25px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.why-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 12px;
}

.why-item h3 {
    margin-bottom: 7px;
}

.why-item p {
    color: var(--muted);
    font-size: 14px;
}


/* ================= WORK ================= */

.work-placeholder {
    min-height: 400px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 50px;
    background:
        linear-gradient(
            135deg,
            rgba(216,179,90,0.06),
            transparent
        );

    border: 1px dashed rgba(216,179,90,0.35);
}

.work-placeholder-icon {
    width: 70px;
    height: 70px;

    display: grid;
    place-items: center;

    border: 1px solid var(--gold);
    color: var(--gold);

    font-size: 28px;

    margin-bottom: 25px;
}

.work-placeholder h3 {
    font-size: 30px;
    margin-bottom: 12px;
}

.work-placeholder p {
    color: var(--muted);
    max-width: 600px;
    margin-bottom: 28px;
}


/* ================= TESTIMONIALS ================= */

.testimonials-section {
    background: #090909;
}

.review-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 45px;
}

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.review-card {
    background: var(--black-card);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 30px;
}

.stars {
    color: var(--gold);
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.review-card > p {
    color: #d0d0d0;
    font-size: 15px;
    margin-bottom: 25px;
}

.review-author {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 18px;
}

.review-author strong {
    display: block;
}

.review-author span {
    display: block;
    color: var(--muted);
    font-size: 12px;
    margin-top: 3px;
}


/* ================= CONTACT ================= */

.contact-box {
    padding: 70px;

    border: 1px solid var(--border);

    background:
        radial-gradient(
            circle at 80% 30%,
            rgba(216,179,90,0.09),
            transparent 35%
        ),
        #0a0a0a;
}

.contact-content {
    max-width: 780px;
}

.contact-content h2 {
    font-size: clamp(40px, 6vw, 70px);
    line-height: 1;
    letter-spacing: -3px;
    margin-bottom: 25px;
}

.contact-content > p:not(.eyebrow) {
    color: var(--muted);
    max-width: 620px;
    margin-bottom: 30px;
}

.contact-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-top: 20px;
}

.contact-link {
    padding: 25px;
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.08);

    transition:
        transform var(--transition),
        border-color var(--transition);
}

.contact-link:hover {
    transform: translateY(-5px);
    border-color: var(--border);
}

.contact-icon {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 15px;
}

.contact-link strong {
    display: block;
    margin-bottom: 4px;
}

.contact-link small {
    display: block;
    color: var(--muted);
    font-size: 11px;
    overflow-wrap: anywhere;
}


/* ================= FOOTER ================= */

.footer {
    background: #030303;
    padding-top: 75px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 50px;
    padding-bottom: 60px;
}

.footer-brand img {
    width: 190px;
    margin-bottom: 20px;
}

.footer-brand p {
    color: var(--muted);
    max-width: 320px;
    font-size: 14px;
}

.footer-column {
    display: flex;
    flex-direction: column;
    gap: 11px;
}

.footer-column h4 {
    color: var(--gold);
    margin-bottom: 10px;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.footer-column a {
    color: var(--muted);
    font-size: 13px;
    transition: color var(--transition);
}

.footer-column a:hover {
    color: var(--gold);
}

.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 22px 20px;

    display: flex;
    justify-content: space-between;
    gap: 20px;

    color: #777;
    font-size: 11px;
    text-align: center;
}

.footer-bottom strong {
    color: var(--gold);
}


/* ================= REVIEW MODAL ================= */

.modal {
    position: fixed;
    inset: 0;
    z-index: 2000;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(8px);
}

.modal.active {
    display: flex;
}

.modal-box {
    width: min(500px, 100%);
    max-height: 90vh;
    overflow-y: auto;

    background: #101010;
    border: 1px solid var(--border);

    padding: 35px;

    position: relative;
}

.modal-box h2 {
    font-size: 35px;
    margin-bottom: 25px;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 15px;

    width: 40px;
    height: 40px;

    background: transparent;
    border: 0;

    color: white;
    font-size: 30px;
}

.modal-close:hover {
    color: var(--gold);
}

#reviewForm label {
    display: block;
    color: #ddd;
    font-size: 13px;
    margin-bottom: 18px;
}

#reviewForm input,
#reviewForm textarea {
    display: block;
    width: 100%;

    margin-top: 8px;
    padding: 13px 14px;

    background: #070707;
    border: 1px solid rgba(255,255,255,0.12);
    color: white;

    outline: none;
}

#reviewForm input:focus,
#reviewForm textarea:focus {
    border-color: var(--gold);
}

#reviewForm textarea {
    resize: vertical;
}

.rating-input {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
}

.rating-input button {
    background: transparent;
    border: 0;
    color: #555;
    font-size: 28px;
    padding: 0;
}

.rating-input button.active {
    color: var(--gold);
}


/* ================= FLOATING BUTTONS ================= */

.whatsapp-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;

    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #25D366;
    color: white;

    font-size: 11px;
    font-weight: 800;

    box-shadow: 0 10px 30px rgba(0,0,0,0.4);

    transition: transform var(--transition);
}

.whatsapp-float:hover {
    transform: scale(1.08);
}

.back-top {
    position: fixed;
    right: 24px;
    bottom: 92px;
    z-index: 900;

    width: 45px;
    height: 45px;

    background: #111;
    border: 1px solid var(--gold);

    color: var(--gold);

    display: grid;
    place-items: center;

    opacity: 0;
    visibility: hidden;

    transition: var(--transition);
}

.back-top.show {
    opacity: 1;
    visibility: visible;
}


/* ================= REVEAL ANIMATION ================= */

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
        opacity 0.8s ease,
        transform 0.8s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}


/* ================= TABLET ================= */

@media (max-width: 1000px) {

    .nav {
        gap: 17px;
    }

    .nav > a {
        font-size: 12px;
    }

    .logo {
        width: 150px;
    }

    .hero-grid {
        gap: 45px;
    }

    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .contact-links {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* ================= MOBILE ================= */

@media (max-width: 780px) {

    :root {
        --header-height: 72px;
    }

    .container {
        width: min(100% - 30px, var(--container));
    }

    .section {
        padding: 80px 0;
    }


    /* HEADER */

    .logo {
        width: 145px;
    }

    .menu-btn {
        display: block;
    }

    .nav {
        position: fixed;
        top: var(--header-height);
        left: 15px;
        right: 15px;

        display: flex;
        flex-direction: column;
        align-items: stretch;

        gap: 0;

        padding: 10px;

        background: rgba(10,10,10,0.98);
        border: 1px solid var(--border);

        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);

        transition: var(--transition);
    }

    .nav.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .nav > a {
        padding: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 14px;
    }

    .nav > a:last-child {
        border-bottom: 0;
    }

    .nav-connect {
        text-align: center;
        margin-top: 8px;
    }


    /* HERO */

    .hero {
        padding-top: 125px;
        padding-bottom: 60px;
    }

    .hero-grid {
        grid-template-columns: 1fr;
        gap: 55px;
    }

    .hero-content h1 {
        font-size: clamp(44px, 13vw, 65px);
        letter-spacing: -3px;
    }

    .hero-text {
        font-size: 16px;
    }

    .hero-buttons {
        width: 100%;
    }

    .hero-buttons .btn {
        flex: 1;
        min-width: 140px;
    }

    .visual-frame {
        min-height: 430px;
    }

    .visual-main {
        width: 82%;
        height: 380px;
    }

    .visual-logo {
        width: 150px;
        height: 150px;
        padding: 20px;
        bottom: 35px;
    }

    .visual-card {
        min-width: 130px;
        padding: 13px;
    }

    .visual-card-one {
        top: 25px;
    }

    .visual-card-two {
        bottom: 0;
    }


    /* SERVICES */

    .services-grid {
        grid-template-columns: 1fr;
    }

    .service-image {
        height: 230px;
    }


    /* ABOUT */

    .about-grid,
    .why-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .about-image img {
        height: 430px;
    }

    .why-image img {
        height: 380px;
    }


    /* REVIEWS */

    .reviews-grid {
        grid-template-columns: 1fr;
    }


    /* CONTACT */

    .contact-box {
        padding: 40px 25px;
    }

    .contact-content h2 {
        letter-spacing: -2px;
    }

    .contact-links {
        grid-template-columns: 1fr 1fr;
    }


    /* FOOTER */

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .footer-bottom {
        flex-direction: column;
    }


    /* FLOATING */

    .whatsapp-float {
        right: 15px;
        bottom: 15px;
    }

    .back-top {
        right: 15px;
        bottom: 82px;
    }

}


/* ================= SMALL MOBILE ================= */

@media (max-width: 480px) {

    .section-heading h2,
    .about-content h2 {
        letter-spacing: -1.5px;
    }

    .hero-content h1 {
        letter-spacing: -2px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .visual-main {
        width: 88%;
        height: 350px;
    }

    .visual-logo {
        width: 125px;
        height: 125px;
        padding: 15px;
    }

    .visual-card {
        min-width: 110px;
        padding: 10px;
    }

    .visual-card strong {
        font-size: 12px;
    }

    .visual-card span {
        font-size: 10px;
    }

    .contact-links {
        grid-template-columns: 1fr;
    }

    .work-placeholder {
        padding: 35px 20px;
    }

    .modal-box {
        padding: 28px 20px;
    }

}


/* ================= REDUCED MOTION ================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }

}
