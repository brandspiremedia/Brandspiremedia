* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #050505;
  --panel: #0b0b0b;
  --panel2: #101010;

  --gold: #d8ad4d;
  --gold2: #f0cd78;

  --white: #ffffff;
  --text: #e9e9e9;
  --muted: #969696;

  --line: rgba(255, 255, 255, 0.1);

  --max: 1200px;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
  overflow-x: hidden;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  overflow-x: hidden;
}

body.modal-open {
  overflow: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}


/* ================= COMMON ================= */

.container {
  width: min(
    var(--max),
    calc(100% - 48px)
  );

  margin: auto;
}

.kicker {
  font-size: 11px;
  letter-spacing: 2.6px;
  color: var(--gold2);
  font-weight: 700;
  margin-bottom: 12px;
}

.section {
  padding: 105px 0;
}

h1,
h2,
h3 {
  line-height: 1.08;
}

h1 {
  font-size: clamp(
    48px,
    6.7vw,
    82px
  );

  letter-spacing: -3px;
}

h2 {
  font-size: clamp(
    36px,
    4.8vw,
    58px
  );

  letter-spacing: -2px;
}

h1 span,
h2 span {
  color: var(--gold2);
}

.lead {
  color: #bdbdbd;
  max-width: 590px;
  font-size: 17px;
  margin: 24px 0 30px;
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.btn {
  min-height: 48px;

  padding: 13px 20px;

  border: 1px solid var(--gold);

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.8px;

  text-transform: uppercase;

  transition: 0.3s;
}

.btn.gold {
  background: var(--gold);
  color: #080808;
}

.btn.gold:hover {
  background: var(--gold2);
  transform: translateY(-2px);
}

.btn.ghost {
  border-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  background: transparent;
}

.btn.ghost:hover {
  border-color: var(--gold);
  color: var(--gold2);
  transform: translateY(-2px);
}

.small-link {
  font-size: 12px;
  color: var(--gold2);
  white-space: nowrap;
}


/* ================= HEADER ================= */

.site-header {
  position: fixed;

  z-index: 1000;

  top: 0;
  left: 0;

  width: 100%;
  height: 82px;

  background: rgba(5, 5, 5, 0.7);

  backdrop-filter: blur(16px);

  border-bottom: 1px solid transparent;

  transition: 0.3s;
}

.site-header.scrolled {
  background: rgba(5, 5, 5, 0.96);

  border-bottom-color: var(--line);
}

.nav-wrap {
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;
}

.brand {
  display: flex;
  align-items: center;

  gap: 10px;

  min-width: 0;
}

.brand img {
  width: 43px;
  height: 43px;

  object-fit: contain;
}

.brand span {
  font-size: 13px;
  font-weight: 700;

  letter-spacing: 2.2px;

  white-space: nowrap;
}

.brand small {
  display: block;

  color: var(--gold2);

  font-size: 7px;

  letter-spacing: 4px;

  text-align: center;

  margin-top: 2px;
}

.nav {
  display: flex;
  align-items: center;

  gap: 25px;
}

.nav > a {
  font-size: 12px;

  color: #d0d0d0;

  transition: 0.25s;

  white-space: nowrap;
}

.nav > a:hover,
.nav > a.active {
  color: var(--gold2);
}

.nav-cta {
  border: 1px solid var(--gold);

  padding: 10px 14px;

  color: var(--gold2) !important;
}

.nav-cta:hover {
  background: var(--gold);

  color: #000 !important;
}

.menu-toggle {
  display: none;

  background: transparent;

  border: 1px solid var(--line);

  width: 42px;
  height: 42px;

  padding: 9px;
}

.menu-toggle span {
  display: block;

  height: 2px;

  background: #fff;

  margin: 5px 0;

  transition: 0.3s;
}


/* ================= HERO ================= */

.hero {
  min-height: 100vh;

  padding: 130px 0 75px;

  position: relative;

  overflow: hidden;
}

.hero-bg {
  position: absolute;

  inset: 0;

  background:
    radial-gradient(
      circle at 85% 30%,
      rgba(216, 173, 77, 0.09),
      transparent 34%
    ),
    linear-gradient(
      90deg,
      #050505 35%,
      rgba(5, 5, 5, 0.55),
      #050505
    );
}

.hero-grid {
  position: relative;

  z-index: 1;

  min-height: calc(100vh - 205px);

  display: grid;

  grid-template-columns:
    1fr 1.05fr;

  align-items: center;

  gap: 55px;
}

.hero-copy {
  padding: 30px 0;
}

.trust {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-top: 30px;

  color: #8f8f8f;

  font-size: 11px;
}

.avatar-stack {
  display: flex;
}

.avatar-stack i {
  width: 28px;
  height: 28px;

  border-radius: 50%;

  border: 2px solid #111;

  background:
    linear-gradient(
      135deg,
      #b8b8b8,
      #333
    );

  margin-left: -7px;
}

.avatar-stack i:first-child {
  margin-left: 0;
}

.hero-art {
  height: 600px;

  position: relative;
}

.hero-photo {
  position: absolute;

  inset: 0 0 0 8%;

  overflow: hidden;

  border: 1px solid var(--line);
}

.hero-photo img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: brightness(0.7);
}

.hero-photo::after {
  content: "";

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      90deg,
      #050505 0%,
      transparent 45%
    ),
    linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.65),
      transparent 50%
    );
}

.hero-note {
  position: absolute;

  right: 30px;
  top: 55px;

  background: rgba(5, 5, 5, 0.78);

  border-left: 2px solid var(--gold);

  padding: 15px 18px;

  font-size: 15px;

  letter-spacing: 2px;

  line-height: 1.2;
}

.hero-note strong {
  color: var(--gold2);
}

.hero-product {
  position: absolute;

  left: 0;
  bottom: 60px;

  width: 230px;
  height: 155px;

  background: #080808;

  border: 1px solid var(--gold);

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 12px;

  box-shadow:
    0 18px 45px #000;
}

.mini-logo {
  font-size: 37px;

  color: var(--gold2);

  font-weight: 900;
}

.hero-product span {
  font-size: 12px;

  letter-spacing: 2px;
}

.hero-product small {
  font-size: 7px;

  letter-spacing: 3px;

  color: var(--gold2);
}

.hero-tag {
  position: absolute;

  right: 15px;
  bottom: 22px;

  color: var(--gold2);

  font-style: italic;

  font-size: 18px;
}


/* ================= SECTION HEADING ================= */

.section-top {
  display: flex;

  align-items: end;

  justify-content: space-between;

  gap: 30px;

  margin-bottom: 40px;
}


/* ================= SERVICES ================= */

.services {
  background: #080808;

  border-top: 1px solid var(--line);

  border-bottom: 1px solid var(--line);
}

.service-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}

.service-card {
  min-height: 230px;

  background:
    linear-gradient(
      145deg,
      #0e0e0e,
      #080808
    );

  border: 1px solid var(--line);

  padding: 28px;

  position: relative;

  transition: 0.3s;
}

.service-card:hover {
  transform: translateY(-6px);

  border-color:
    rgba(216, 173, 77, 0.55);

  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.3);
}

.service-icon {
  width: 42px;
  height: 42px;

  border: 1px solid var(--gold);

  color: var(--gold2);

  display: grid;
  place-items: center;

  font-size: 20px;

  margin-bottom: 20px;
}

.number {
  position: absolute;

  right: 20px;
  top: 20px;

  color: #555;

  font-size: 10px;

  letter-spacing: 2px;
}

.service-card h3 {
  font-size: 19px;

  margin-bottom: 12px;

  max-width: 260px;
}

.service-card p {
  font-size: 13px;

  color: var(--muted);

  max-width: 300px;
}


/* ================= ABOUT ================= */

.about {
  background: #050505;
}

.about-grid {
  display: grid;

  grid-template-columns:
    1.05fr 1fr 0.38fr;

  gap: 35px;

  align-items: center;
}

.about-copy p:not(.kicker) {
  color: var(--muted);

  font-size: 14px;

  margin: 18px 0;

  max-width: 560px;
}

.about-photo {
  height: 440px;

  overflow: hidden;
}

.about-photo img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: 0.7s;
}

.about-photo:hover img {
  transform: scale(1.04);
}

.stats {
  display: grid;

  gap: 18px;
}

.stats div {
  border-left: 1px solid var(--gold);

  padding-left: 16px;
}

.stats strong {
  display: block;

  font-size: 18px;
}

.stats span {
  color: var(--muted);

  font-size: 11px;
}


/* ================= WHY ================= */

.why {
  padding: 100px 0;

  background: #090909;

  border-top: 1px solid var(--line);

  border-bottom: 1px solid var(--line);
}

.why-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 70px;

  align-items: center;
}

.why-image {
  height: 510px;

  overflow: hidden;
}

.why-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: 0.7s;
}

.why-image:hover img {
  transform: scale(1.04);
}

.why-copy > h2 {
  margin-bottom: 35px;
}

.why-items {
  display: grid;

  gap: 20px;
}

.why-item {
  display: grid;

  grid-template-columns: 45px 1fr;

  gap: 16px;

  padding-bottom: 20px;

  border-bottom: 1px solid var(--line);
}

.why-item > b {
  color: var(--gold2);

  font-size: 12px;

  border: 1px solid var(--gold);

  width: 36px;
  height: 36px;

  display: grid;

  place-items: center;
}

.why-item h3 {
  font-size: 17px;

  margin-bottom: 5px;
}

.why-item p {
  font-size: 13px;

  color: var(--muted);
}


/* ================= WORK ================= */

.work {
  background: #050505;
}

.work-grid {
  display: grid;

  grid-template-columns:
    0.9fr 1.1fr;

  gap: 65px;

  align-items: center;
}

.work-copy > p:not(.kicker) {
  color: var(--muted);

  max-width: 520px;

  font-size: 15px;

  margin: 18px 0;
}

.work-visual {
  height: 390px;

  position: relative;

  overflow: hidden;

  border: 1px solid var(--line);
}

.work-visual img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  filter: brightness(0.55);
}

.work-overlay {
  position: absolute;

  inset: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;
}

.work-overlay span {
  font-size: 13px;

  letter-spacing: 4px;

  color: #d8d8d8;
}

.work-overlay strong {
  font-size: 29px;

  color: var(--gold2);

  letter-spacing: 3px;

  margin-top: 5px;
}


/* ================= TESTIMONIALS ================= */

.testimonials {
  background: #090909;

  border-top: 1px solid var(--line);
}

.review-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 16px;
}

.review-card {
  background: #0d0d0d;

  border: 1px solid var(--line);

  padding: 28px;

  min-height: 210px;

  display: flex;

  flex-direction: column;
}

.review-card .stars {
  color: var(--gold2);

  letter-spacing: 3px;

  margin-bottom: 20px;
}

.review-card p {
  color: #c9c9c9;

  font-size: 13px;

  flex: 1;
}

.review-author {
  border-top: 1px solid var(--line);

  padding-top: 15px;

  margin-top: 20px;
}

.review-author strong {
  display: block;

  font-size: 13px;
}

.review-author span {
  font-size: 10px;

  color: var(--muted);
}


/* ================= CONTACT ================= */

.contact {
  position: relative;

  padding: 90px 0;

  border-top: 1px solid var(--line);

  overflow: hidden;
}

.contact-bg {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.98),
      rgba(0, 0, 0, 0.78)
    ),
    url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=85")
    center / cover;
}

.contact-grid {
  position: relative;

  z-index: 1;

  display: grid;

  grid-template-columns:
    1.2fr 0.7fr;

  gap: 60px;

  align-items: center;
}

.contact-copy > p:not(.kicker) {
  color: var(--muted);

  max-width: 580px;

  margin: 18px 0 28px;
}

.contact-card {
  padding: 30px;

  border: 1px solid
    rgba(216, 173, 77, 0.35);

  background:
    rgba(5, 5, 5, 0.72);
}

.contact-card > p {
  color: var(--gold2);

  font-size: 11px;

  letter-spacing: 3px;
}

.contact-card strong {
  font-size: 18px;
}

.contact-lines {
  display: grid;

  gap: 13px;

  margin-top: 30px;
}

.contact-lines a {
  font-size: 13px;

  color: #ccc;
}

.contact-lines a:hover {
  color: var(--gold2);
}


/* ================= FOOTER ================= */

.footer {
  background: #030303;

  padding: 65px 0 0;

  border-top: 1px solid var(--line);
}

.footer-grid {
  display: grid;

  grid-template-columns:
    1.25fr 1fr 1.35fr 1fr;

  gap: 45px;

  padding-bottom: 55px;
}

.footer-grid > div:not(.footer-brand) {
  display: flex;

  flex-direction: column;

  gap: 9px;
}

.footer-grid h4 {
  color: var(--gold2);

  font-size: 11px;

  letter-spacing: 2px;

  text-transform: uppercase;

  margin-bottom: 8px;
}

.footer-grid a:not(.brand) {
  color: #898989;

  font-size: 12px;
}

.footer-grid a:not(.brand):hover {
  color: var(--gold2);
}

.footer-brand p {
  color: #777;

  font-size: 12px;

  max-width: 280px;

  margin-top: 18px;
}

.footer-bottom {
  border-top: 1px solid var(--line);

  padding: 20px 0;

  display: flex;

  justify-content: space-between;

  gap: 20px;

  color: #686868;

  font-size: 10px;
}

.footer-bottom strong {
  color: var(--gold2);
}


/* ================= FLOATING ================= */

.whatsapp {
  position: fixed;

  z-index: 900;

  right: 24px;
  bottom: 24px;

  width: 54px;
  height: 54px;

  border-radius: 50%;

  display: grid;

  place-items: center;

  background: #25d366;

  color: #fff;

  font-weight: 800;

  font-size: 10px;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.4);

  transition: 0.25s;
}

.whatsapp:hover {
  transform: scale(1.08);
}

.back-top {
  position: fixed;

  z-index: 900;

  right: 24px;
  bottom: 90px;

  width: 42px;
  height: 42px;

  background: #090909;

  border: 1px solid var(--gold);

  color: var(--gold2);

  opacity: 0;

  visibility: hidden;

  transition: 0.25s;
}

.back-top.show {
  opacity: 1;

  visibility: visible;
}


/* ================= REVIEW MODAL ================= */

.modal {
  position: fixed;

  z-index: 2000;

  inset: 0;

  background:
    rgba(0, 0, 0, 0.85);

  backdrop-filter: blur(8px);

  display: none;

  align-items: center;

  justify-content: center;

  padding: 18px;
}

.modal.open {
  display: flex;
}

.modal-box {
  width: min(500px, 100%);

  max-height: 90vh;

  overflow: auto;

  background: #0e0e0e;

  border:
    1px solid
    rgba(216, 173, 77, 0.45);

  padding: 32px;

  position: relative;
}

.modal-close {
  position: absolute;

  right: 12px;
  top: 8px;

  border: 0;

  background: none;

  color: #fff;

  font-size: 30px;
}

.modal-box h2 {
  font-size: 34px;

  margin-bottom: 24px;
}

.modal-box label {
  display: block;

  font-size: 12px;

  color: #ccc;

  margin-bottom: 16px;
}

.modal-box input,
.modal-box textarea {
  display: block;

  width: 100%;

  margin-top: 7px;

  background: #050505;

  color: #fff;

  border: 1px solid var(--line);

  padding: 12px;

  outline: none;
}

.modal-box input:focus,
.modal-box textarea:focus {
  border-color: var(--gold);
}

.stars-input {
  display: flex;

  gap: 5px;

  margin: 0 0 18px;
}

.stars-input button {
  background: none;

  border: 0;

  color: #4b4b4b;

  font-size: 28px;
}

.stars-input button.selected {
  color: var(--gold2);
}

.full {
  width: 100%;
}


/* ================= REVEAL ================= */

.reveal {
  opacity: 0;

  transform: translateY(25px);

  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.reveal.visible {
  opacity: 1;

  transform: none;
}


/* ================= TABLET ================= */

@media (max-width: 1050px) {

  .nav {
    gap: 15px;
  }

  .nav > a {
    font-size: 11px;
  }

  .container {
    width: min(
      var(--max),
      calc(100% - 36px)
    );
  }

  .hero-grid {
    grid-template-columns: 1fr 1fr;

    gap: 30px;
  }

  .about-grid {
    grid-template-columns: 1fr 1fr;
  }

  .stats {
    grid-column: 1 / -1;

    grid-template-columns:
      repeat(4, 1fr);
  }

}


/* ================= MOBILE ================= */

@media (max-width: 800px) {

  .site-header {
    height: 72px;
  }

  .menu-toggle {
    display: block;
  }

  .nav {
    position: absolute;

    top: 72px;

    left: 16px;
    right: 16px;

    display: flex;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding: 8px;

    background: #090909;

    border: 1px solid var(--line);

    opacity: 0;

    visibility: hidden;

    transform: translateY(-8px);

    transition: 0.25s;
  }

  .nav.open {
    opacity: 1;

    visibility: visible;

    transform: none;
  }

  .nav > a {
    padding: 13px;

    border-bottom:
      1px solid var(--line);

    font-size: 13px;
  }

  .nav-cta {
    text-align: center;

    margin-top: 7px;
  }


  /* HERO */

  .hero {
    padding-top: 105px;
  }

  .hero-grid {
    grid-template-columns: 1fr;

    gap: 30px;
  }

  .hero-copy {
    padding-top: 20px;
  }

  .hero-art {
    height: 470px;
  }

  .hero-photo {
    left: 0;
  }

  .hero-product {
    width: 190px;
    height: 125px;
  }

  .hero-note {
    right: 15px;
    top: 25px;
  }


  /* SERVICES */

  .service-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }


  /* ABOUT */

  .about-grid,
  .why-grid,
  .work-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .about-photo {
    height: 380px;
  }

  .stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .why-image {
    height: 390px;
  }


  /* WORK */

  .work-visual {
    height: 330px;
  }


  /* REVIEWS */

  .review-grid {
    grid-template-columns: 1fr;
  }


  /* CONTACT */

  .contact-grid {
    gap: 35px;
  }


  /* FOOTER */

  .footer-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .footer-bottom {
    flex-direction: column;

    text-align: center;
  }

}


/* ================= SMALL MOBILE ================= */

@media (max-width: 520px) {

  .container {
    width: calc(100% - 28px);
  }

  .section {
    padding: 78px 0;
  }

  h1 {
    font-size:
      clamp(
        43px,
        14vw,
        62px
      );

    letter-spacing: -2px;
  }

  .lead {
    font-size: 15px;
  }

  .section-top {
    align-items: flex-start;

    flex-direction: column;

    gap: 14px;
  }

  .service-grid {
    grid-template-columns: 1fr;
  }

  .service-card {
    min-height: auto;
  }

  .hero-art {
    height: 390px;
  }

  .hero-note {
    font-size: 11px;
  }

  .hero-product {
    width: 155px;
    height: 105px;

    bottom: 30px;
  }

  .mini-logo {
    font-size: 28px;
  }

  .hero-product span {
    font-size: 9px;
  }

  .hero-tag {
    font-size: 13px;
  }

  .actions {
    flex-direction: column;
  }

  .actions .btn {
    width: 100%;
  }

  .about-photo {
    height: 320px;
  }

  .stats {
    grid-template-columns:
      1fr 1fr;
  }

  .why-image {
    height: 300px;
  }

  .work-visual {
    height: 270px;
  }

  .contact {
    padding: 75px 0;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .whatsapp {
    right: 14px;
    bottom: 14px;
  }

  .back-top {
    right: 14px;
    bottom: 78px;
  }

  .modal-box {
    padding: 28px 20px;
  }

}


/* ================= REDUCED MOTION ================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;

    transform: none;

    transition: none;
  }

  * {
    transition-duration: 0.01ms !important;
  }

}
