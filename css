* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --black: #050505;
  --black-soft: #0b0b0b;
  --black-card: #101010;

  --white: #f5f3ed;
  --gray: #96938b;
  --gray-dark: #5f5d57;

  --gold: #d6a52e;
  --gold-light: #f1c75a;

  --border: #252525;
  --gold-border: #70551d;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  background: var(--black);
  color: var(--white);

  font-family: "Inter", Arial, sans-serif;

  overflow-x: hidden;

  line-height: 1.6;
}

body,
html {
  max-width: 100%;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font-family: inherit;
}


/* ==================================================
   HEADER
================================================== */

.header {
  position: fixed;

  top: 0;
  left: 0;

  width: 100%;

  height: 72px;

  z-index: 1000;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 40px;

  background: rgba(5, 5, 5, 0.94);

  border-bottom: 1px solid #191919;

  backdrop-filter: blur(16px);

  transition: 0.3s;
}

.header.scrolled {
  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.6);
}

.logo {
  width: 155px;
  height: auto;
}

.navigation {
  display: flex;

  align-items: center;

  gap: 27px;

  font-size: 10px;

  font-weight: 700;

  text-transform: uppercase;
}

.navigation > a {
  color: #c9c6be;

  transition: 0.2s;
}

.navigation > a:hover {
  color: var(--gold);
}

.connect-btn {
  border: 1px solid var(--gold-border);

  padding: 10px 15px;

  color: var(--gold) !important;

  transition: 0.25s;
}

.connect-btn:hover {
  background: var(--gold);

  color: #111 !important;
}

.connect-btn span {
  margin-left: 6px;
}


/* MOBILE BUTTON */

.menu-btn {
  display: none;

  width: 40px;

  background: none;

  border: 0;

  cursor: pointer;
}

.menu-btn span {
  display: block;

  height: 2px;

  margin: 6px 0;

  background: var(--gold);
}


/* ==================================================
   GLOBAL
================================================== */

.section {
  width: min(1180px, calc(100% - 60px));

  margin-left: auto;
  margin-right: auto;
}

.eyebrow {
  color: var(--gold);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 0.16em;

  text-transform: uppercase;
}

h1,
h2,
h3 {
  line-height: 1.08;
}

h2 {
  font-size: clamp(38px, 4.4vw, 60px);

  letter-spacing: -0.045em;
}

h2 span {
  color: var(--gold);

  font-family: "Playfair Display", serif;
}


/* ==================================================
   BUTTONS
================================================== */

.button {
  min-height: 45px;

  padding: 0 20px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  border: 1px solid var(--gold-border);

  font-size: 10px;

  font-weight: 800;

  text-transform: uppercase;

  transition: 0.25s;
}

.button-gold {
  background: var(--gold);

  color: #111;

  border-color: var(--gold);
}

.button-gold:hover {
  background: var(--gold-light);

  transform: translateY(-2px);
}

.button-outline {
  background: transparent;

  color: white;
}

.button-outline:hover {
  color: var(--gold);

  border-color: var(--gold);

  background: #17130a;

  transform: translateY(-2px);
}


/* ==================================================
   HERO
================================================== */

.hero {
  min-height: 720px;

  margin-top: 72px;

  width: min(1280px, calc(100% - 60px));

  margin-left: auto;
  margin-right: auto;

  display: grid;

  grid-template-columns: 0.9fr 1.1fr;

  align-items: center;

  gap: 60px;

  padding: 75px 0 70px;
}

.hero-content {
  position: relative;

  z-index: 2;
}

.hero h1 {
  font-size: clamp(48px, 5.4vw, 76px);

  letter-spacing: -0.06em;

  margin: 14px 0 24px;

  max-width: 670px;
}

.hero h1 span {
  display: block;

  color: var(--gold);

  font-family: "Playfair Display", serif;
}

.hero-description {
  max-width: 540px;

  color: var(--gray);

  font-size: 14px;

  line-height: 1.85;
}

.hero-buttons {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;

  margin-top: 28px;
}

.hero-status {
  display: flex;

  align-items: center;

  gap: 9px;

  margin-top: 24px;

  color: #696760;

  font-size: 9px;
}

.hero-status span {
  width: 7px;

  height: 7px;

  border-radius: 50%;

  background: var(--gold);

  box-shadow:
    0 0 15px var(--gold);
}


/* ==================================================
   HERO VISUAL
================================================== */

.hero-visual {
  position: relative;

  height: 500px;

  min-width: 0;
}

.gold-glow {
  position: absolute;

  width: 360px;

  height: 360px;

  left: 35%;

  top: 20%;

  border-radius: 50%;

  background: rgba(194, 139, 25, 0.12);

  filter: blur(70px);
}

.visual-window {
  position: absolute;

  inset: 20px 0;

  overflow: hidden;

  border: 1px solid #342b1b;

  background: #0b0b0b;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.75);
}

.visual-photo {
  position: absolute;

  background-size: cover;

  background-position: center;

  filter: saturate(0.72);
}

.photo-one {
  left: 27%;

  top: 0;

  width: 73%;

  height: 100%;

  background-image:
    linear-gradient(
      90deg,
      rgba(0,0,0,.75),
      rgba(0,0,0,.12)
    ),
    url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=85");
}

.photo-two {
  left: 0;

  top: 9%;

  width: 42%;

  height: 42%;

  background-image:
    linear-gradient(
      rgba(0,0,0,.3),
      rgba(0,0,0,.35)
    ),
    url("https://images.unsplash.com/photo-1497215842964-222b430dc094?auto=format&fit=crop&w=800&q=85");
}

.photo-three {
  left: 0;

  bottom: 0;

  width: 42%;

  height: 42%;

  background-image:
    linear-gradient(
      rgba(0,0,0,.35),
      rgba(0,0,0,.35)
    ),
    url("https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=800&q=85");
}

.visual-card {
  position: absolute;

  padding: 9px 12px;

  border: 1px solid #75591c;

  background: rgba(5,5,5,.88);

  color: var(--gold);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .13em;
}

.card-camera {
  top: 7%;

  right: 5%;
}

.card-strategy {
  bottom: 7%;

  right: 5%;
}

.visual-brand {
  position: absolute;

  left: 7%;

  bottom: 12%;

  width: 53%;

  padding: 20px;

  text-align: center;

  background: rgba(4,4,4,.91);

  border: 1px solid #59441c;
}

.visual-brand img {
  width: min(260px, 90%);

  margin: auto;
}

.visual-brand small {
  display: block;

  margin-top: 8px;

  color: #aaa;

  font-size: 7px;

  letter-spacing: .2em;
}


/* ==================================================
   SERVICES
================================================== */

.services {
  padding-top: 100px;

  padding-bottom: 100px;

  border-top: 1px solid var(--border);
}

.section-heading {
  display: flex;

  align-items: end;

  justify-content: space-between;

  gap: 40px;

  margin-bottom: 38px;
}

.section-heading h2 {
  margin-top: 10px;
}

.section-heading > p {
  max-width: 420px;

  color: var(--gray);

  font-size: 12px;

  line-height: 1.8;
}

.services-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 13px;
}

.service-card {
  position: relative;

  min-height: 235px;

  padding: 27px;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #121212,
      #0b0b0b
    );

  border: 1px solid #222;

  transition:
    transform .3s,
    border-color .3s,
    background .3s;
}

.service-card::after {
  content: "";

  position: absolute;

  width: 130px;

  height: 130px;

  right: -70px;

  bottom: -70px;

  border-radius: 50%;

  background: rgba(214,165,46,.08);
}

.service-card:hover {
  transform: translateY(-6px);

  border-color: #76591c;

  background:
    linear-gradient(
      145deg,
      #17140e,
      #0b0b0b
    );
}

.service-top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 22px;
}

.service-top span {
  color: #555;

  font-size: 9px;
}

.service-top b {
  color: var(--gold);

  font-size: 34px;

  font-weight: 400;
}

.service-card h3 {
  font-size: 17px;

  max-width: 260px;
}

.service-card p {
  color: var(--gray);

  font-size: 11px;

  line-height: 1.7;

  margin-top: 10px;

  max-width: 290px;
}

.service-card a {
  display: inline-block;

  margin-top: 20px;

  color: var(--gold);

  font-size: 9px;

  font-weight: 800;

  text-transform: uppercase;
}


/* ==================================================
   ABOUT
================================================== */

.about {
  padding-top: 100px;

  padding-bottom: 100px;

  border-top: 1px solid var(--border);

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 75px;

  align-items: center;
}

.about-image {
  height: 450px;

  position: relative;
}

.about-photo {
  width: 84%;

  height: 100%;

  margin-left: auto;

  background:
    linear-gradient(
      rgba(0,0,0,.15),
      rgba(0,0,0,.45)
    ),
    url("https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1100&q=85")
    center / cover;

  border: 1px solid #292929;
}

.image-label {
  position: absolute;

  left: 0;

  bottom: 30px;

  padding: 16px 19px;

  background: rgba(5,5,5,.94);

  border: 1px solid #71551c;

  color: var(--gold);

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .1em;
}

.image-label small {
  display: block;

  color: #85837d;

  font-size: 7px;

  margin-top: 6px;
}

.about-content h2 {
  margin-top: 10px;

  max-width: 600px;
}

.about-content p {
  max-width: 570px;

  color: var(--gray);

  font-size: 13px;

  line-height: 1.85;

  margin-top: 17px;
}

.text-button {
  display: inline-flex;

  gap: 10px;

  margin-top: 25px;

  color: var(--gold);

  font-size: 10px;

  font-weight: 800;

  text-transform: uppercase;
}


/* ==================================================
   WHY
================================================== */

.why {
  padding-top: 95px;

  padding-bottom: 95px;

  border-top: 1px solid var(--border);
}

.why-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 11px;
}

.why-box {
  min-height: 190px;

  padding: 25px;

  border: 1px solid #222;

  background: #0b0b0b;

  transition: .3s;
}

.why-box:hover {
  transform: translateY(-4px);

  border-color: #76591c;
}

.why-box > span {
  color: var(--gold);

  font-size: 9px;
}

.why-box h3 {
  margin-top: 25px;

  font-size: 16px;
}

.why-box p {
  margin-top: 10px;

  color: var(--gray);

  font-size: 11px;
}


/* ==================================================
   WORK
================================================== */

.work {
  padding-top: 100px;

  padding-bottom: 100px;

  border-top: 1px solid var(--border);
}

.portfolio-status {
  padding: 8px 12px;

  border: 1px solid #6f541c;

  color: var(--gold);

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .1em;
}

.portfolio-placeholder {
  min-height: 280px;

  display: flex;

  align-items: center;

  gap: 35px;

  padding: 45px;

  border: 1px dashed #4b3a1b;

  background:
    radial-gradient(
      circle at 80% 40%,
      rgba(214,165,46,.08),
      transparent 30%
    ),
    #0b0b0b;
}

.portfolio-symbol {
  width: 90px;

  height: 90px;

  flex: 0 0 auto;

  display: grid;

  place-items: center;

  border: 1px solid #806221;

  color: var(--gold);

  font-size: 24px;

  font-weight: 800;
}

.portfolio-text h3 {
  font-size: 25px;
}

.portfolio-text p {
  max-width: 650px;

  margin: 10px 0 20px;

  color: var(--gray);

  font-size: 12px;

  line-height: 1.8;
}


/* ==================================================
   TESTIMONIALS
================================================== */

.testimonials {
  padding-top: 100px;

  padding-bottom: 100px;

  border-top: 1px solid var(--border);
}

.review-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 13px;
}

.review-card {
  padding: 27px;

  border: 1px solid #222;

  background: #0d0d0d;
}

.stars {
  color: var(--gold);

  letter-spacing: 3px;

  font-size: 14px;
}

.review-card p {
  color: #aaa;

  font-size: 12px;

  line-height: 1.8;

  margin: 18px 0;
}

.review-card strong {
  color: white;

  font-size: 10px;
}


/* ==================================================
   BLOG
================================================== */

.blog {
  padding-top: 90px;

  padding-bottom: 90px;

  border-top: 1px solid var(--border);
}

.blog-box {
  min-height: 270px;

  padding: 45px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 30px;

  border: 1px solid #292929;

  background:
    radial-gradient(
      circle at 85% 50%,
      rgba(214,165,46,.1),
      transparent 30%
    ),
    #0b0b0b;
}

.blog-box h2 {
  margin-top: 10px;
}

.blog-box p {
  color: var(--gray);

  font-size: 12px;

  max-width: 600px;

  margin-top: 12px;
}

.coming-soon {
  width: 115px;

  height: 115px;

  flex: 0 0 auto;

  display: grid;

  place-items: center;

  text-align: center;

  border: 1px solid #806221;

  color: var(--gold);

  font-size: 17px;

  font-weight: 800;
}

.coming-soon small {
  font-size: 6px;

  letter-spacing: .12em;
}


/* ==================================================
   CONTACT
================================================== */

.contact {
  padding-top: 100px;

  padding-bottom: 100px;

  border-top: 1px solid var(--border);

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 70px;
}

.contact-content h2 {
  margin-top: 10px;

  max-width: 650px;
}

.contact-content > p {
  max-width: 560px;

  margin: 18px 0 25px;

  color: var(--gray);

  font-size: 13px;

  line-height: 1.8;
}

.contact-links {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 11px;

  align-content: center;
}

.contact-links a {
  min-height: 110px;

  padding: 20px;

  display: flex;

  align-items: center;

  gap: 15px;

  border: 1px solid #242424;

  background: #0b0b0b;

  transition: .25s;
}

.contact-links a:hover {
  border-color: #76591c;

  transform: translateY(-4px);
}

.contact-links a > span {
  color: var(--gold);

  font-size: 11px;

  font-weight: 800;
}

.contact-links strong {
  display: block;

  font-size: 12px;
}

.contact-links small {
  display: block;

  color: #777;

  font-size: 8px;

  margin-top: 4px;
}


/* ==================================================
   FOOTER
================================================== */

.footer {
  border-top: 1px solid var(--border);

  background: #040404;

  padding: 55px 30px 20px;
}

.footer-inner {
  width: min(1180px, 100%);

  margin: auto;

  display: grid;

  grid-template-columns:
    1.4fr 1fr 1.2fr 1fr;

  gap: 50px;
}

.footer-brand img {
  width: 175px;
}

.footer-brand p {
  color: #777;

  font-size: 10px;

  margin-top: 11px;
}

.footer-column h4 {
  color: var(--gold);

  font-size: 9px;

  letter-spacing: .1em;

  margin-bottom: 17px;
}

.footer-column > a {
  display: block;

  color: #777;

  font-size: 9px;

  margin: 9px 0;

  transition: .2s;
}

.footer-column > a:hover {
  color: var(--gold);
}

.social-row {
  display: flex;

  gap: 7px;

  margin-top: 20px;
}

.social-row a {
  width: 30px;

  height: 30px;

  display: grid;

  place-items: center;

  border: 1px solid #292929;

  color: #aaa;

  font-size: 8px;
}

.social-row a:hover {
  color: var(--gold);

  border-color: var(--gold);
}

.footer-bottom {
  width: min(1180px, 100%);

  margin: 35px auto 0;

  padding-top: 17px;

  border-top: 1px solid #171717;

  display: flex;

  justify-content: space-between;

  gap: 20px;

  color: #555;

  font-size: 8px;
}


/* ==================================================
   REVIEW MODAL
================================================== */

.review-modal {
  position: fixed;

  inset: 0;

  z-index: 3000;

  display: none;

  align-items: center;

  justify-content: center;

  padding: 20px;

  background: rgba(0,0,0,.85);

  backdrop-filter: blur(8px);
}

.review-modal.open {
  display: flex;
}

.review-modal-box {
  position: relative;

  width: min(480px, 100%);

  padding: 32px;

  background: #0d0d0d;

  border: 1px solid #76591c;
}

.review-modal-box h2 {
  font-size: 35px;

  margin: 8px 0 22px;
}

.close-modal {
  position: absolute;

  top: 7px;

  right: 13px;

  border: 0;

  background: none;

  color: #aaa;

  font-size: 28px;

  cursor: pointer;
}

.review-modal label {
  display: block;

  margin-bottom: 15px;

  color: #999;

  font-size: 10px;
}

.review-modal input,
.review-modal textarea {
  width: 100%;

  margin-top: 7px;

  padding: 12px;

  border: 1px solid #292929;

  outline: none;

  background: #080808;

  color: white;
}

.review-modal textarea {
  min-height: 110px;

  resize: vertical;
}

.rating {
  display: flex;

  gap: 3px;

  margin-top: 4px;
}

.rating button {
  border: 0;

  background: none;

  color: #3d3d3d;

  font-size: 27px;

  cursor: pointer;
}

.rating button.active {
  color: var(--gold);
}


/* ==================================================
   FLOATING BUTTONS
================================================== */

.floating-whatsapp {
  position: fixed;

  right: 20px;

  bottom: 20px;

  z-index: 900;

  width: 46px;

  height: 46px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background: var(--gold);

  color: #111;

  font-size: 8px;

  font-weight: 900;

  box-shadow:
    0 8px 30px rgba(0,0,0,.7);
}

.back-top {
  position: fixed;

  right: 20px;

  bottom: 78px;

  z-index: 900;

  width: 40px;

  height: 40px;

  display: grid;

  place-items: center;

  border: 1px solid #76591c;

  background: #101010;

  color: var(--gold);

  cursor: pointer;

  opacity: 0;

  pointer-events: none;

  transition: .25s;
}

.back-top.show {
  opacity: 1;

  pointer-events: auto;
}


/* ==================================================
   ANIMATIONS
================================================== */

.reveal {
  opacity: 0;

  transform: translateY(24px);

  transition:
    opacity .65s ease,
    transform .65s ease;
}

.reveal.visible {
  opacity: 1;

  transform: translateY(0);
}


/* ==================================================
   TABLET
================================================== */

@media (max-width: 1050px) {

  .navigation {
    gap: 16px;

    font-size: 9px;
  }

  .hero {
    gap: 30px;
  }

  .services-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .why-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .footer-inner {
    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* ==================================================
   MOBILE
================================================== */

@media (max-width: 760px) {

  .section {
    width:
      min(100% - 30px, 600px);
  }

  .header {
    height: 64px;

    padding: 0 15px;
  }

  .logo {
    width: 135px;
  }

  .menu-btn {
    display: block;
  }

  .navigation {
    position: absolute;

    top: 64px;

    left: 0;

    right: 0;

    display: none;

    flex-direction: column;

    align-items: stretch;

    gap: 0;

    padding: 8px 15px 17px;

    background: #080808;

    border-bottom: 1px solid #76591c;
  }

  .navigation.open {
    display: flex;
  }

  .navigation > a {
    padding: 12px 2px;

    font-size: 10px;
  }

  .connect-btn {
    text-align: center;

    margin-top: 5px;
  }


  /* HERO */

  .hero {
    width:
      min(100% - 30px, 600px);

    margin-top: 64px;

    min-height: auto;

    grid-template-columns: 1fr;

    gap: 35px;

    padding-top: 60px;

    padding-bottom: 60px;
  }

  .hero h1 {
    font-size: 48px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-visual {
    height: 320px;
  }

  .visual-window {
    inset: 5px 0;
  }

  .visual-brand {
    left: 7%;

    width: 62%;

    bottom: 9%;

    padding: 14px;
  }


  /* SECTIONS */

  .services,
  .why,
  .work,
  .testimonials,
  .blog,
  .contact,
  .about {
    padding-top: 65px;

    padding-bottom: 65px;
  }

  .section-heading {
    display: block;
  }

  .section-heading h2 {
    font-size: 38px;
  }

  .section-heading > p {
    margin-top: 15px;
  }


  /* SERVICES */

  .services-grid {
    grid-template-columns: 1fr;
  }


  /* ABOUT */

  .about {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .about-image {
    height: 310px;
  }

  .about-photo {
    width: 88%;
  }


  /* WHY */

  .why-grid {
    grid-template-columns: 1fr;
  }


  /* WORK */

  .portfolio-placeholder {
    display: block;

    padding: 30px;
  }

  .portfolio-symbol {
    margin-bottom: 20px;
  }


  /* REVIEWS */

  .review-grid {
    grid-template-columns: 1fr;
  }


  /* BLOG */

  .blog-box {
    display: block;

    padding: 30px;
  }

  .coming-soon {
    margin-top: 25px;
  }


  /* CONTACT */

  .contact {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .contact-content h2 {
    font-size: 40px;
  }

  .contact-links {
    grid-template-columns: 1fr;
  }


  /* FOOTER */

  .footer {
    padding:
      40px 15px 18px;
  }

  .footer-inner {
    grid-template-columns:
      1fr 1fr;

    gap: 30px;
  }

  .footer-bottom {
    display: block;
  }

  .footer-bottom span {
    display: block;

    margin: 6px 0;
  }

}


/* ==================================================
   SMALL MOBILE
================================================== */

@media (max-width: 480px) {

  .hero h1 {
    font-size: 40px;
  }

  .hero-buttons {
    display: grid;

    grid-template-columns: 1fr;
  }

  .hero-buttons .button {
    width: 100%;
  }

  .hero-visual {
    height: 275px;
  }

  .visual-brand {
    width: 70%;
  }

  .visual-brand small {
    font-size: 6px;
  }

  .footer-inner {
    grid-template-columns: 1fr;
  }

  .portfolio-placeholder {
    padding: 25px;
  }

}


/* ==================================================
   REDUCED MOTION
================================================== */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;

    transform: none;

    transition: none;
  }

  * {
    transition: none !important;
  }

}
